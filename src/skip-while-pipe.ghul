namespace Ghul.Pipes is
    use Collections

    /// `source`'s elements from the first one `predicate` rejects onward.
    class SKIP_WHILE_PIPE[T]: FilterPipeBase[T] is
        _predicate: (T) -> bool
        _skipping: bool

        init(source: Iterable[T], predicate: (T) -> bool) is
            super.init(source)
            _predicate = predicate
            _skipping = true
        si

        /// A new stage of this kind over `source`, not yet read.
        fresh_over(source: Iterable[T]) -> FilterPipeBase[T] => SKIP_WHILE_PIPE[T](source, _predicate)

        /// Rejects elements while `predicate` accepts them, and accepts
        /// every element from its first rejection onward.
        should_include() -> bool is
            if _skipping /\ _predicate(current) then
                return false
            fi

            _skipping = false

            return true
        si
    si
si
