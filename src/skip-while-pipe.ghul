namespace Ghul.Pipes is
    use Collections;

    class SKIP_WHILE_PIPE[T]: FilterPipeBase[T] is
        _predicate: (T) -> bool;
        _skipping: bool;

        init(iterator: Iterator[T], predicate: (T) -> bool) is
            super.init(iterator);
            _predicate = predicate;
            _skipping = true;
        si

        should_include() -> bool is
            if _skipping /\ _predicate(current) then
                return false;
            fi

            _skipping = false;

            return true;
        si

        reset() is
            super.reset();
            _skipping = true;
        si
    si
si
