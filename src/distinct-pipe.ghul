namespace Ghul.Pipes is
    use Collections

    /// `source`'s elements with every one after its first occurrence dropped.
    class DISTINCT_PIPE[T]: FilterPipeBase[T] is
        _seen: SET[T]

        init(source: Iterable[T]) is
            super.init(source)
            _seen = SET[T]()
        si

        /// A new stage of this kind over `source`, not yet read.
        fresh_over(source: Iterable[T]) -> FilterPipeBase[T] => DISTINCT_PIPE[T](source)

        /// Accepts an element the first time it's seen and rejects it afterwards.
        should_include() -> bool is
            if _seen.contains(current) then
                return false
            fi

            _seen.add(current)

            return true
        si
    si
si
