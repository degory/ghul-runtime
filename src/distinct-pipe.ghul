namespace Ghul.Pipes is
    use Collections

    class DISTINCT_PIPE[T]: FilterPipeBase[T] is
        _seen: SET[T]

        init(source: Iterable[T]) is
            super.init(source)
            _seen = SET[T]()
        si

        should_include() -> bool is
            if _seen.contains(current) then
                return false
            fi

            _seen.add(current)

            return true
        si

        reset() is
            super.reset()
            _seen.clear()
        si
    si
si
