namespace Ghul.Generators is
    // Discriminator on `_GEN_STEP[T]`. DONE sits first deliberately
    // — `_GEN_STEP[T]()` default-init produces kind=DONE (zero),
    // which is what a state lambda that fell off the end implicitly
    // would mean.
    enum _GEN_STEP_KIND is
        DONE,
        YIELD,
        TRANSITION,
    si

    // What a state handler returns.
    //
    //   DONE       — generator complete; `value` and `next_state`
    //                are unused.
    //   YIELD      — emit `value`; advance to `next_state` on the
    //                next move_next.
    //   TRANSITION — no emit; advance to `next_state` and call its
    //                handler immediately (the driver loops inside
    //                one move_next until it hits YIELD or DONE).
    //
    // `value` is always present (`default[T]` for DONE / TRANSITION)
    // so the struct layout stays uniform.
    //
    // Used by the compiler's generator desugar — see
    // `docs/claude/generators-yield.md` in the ghul repo. Not
    // typically constructed directly by user code.
    struct _GEN_STEP[T] is
        kind: _GEN_STEP_KIND;
        value: T;
        next_state: int;

        init() is si

        init(kind: _GEN_STEP_KIND, value: T, next_state: int) is
            self.kind = kind;
            self.value = value;
            self.next_state = next_state;
        si
    si

    // Driver for compiler-emitted generator functions. Holds the
    // state-handler list + a cursor; implements Iterable[T] and
    // Iterator[T] so callers can consume the generator via
    // `for x in g do … od` (which queries iterator) or directly
    // (the driver IS its own iterator). The state lambdas are
    // allocated once when the generator function is invoked; the
    // driver reuses them across iterations.
    class _GEN_DRIVER[T]: Collections.Iterable[T], Collections.Iterator[T] is
        _states: Collections.List[() -> _GEN_STEP[T]];
        _state_index: int;
        _current: T;
        _done: bool;

        init(states: Collections.List[() -> _GEN_STEP[T]]) is
            _states = states;
            _state_index = 0;
            _done = false;
        si

        iterator: Collections.Iterator[T] => self;
        current: T => _current;

        move_next() -> bool is
            if _done then return false; fi
            while true do
                let step = _states[_state_index]();
                if step.kind == _GEN_STEP_KIND.DONE then
                    _done = true;
                    return false;
                elif step.kind == _GEN_STEP_KIND.YIELD then
                    _current = step.value;
                    _state_index = step.next_state;
                    return true;
                else
                    _state_index = step.next_state;
                fi
            od
            return false;
        si

        reset() is
            _state_index = 0;
            _done = false;
        si

        dispose() is si
    si

    // Public entry: wraps a list of state handlers into an
    // Iterable[T]. The compiler's generator desugar emits a call
    // here at the end of every rewritten generator function body.
    _gen_pipe[T](states: Collections.List[() -> _GEN_STEP[T]])
        -> Collections.Iterable[T]
    =>
        _GEN_DRIVER[T](states);
si
