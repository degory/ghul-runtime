namespace Ghul is
    // Open because a type declares itself option-shaped by implementing
    // this, which downstream assemblies have to be able to do.
    trait Maybe[T] open is
        has_value: bool
        value: T
    si

    struct MAYBE[T]: Maybe[T] is
        _has_value: bool
        _value: T

        has_value: bool pure => _has_value

        value: T pure =>
            if _has_value then
                _value
            else
                throw System.InvalidOperationException("maybe has no value")
            fi

        =~(other: MAYBE[T]) -> bool pure is
            if _has_value != other._has_value then
                return false
            fi

            if !_has_value then
                return true
            fi

            _value =~ other._value
        si

        // Absent hashes as zero, as `Nullable[T]` does. The comparer rather
        // than `_value.get_hash_code()` because `T` is unconstrained and can
        // be an optional reference, so a present value can still be null.
        get_hash_code() -> int pure =>
            if _has_value then
                Collections.EqualityComparer[T].`default.get_hash_code(_value)
            else
                0
            fi

        deconstruct(has_value: bool ref, value: T ref) is
            has_value! = _has_value
            value! = _value
        si

        init() pure is
        si

        init(value: T) pure is
            _has_value = true
            _value = value
        si

        to_string() -> string =>
            if _has_value then
                "{_value}"
            else
                "none"
            fi
    si
si
