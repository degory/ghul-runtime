namespace Ghul is
    trait Maybe[T] is
        has_value: bool;
        value: T;
    si

    struct MAYBE[T]: Maybe[T] is
        _has_value: bool;
        _value: T;

        has_value: bool pure => _has_value;

        unwrap() -> T pure =>
            if _has_value then
                _value
            else
                throw System.InvalidOperationException("maybe has no value");
            fi;

        value: T pure => unwrap();

        deconstruct(has_value: bool ref, value: T ref) is
            has_value! = _has_value;
            value! = _value;
        si

        init() pure is
        si

        init(value: T) pure is
            _has_value = true;
            _value = value;
        si

        to_string() -> string =>
            if _has_value then
                "{_value}";
            else
                "none";
            fi;
    si
si
