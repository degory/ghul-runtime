namespace Ghul is
    trait Maybe[T] is
        has_value: bool;
        value: T;
    si

    struct MAYBE[T]: Maybe[T] is
        `0: bool;
        `1: T;

        has_value: bool pure => `0;
        value: T pure => `1;

        init() pure is
        si

        init(value: T) pure is
            `0 = true;
            `1 = value;
        si

        to_string() -> string =>
            if has_value then
                "{value}";
            else
                "none";
            fi;
    si
si