namespace Ghul.Pipes is
    use Collections

    // Rewinds by re-deriving a fresh iterator from the source iterable
    // rather than calling `reset()` on the spent one - see
    // `adaptor-pipe.ghul`.
    class PEEK_PIPE[T]: Pipe[T] is
        iterator: Iterator[T] => self

        current: T

        _source: Iterable[T]
        _iterator: Iterator[T]

        _action: (T) -> void

        init(source: Iterable[T], action: (T) -> void) is
            _source = source
            _iterator = source.iterator
            _action = action
        si

        move_next() -> bool is
            if _iterator.move_next() then
                current = _iterator.current
                _action(current)

                return true
            fi

            reset()

            return false
        si

        reset() is
            _iterator = rewind(_source, _iterator)
        si

        to_string() -> string => Ghul.Pipes.join(self)

        dispose() is
        si
    si
si
