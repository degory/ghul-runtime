namespace Ghul.Pipes is
    struct INDEXED_VALUE[T] is
        `0: int;
        `1: T;

        index: int pure => `0;
        value: T pure => `1;

        init(index: int, value: T) pure is
            `0 = index;
            `1 = value;
        si

        to_string() -> string => "({`0},{`1})";
    si
si