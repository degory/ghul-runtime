namespace Ghul.Pipes is
    use Collections

    /// `source`'s elements that aren't in `excluded`, with duplicates
    /// dropped after their first occurrence.
    class EXCEPT_PIPE[T]: FilterPipeBase[T] is
        _excluded: SET[T]
        _seen: SET[T]

        init(source: Iterable[T], excluded: Iterable[T]) is
            super.init(source)
            _excluded = SET[T](excluded)
            _seen = SET[T]()
        si

        /// A new stage of this kind over `source`, not yet read.
        fresh_over(source: Iterable[T]) -> FilterPipeBase[T] => EXCEPT_PIPE[T](source, _excluded)

        /// Rejects an element that's in `excluded` or already seen, and
        /// accepts it otherwise.
        should_include() -> bool is
            if _excluded.contains(current) \/ _seen.contains(current) then
                return false
            fi

            _seen.add(current)

            return true
        si
    si
si
