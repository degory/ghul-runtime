namespace Ghul is
    use System.Text.StringBuilder;

    // `$` renders a value for display. It is meant for showing a value to
    // a person - a short example, a trace, a value echoed back - rather
    // than for any format that is going to be parsed back.
    //
    // A sequence renders as its elements in square brackets, recursively,
    // so a collection shows what it holds instead of the type name
    // `to_string()` gives it. Anything else renders as its own
    // `to_string()`, so a type that has said how it wants to look keeps
    // that.
    //
    // A type can be rendered by whichever overload fits it best. The
    // sequence overload catches anything whose static type says it is
    // one; the `object?` overload covers the rest, and falls back to
    // reflection so that a value held at `object` - an element of an
    // `object[]`, a nested collection - still renders as a sequence when
    // it is one.
    //
    // At most `_max_elements` elements of any one sequence are rendered,
    // and an ellipsis stands for the rest. Without a limit an unbounded
    // sequence - a generator, a stream - would never finish rendering,
    // and there is no length beyond which more elements help a person
    // read the value. The limit is deliberately not configurable: `$`
    // exists for showing a value, and anything wanting control over how
    // much is shown wants its own rendering rather than this one.

    _max_elements: int static => 100;

    $(value: object?) -> string is
        if !value? then
            return "null";
        fi

        // A string is a sequence of characters, and rendering it as one
        // would be useless.
        if isa string(value) then
            return value;
        fi

        let enumerator = _try_get_enumerator(value);

        if !enumerator? then
            return value.to_string() ?? "null";
        fi

        let into = StringBuilder();

        _append_reflected(enumerator, into);

        return into.to_string();
    si

    // Non-optional deliberately. A plain string prefers the sequence
    // overload below - a string is an Iterable[char] - over a parameter
    // spelled `string?`, so an optional one here never wins and the
    // string renders as its characters. Declared this way it wins for a
    // present string, and an absent one is answered by the object?
    // overload above.
    $(value: string) -> string => value;

    $[T](values: Collections.Iterable[T]) -> string is
        let into = StringBuilder();

        into.append('[');

        let count mut = 0;

        for value in values do
            if count >= _max_elements then
                into.append(", ...");

                break;
            fi

            if count > 0 then
                into.append(", ");
            fi

            into.append($(value));

            count = count + 1;
        od

        into.append(']');

        return into.to_string();
    si

    // Enumerate a value whose static type says nothing about whether it
    // is a sequence. Reflection is the only route: `Collections.Iterable[T]`
    // needs a `T` that is not known here, and a value-type instantiation
    // such as `LIST[int]` is not an `Iterable[object]`, so no cast covers
    // it. Returns null when the value is not enumerable.
    _try_get_enumerator(value: object) -> object? is
        let get_enumerator = value.get_type().get_method("GetEnumerator");

        if !get_enumerator? then
            return null;
        fi

        return get_enumerator.invoke(value, null);
    si

    _append_reflected(enumerator: object, into: StringBuilder) is
        let enumerator_type = enumerator.get_type();
        let move_next = enumerator_type.get_method("MoveNext");
        let current = enumerator_type.get_property("Current");

        into.append('[');

        if !move_next? \/ !current? then
            into.append(']');

            return;
        fi

        let count mut = 0;

        while cast bool(move_next.invoke(enumerator, null) ?? false) do
            if count >= _max_elements then
                into.append(", ...");

                break;
            fi

            if count > 0 then
                into.append(", ");
            fi

            into.append($(current.get_value(enumerator)));

            count = count + 1;
        od

        into.append(']');
    si
si
