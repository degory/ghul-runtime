namespace Ghul is
    use System.Text.StringBuilder

    // `$` renders a value for display. It is meant for showing a value to
    // a person - a short example, a trace, a value echoed back - rather
    // than for any format that is going to be parsed back.
    //
    // A type that implements `Displayable` renders however it says it
    // does. Otherwise a sequence renders as its elements in square
    // brackets, recursively, so a collection shows what it holds instead
    // of the type name `to_string()` gives it, and anything else renders
    // as its own `to_string()`.
    //
    // A type can be rendered by whichever overload fits it best. The
    // sequence overload catches anything whose static type says it is
    // one; the `object?` overload covers the rest, and falls back to
    // reflection so that a value held at `object` - an element of an
    // `object[]`, a nested collection - still renders as a sequence when
    // it is one.
    //
    // At most `_max_elements` elements of any one sequence are rendered,
    // and an ellipsis stands for the rest. Without a limit an unbounded
    // sequence - a generator, a stream - would never finish rendering,
    // and there is no length beyond which more elements help a person
    // read the value. The limit is deliberately not configurable: `$`
    // exists for showing a value, and anything wanting control over how
    // much is shown wants its own rendering rather than this one.
    //
    // A graph that leads back to something already being rendered would
    // otherwise recurse until the stack ran out, so each value on the way
    // down is remembered and one met again renders as `_cycle_marker`.

    // Implemented by a type that wants to say how it looks when it is
    // displayed, which is not always how its `to_string()` should read.
    //
    // Write the text through `state`, and render a child value with
    // `state.render(...)` rather than by calling `$` on it. The state
    // carries how much of a sequence is left to show and which values are
    // already being rendered further up; a fresh call to `$` starts with
    // neither, so a child rendered that way escapes both the element
    // limit and the cycle check.
    // Open because a type controls how it is rendered by implementing
    // this, which downstream assemblies have to be able to do.
    trait Displayable open is
        display(state: DISPLAY_STATE)
    si

    $(value: object?) -> string is
        let state = DISPLAY_STATE()

        state.render(value)

        return state.to_string()
    si

    // Non-optional deliberately. A plain string prefers the sequence
    // overload below - a string is an Iterable[char] - over a parameter
    // spelled `string?`, so an optional one here never wins and the
    // string renders as its characters. Declared this way it wins for a
    // present string, and an absent one is answered by the object?
    // overload above.
    $(value: string) -> string => value

    $[T](values: Collections.Iterable[T]) -> string is
        let state = DISPLAY_STATE()

        state.render_sequence(values)

        return state.to_string()
    si

    // What an implementation of `Displayable` is handed. The buffer, the
    // element budget and the set of values already being rendered are
    // private: the surface is `append` and `render`, so how the text is
    // accumulated stays free to change - to write straight to a stream,
    // or to carry an indent - without any implementation noticing.
    class DISPLAY_STATE is
        _max_elements: int static => 100

        _cycle_marker: string static => "<cycle>"

        _into: StringBuilder

        // Holds one entry per level of the value currently being
        // rendered rather than one per value seen, so it stays short.
        _open: Collections.LIST[object]

        init() is
            _into = StringBuilder()
            _open = Collections.LIST[object]()
        si

        append(text: string) is
            _into.append(text)
        si

        append(c: char) is
            _into.append(c)
        si

        to_string() -> string => _into.to_string()

        // Render a value into this state under the same element limit and
        // cycle tracking as everything else in the same render.
        render(value: object?) is
            if !value? then
                append("null")

                return
            fi

            // A string is a sequence of characters, and rendering it as
            // one would be useless.
            if isa string(value) then
                append(value)

                return
            fi

            if _is_open(value) then
                append(_cycle_marker)

                return
            fi

            if isa Displayable(value) then
                _mark(value)
                value.display(self)
                _release(value)

                return
            fi

            let enumerator = _try_get_enumerator(value)

            if !enumerator? then
                append(value.to_string() ?? "null")

                return
            fi

            _mark(value)

            let rendered = _append_reflected(enumerator)

            _release(value)

            if !rendered then
                append(value.to_string() ?? "null")
            fi
        si

        // Render a value already known to be a sequence, without the
        // reflection `render` would need to discover that for itself.
        render_sequence[T](values: Collections.Iterable[T]) is
            // A type that says how it looks says it here too: a static
            // type that happens to be a sequence does not make the
            // structural rendering the right one.
            if isa Displayable(values) then
                render(values)

                return
            fi

            if _is_open(values) then
                append(_cycle_marker)

                return
            fi

            _mark(values)

            append('[')

            let count mut = 0

            for value in values do
                if count >= _max_elements then
                    append(", ...")

                    break
                fi

                if count > 0 then
                    append(", ")
                fi

                render(value)

                count = count + 1
            od

            append(']')

            _release(values)
        si

        // Only a reference is worth remembering. A cycle cannot be made of
        // value types alone - each is stored by copy, so the graph would
        // have to be infinitely large - which means every cycle passes
        // through a reference and tracking those is enough. Tracking a
        // value type would not work anyway: one reaches here boxed, and
        // each boxing is a distinct object, so it would never be
        // recognised on the way round. A string is interned, so two equal
        // literals share a reference and would look like a repeat; it is
        // answered before this in any case.
        _is_trackable(value: object) -> bool =>
            !value.get_type().is_value_type /\ !isa string(value)

        // Remembered only while the value is on the path currently being
        // rendered, so the same collection appearing in two places renders
        // in full both times. Only a value that leads back to itself is a
        // cycle.
        _mark(value: object) is
            if _is_trackable(value) then
                _open.add(value)
            fi
        si

        _release(value: object) is
            if _is_trackable(value) /\ _open.count > 0 then
                _open.remove_at(_open.count - 1)
            fi
        si

        // Reference identity is the only sound test here: two structurally
        // equal collections are not a cycle, and consulting a user's `=~`
        // could recurse or cost more than the render.
        _is_open(value: object) -> bool is
            for entry in _open do
                if entry == value then
                    return true
                fi
            od

            return false
        si

        // Enumerate a value whose static type says nothing about whether
        // it is a sequence. Reflection is the only route:
        // `Collections.Iterable[T]` needs a `T` that is not known here,
        // and a value-type instantiation such as `LIST[int]` is not an
        // `Iterable[object]`, so no cast covers it. Returns null when the
        // value is not enumerable.
        _try_get_enumerator(value: object) -> object? is
            let get_enumerator = value.get_type().get_method("GetEnumerator")

            if !get_enumerator? then
                return null
            fi

            return get_enumerator.invoke(value, null)
        si

        // Returns false, having appended nothing, when the enumerator
        // cannot be driven - an explicit interface implementation leaves
        // no public `MoveNext` or `Current` to find. The caller then falls
        // back to the value's own `to_string()`, rather than showing it as
        // empty when all that is really known is that it could not be
        // read.
        _append_reflected(enumerator: object) -> bool is
            let enumerator_type = enumerator.get_type()
            let move_next = enumerator_type.get_method("MoveNext")
            let current = enumerator_type.get_property("Current")

            if !move_next? \/ !current? then
                return false
            fi

            append('[')

            let count mut = 0

            while cast bool(move_next.invoke(enumerator, null) ?? false) do
                if count >= _max_elements then
                    append(", ...")

                    break
                fi

                if count > 0 then
                    append(", ")
                fi

                render(current.get_value(enumerator))

                count = count + 1
            od

            append(']')

            return true
        si
    si
si
