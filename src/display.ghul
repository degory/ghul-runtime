namespace Ghul is
    use System.Text.StringBuilder;

    // `$` renders a value for display. It is meant for showing a value to
    // a person - a short example, a trace, a value echoed back - rather
    // than for any format that is going to be parsed back.
    //
    // A sequence renders as its elements in square brackets, recursively,
    // so a collection shows what it holds instead of the type name
    // `to_string()` gives it. Anything else renders as its own
    // `to_string()`, so a type that has said how it wants to look keeps
    // that.
    //
    // A type can be rendered by whichever overload fits it best. The
    // sequence overload catches anything whose static type says it is
    // one; the `object?` overload covers the rest, and falls back to
    // reflection so that a value held at `object` - an element of an
    // `object[]`, a nested collection - still renders as a sequence when
    // it is one.
    //
    // At most `_max_elements` elements of any one sequence are rendered,
    // and an ellipsis stands for the rest. Without a limit an unbounded
    // sequence - a generator, a stream - would never finish rendering,
    // and there is no length beyond which more elements help a person
    // read the value. The limit is deliberately not configurable: `$`
    // exists for showing a value, and anything wanting control over how
    // much is shown wants its own rendering rather than this one.
    //
    // A graph that leads back to something already being rendered would
    // otherwise recurse until the stack ran out, so each sequence on the
    // way down is remembered and one met again renders as `_cycle_marker`.

    _max_elements: int static => 100;

    _cycle_marker: string static => "<cycle>";

    $(value: object?) -> string => _render(value, Collections.LIST[object]());

    // Non-optional deliberately. A plain string prefers the sequence
    // overload below - a string is an Iterable[char] - over a parameter
    // spelled `string?`, so an optional one here never wins and the
    // string renders as its characters. Declared this way it wins for a
    // present string, and an absent one is answered by the object?
    // overload above.
    $(value: string) -> string => value;

    $[T](values: Collections.Iterable[T]) -> string is
        let into = StringBuilder();

        let open = Collections.LIST[object]();

        _mark(values, open);
        _append_sequence(values, into, open);

        return into.to_string();
    si

    _render(value: object?, open: Collections.LIST[object]) -> string is
        if !value? then
            return "null";
        fi

        // A string is a sequence of characters, and rendering it as one
        // would be useless.
        if isa string(value) then
            return value;
        fi

        if _is_open(value, open) then
            return _cycle_marker;
        fi

        let enumerator = _try_get_enumerator(value);

        if !enumerator? then
            return value.to_string() ?? "null";
        fi

        let into = StringBuilder();

        _mark(value, open);

        let rendered = _append_reflected(enumerator, into, open);

        _release(value, open);

        if !rendered then
            return value.to_string() ?? "null";
        fi

        return into.to_string();
    si

    // Only a reference is worth remembering. A cycle cannot be made of
    // value types alone - each is stored by copy, so the graph would have
    // to be infinitely large - which means every cycle passes through a
    // reference and tracking those is enough. Tracking a value type would
    // not work anyway: one reaches here boxed, and each boxing is a
    // distinct object, so it would never be recognised on the way round.
    // A string is interned, so two equal literals share a reference and
    // would look like a repeat; it is answered before this in any case.
    _is_trackable(value: object) -> bool =>
        !value.get_type().is_value_type /\ !isa string(value);

    // Remembered only while the value is on the path currently being
    // rendered, so the same collection appearing in two places renders in
    // full both times. Only a value that leads back to itself is a cycle.
    _mark(value: object, open: Collections.LIST[object]) is
        if _is_trackable(value) then
            open.add(value);
        fi
    si

    _release(value: object, open: Collections.LIST[object]) is
        if _is_trackable(value) /\ open.count > 0 then
            open.remove_at(open.count - 1);
        fi
    si

    // A linear scan, because `open` holds one entry per level of the
    // value currently being rendered rather than one per value seen, so
    // it stays short. Reference identity is the only sound test here:
    // two structurally equal collections are not a cycle, and consulting
    // a user's `=~` could recurse or cost more than the render.
    _is_open(value: object, open: Collections.LIST[object]) -> bool is
        for entry in open do
            if entry == value then
                return true;
            fi
        od

        return false;
    si

    // Enumerate a value whose static type says nothing about whether it
    // is a sequence. Reflection is the only route: `Collections.Iterable[T]`
    // needs a `T` that is not known here, and a value-type instantiation
    // such as `LIST[int]` is not an `Iterable[object]`, so no cast covers
    // it. Returns null when the value is not enumerable.
    _try_get_enumerator(value: object) -> object? is
        let get_enumerator = value.get_type().get_method("GetEnumerator");

        if !get_enumerator? then
            return null;
        fi

        return get_enumerator.invoke(value, null);
    si

    _append_sequence[T](values: Collections.Iterable[T], into: StringBuilder, open: Collections.LIST[object]) is
        into.append('[');

        let count mut = 0;

        for value in values do
            if count >= _max_elements then
                into.append(", ...");

                break;
            fi

            if count > 0 then
                into.append(", ");
            fi

            into.append(_render(value, open));

            count = count + 1;
        od

        into.append(']');
    si

    // Returns false, having appended nothing, when the enumerator cannot
    // be driven - an explicit interface implementation leaves no public
    // `MoveNext` or `Current` to find. The caller then falls back to the
    // value's own `to_string()`, rather than showing it as empty when all
    // that is really known is that it could not be read.
    _append_reflected(enumerator: object, into: StringBuilder, open: Collections.LIST[object]) -> bool is
        let enumerator_type = enumerator.get_type();
        let move_next = enumerator_type.get_method("MoveNext");
        let current = enumerator_type.get_property("Current");

        if !move_next? \/ !current? then
            return false;
        fi

        into.append('[');

        let count mut = 0;

        while cast bool(move_next.invoke(enumerator, null) ?? false) do
            if count >= _max_elements then
                into.append(", ...");

                break;
            fi

            if count > 0 then
                into.append(", ");
            fi

            into.append(_render(current.get_value(enumerator), open));

            count = count + 1;
        od

        into.append(']');

        return true;
    si
si
