namespace Ghul.Async is
    // Discriminator on `_LOOP_RESULT[T]` / `_LOOP_RESULT`. CONTINUE
    // sits first deliberately — `_LOOP_RESULT[T]()` default-init
    // produces type=CONTINUE (zero), which is what the compiler
    // emits as a loop body's fall-through return.
    enum _LOOP_RESULT_TYPE is
        CONTINUE,
        BREAK,
        RETURN,
    si

    // Sentinel propagated through async-loop helper chains. CONTINUE
    // means "carry on iterating"; BREAK means "stop the loop, fall
    // through to post-loop code"; RETURN means "stop the loop AND
    // propagate `value` back as the enclosing function's return".
    //
    // Used by the compiler's async-loop desugar — see
    // `docs/claude/async-loops.md` in the ghul repo. Not typically
    // constructed directly by user code.
    struct _LOOP_RESULT[T] is
        type: _LOOP_RESULT_TYPE;
        value: T;

        init() is si

        init(type: _LOOP_RESULT_TYPE, value: T) is
            self.type = type;
            self.value = value;
        si
    si

    // Non-generic counterpart for void-async loops (enclosing
    // function returns Tasks.TASK, not Tasks.TASK[T]). Carries the
    // same discriminator but no value field.
    struct _LOOP_RESULT is
        type: _LOOP_RESULT_TYPE;

        init() is si

        init(type: _LOOP_RESULT_TYPE) is
            self.type = type;
        si
    si

    // Driver for `_for_async`. Holds the iterator + body + a
    // TaskCompletionSource that the caller awaits; pumps iterations
    // synchronously when bodies complete inline, schedules a
    // continuation when they yield. The on-complete callback is
    // pre-allocated once at construction so per-yield closure
    // allocation is bounded to whatever .NET adds internally.
    class _FOR_DRIVER[T_elem, T_ret] is
        _iter: Collections.Iterator[T_elem];
        _body: T_elem -> Tasks.TASK[_LOOP_RESULT[T_ret]];
        _tcs: Tasks.TaskCompletionSource[_LOOP_RESULT[T_ret]];
        _on_complete_callback: (Tasks.TASK[_LOOP_RESULT[T_ret]]) -> void;

        init(
            iter: Collections.Iterator[T_elem],
            body: T_elem -> Tasks.TASK[_LOOP_RESULT[T_ret]]
        ) is
            _iter = iter;
            _body = body;
            _tcs = Tasks.TaskCompletionSource[_LOOP_RESULT[T_ret]]();
            _on_complete_callback = t => on_complete(t);
        si

        start() -> Tasks.TASK[_LOOP_RESULT[T_ret]] is
            pump();
            return _tcs.task;
        si

        pump() is
            try
                while _iter.move_next() do
                    let body_task = _body(_iter.current);
                    if !body_task.is_completed then
                        body_task.continue_with(_on_complete_callback);
                        return;
                    fi
                    if handle_result(body_task) then return; fi
                od
                _tcs.set_result(_LOOP_RESULT[T_ret]());
            catch ex: System.Exception
                _tcs.set_exception(ex);
            yrt
        si

        on_complete(t: Tasks.TASK[_LOOP_RESULT[T_ret]]) is
            if handle_result(t) then return; fi
            pump();
        si

        handle_result(t: Tasks.TASK[_LOOP_RESULT[T_ret]]) -> bool is
            if t.is_faulted then
                _tcs.set_exception(t.exception);
                return true;
            fi
            let r = t.result;
            if r.type == _LOOP_RESULT_TYPE.RETURN \/ r.type == _LOOP_RESULT_TYPE.BREAK then
                _tcs.set_result(r);
                return true;
            fi
            return false;
        si
    si

    // Driver for `_while_async`. Same shape as _FOR_DRIVER but
    // evaluates a synchronous condition lambda before each iteration.
    //
    // Condition is `() -> bool` (not `() -> Tasks.TASK[bool]`) because
    // ghūl's source-level `while` requires a bool condition expression.
    // A user wanting "async check before iteration" expresses it as a
    // let-await inside the body, updating a flag captured by the
    // condition lambda — not by writing an async condition function.
    class _WHILE_DRIVER[T_ret] is
        _condition: () -> bool;
        _body: () -> Tasks.TASK[_LOOP_RESULT[T_ret]];
        _tcs: Tasks.TaskCompletionSource[_LOOP_RESULT[T_ret]];
        _on_body_complete: (Tasks.TASK[_LOOP_RESULT[T_ret]]) -> void;

        init(
            condition: () -> bool,
            body: () -> Tasks.TASK[_LOOP_RESULT[T_ret]]
        ) is
            _condition = condition;
            _body = body;
            _tcs = Tasks.TaskCompletionSource[_LOOP_RESULT[T_ret]]();
            _on_body_complete = t => on_body_complete(t);
        si

        start() -> Tasks.TASK[_LOOP_RESULT[T_ret]] is
            pump();
            return _tcs.task;
        si

        pump() is
            try
                while _condition() do
                    let body_task = _body();
                    if !body_task.is_completed then
                        body_task.continue_with(_on_body_complete);
                        return;
                    fi
                    if handle_body(body_task) then return; fi
                od
                _tcs.set_result(_LOOP_RESULT[T_ret]());
            catch ex: System.Exception
                _tcs.set_exception(ex);
            yrt
        si

        on_body_complete(t: Tasks.TASK[_LOOP_RESULT[T_ret]]) is
            if handle_body(t) then return; fi
            pump();
        si

        handle_body(t: Tasks.TASK[_LOOP_RESULT[T_ret]]) -> bool is
            if t.is_faulted then
                _tcs.set_exception(t.exception);
                return true;
            fi
            let r = t.result;
            if r.type == _LOOP_RESULT_TYPE.RETURN \/ r.type == _LOOP_RESULT_TYPE.BREAK then
                _tcs.set_result(r);
                return true;
            fi
            return false;
        si
    si

    // Public entry: drives `iter` through `body` until exhausted,
    // a body returns _LOOP_RESULT.RETURN/BREAK, or a body's task
    // faults. Used as the desugar target for `for x in xs do <body
    // with let-await> od` inside async-classified functions.
    _for_async[T_elem, T_ret](
        iter: Collections.Iterator[T_elem],
        body: T_elem -> Tasks.TASK[_LOOP_RESULT[T_ret]]
    ) -> Tasks.TASK[_LOOP_RESULT[T_ret]] =>
        _FOR_DRIVER[T_elem, T_ret](iter, body).start();

    // Public entry: drives `body` while `condition` returns true.
    // Used as the desugar target for `while cond do <body with let-
    // await> od` inside async-classified functions.
    _while_async[T_ret](
        condition: () -> bool,
        body: () -> Tasks.TASK[_LOOP_RESULT[T_ret]]
    ) -> Tasks.TASK[_LOOP_RESULT[T_ret]] =>
        _WHILE_DRIVER[T_ret](condition, body).start();
si
