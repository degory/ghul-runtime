namespace Ghul.Pipes is
    use Collections;

    class INTERSECT_PIPE[T]: FilterPipeBase[T] is
        _included: SET[T];
        _seen: SET[T];

        init(iterator: Iterator[T], included: Iterable[T]) is
            super.init(iterator);
            _included = SET[T](included);
            _seen = SET[T]();
        si

        should_include() -> bool is
            if !_included.contains(current) \/ _seen.contains(current) then
                return false;
            fi

            _seen.add(current);

            return true;
        si

        reset() is
            super.reset();
            _seen.clear();
        si
    si
si
