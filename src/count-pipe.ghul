namespace Ghul.Pipes is
    use Collections

    // An unbounded arithmetic sequence: `start`, `start + step`, and so on.
    // Nothing bounds it, so a chain over one is bounded by a stage that
    // stops pulling.
    /// An unbounded arithmetic sequence of `int`s starting at `start` and
    /// advancing by `step` each time.
    class COUNT_PIPE: PipeStage[int] is
        _start: int
        _step: int
        _started: bool

        /// The current value in the sequence.
        current: int

        init(start: int, step: int) is
            super.init()

            _start = start
            _step = step
            _started = false
            current = start
        si

        /// A new sequence from `start`, not yet read.
        fresh() -> PipeStage[int] => COUNT_PIPE(_start, _step)

        /// Advances to the next value; never ends.
        move_next() -> bool is
            if _started then
                current = current + _step
            else
                _started = true
            fi

            return true
        si

        /// Renders the pipe's elements, in order, as text.
        to_string() -> string => $(self)

        /// Has no effect.
        dispose() is
        si
    si

    /// An unbounded arithmetic sequence of `long`s starting at `start` and
    /// advancing by `step` each time.
    class LONG_COUNT_PIPE: PipeStage[long] is
        _start: long
        _step: long
        _started: bool

        /// The current value in the sequence.
        current: long

        init(start: long, step: long) is
            super.init()

            _start = start
            _step = step
            _started = false
            current = start
        si

        /// A new sequence from `start`, not yet read.
        fresh() -> PipeStage[long] => LONG_COUNT_PIPE(_start, _step)

        /// Advances to the next value; never ends.
        move_next() -> bool is
            if _started then
                current = current + _step
            else
                _started = true
            fi

            return true
        si

        /// Renders the pipe's elements, in order, as text.
        to_string() -> string => $(self)

        /// Has no effect.
        dispose() is
        si
    si
si
