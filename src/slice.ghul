namespace Ghul is
    // Backs the `[System.Range]` indexer the compiler supplies for the
    // built-in indexable types. It cannot be a method on those types:
    // an array's members come from a trait it satisfies by runtime
    // magic rather than by an interface implementation, so a body
    // declared there is never reached. The compiler injects an innate
    // indexer instead and lowers it to a call here, where an ordinary
    // static method can hold the code.
    class SLICE[E] is
        of(source: E[], r: System.Range) -> Collections.List[E] static is
            let (offset, length) = r.get_offset_and_length(source.count);

            return System.ArraySegment[E](source, offset, length);
        si
    si
si
