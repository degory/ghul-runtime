namespace Ghul is
    use Collections

    // Function combinators: composition in both reading orders, arity
    // reshaping for the two-argument case, and a call cache. They live
    // here rather than in Ghul.Pipes because none of them is about
    // sequences, and in Ghul itself so no `use` is needed to reach them.

    // Left-to-right composition: `f >> g` applies f, then g - the
    // reading that matches the thread-first operator's direction.
    >>[A, B, C](f: A -> B, g: B -> C) -> A -> C => x => g(f(x))

    // Right-to-left composition, the mathematical reading: `f << g`
    // applies g, then f.
    <<[A, B, C](f: B -> C, g: A -> B) -> A -> C => x => f(g(x))

    // Reshape a two-argument function into unary functions returning
    // functions, so one argument can be supplied and the rest passed
    // later: `curry(add)(3)` is the function that adds 3.
    curry[A, B, C](f: (A, B) -> C) -> (A) -> (B) -> C =>
        a => b => f(a, b)

    // The inverse reshape: a function built by currying, or by any
    // step-by-step construction of the same shape, as a plain
    // two-argument function.
    uncurry[A, B, C](f: (A) -> (B) -> C) -> (A, B) -> C =>
        (a, b) => f(a)(b)

    // Call a function with the arguments of the call itself, of any
    // arity: `apply(f, x, y)` is `f(x, y)`. The argument pack gathers
    // the arguments, so both the spread spelling and the written-out
    // tuple reach the same formal.
    apply[T.., U](f: T.. -> U, v: T..) -> U => f(v)

    // A function that answers from a map of the results it has already
    // computed, so repeated calls with the same argument compute once.
    // The cache is an ordinary MAP: single-threaded use.
    memoize[A, B](f: (A) -> B) -> (A) -> B is
        let cache mut = MAP[A, B]()

        return x => (
            if cache.contains_key(x) then cache[x]
            else
                let v = f(x)
                cache.add(x, v)
                v
            fi
        )
    si
si
