namespace Ghul.Pipes is
    use System.InvalidOperationException;
    use System.NotImplementedException;

    use System.Text.StringBuilder;

    use Collections;

    // FIXME: should dispose of all enumerators - ideally somehow check if they really need disposing
    // and so only pay cost of try/finally handler if genuinely needed. For now, in practice, none
    // of the enumerators we want to use actually have any non-managed state that needs to be disposed

    // Lift an `Iterable[T]` (any producer with a `.iterator` —
    // includes any existing `Pipe[T]`, which is short-circuited via
    // an `isa` check) to `Pipe[T]`. For state-stepping producers,
    // use `stream(initial, advance)` (see `stream.ghul`).

    pipe[T](source: Iterable[T]) -> Pipe[T] pure is
        if !source? then
            return null;
        elif isa Pipe[T](source) then
            return cast Pipe[T](source);
        else
            return ADAPTOR_PIPE[T](source);
        fi
    si

    class Factory is
        from[T](source: Iterable[T]) -> Pipe[T] pure static is
            if !source? then
                return null;
            elif isa Pipe[T](source) then
                return cast Pipe[T](source);
            else
                return ADAPTOR_PIPE[T](source);
            fi
        si
    si

    // T can't carry a bound inside Pipe[T] itself, so min/max are free
    // functions rather than trait members - min_by/max_by don't have
    // that problem, since the key type is a fresh per-call parameter.
    min[T: System.IComparable[T]](values: Iterable[T]) -> MAYBE[T] pure is
        let it = values.iterator;

        if it.move_next() then
            let result mut = it.current;

            while it.move_next() do
                if it.current.compare_to(result) < 0 then
                    result = it.current;
                fi
            od

            return MAYBE(result);
        fi

        return MAYBE[T]();
    si

    max[T: System.IComparable[T]](values: Iterable[T]) -> MAYBE[T] pure is
        let it = values.iterator;

        if it.move_next() then
            let result mut = it.current;

            while it.move_next() do
                if it.current.compare_to(result) > 0 then
                    result = it.current;
                fi
            od

            return MAYBE(result);
        fi

        return MAYBE[T]();
    si

    // Pipe members are declared pure: they store nothing a caller
    // can see, so flow narrowing keeps its facts across a chain, and
    // their function-typed parameters only admit store-free values.
    // The declaration deliberately overlooks internal cursor state -
    // advancing a shared, single-shot pipe is observable by whoever
    // holds the same pipe, which is accepted the same way map and
    // set reads trust the key's equals-and-hash contract. for_each
    // and the StringBuilder append_to overloads stay undeclared:
    // actions exist to cause effects, and append_to writes to a
    // caller-supplied builder.
    // Every member below is a one-line forward to the free-function
    // equivalent in this namespace (see #134) - `.method()` call sites are
    // unaffected, and the free functions are the single source of truth.
    trait Pipe[T]: Iterable[T], Iterator[T] is
        iterator: Iterator[T] => self;

        filter(predicate: (T) -> bool pure) -> Pipe[T] pure =>
            Ghul.Pipes.filter(self, predicate);

        map[U](mapper: (T) -> U pure) -> Pipe[U] pure =>
            Ghul.Pipes.map(self, mapper);

        flat_map[U](mapper: (T) -> Iterable[U] pure) -> Pipe[U] pure =>
            Ghul.Pipes.flat_map(self, mapper);

        skip(count: int) -> Pipe[T] pure =>
            Ghul.Pipes.skip(self, count);

        take(count: int) -> Pipe[T] pure =>
            Ghul.Pipes.take(self, count);

        skip_while(predicate: (T) -> bool pure) -> Pipe[T] pure =>
            Ghul.Pipes.skip_while(self, predicate);

        take_while(predicate: (T) -> bool pure) -> Pipe[T] pure =>
            Ghul.Pipes.take_while(self, predicate);

        distinct() -> Pipe[T] pure =>
            Ghul.Pipes.distinct(self);

        peek(action: T -> void) -> Pipe[T] =>
            Ghul.Pipes.peek(self, action);

        chunk(size: int) -> Pipe[LIST[T]] pure =>
            Ghul.Pipes.chunk(self, size);

        windows(size: int) -> Pipe[LIST[T]] pure =>
            Ghul.Pipes.windows(self, size);

        cat(right: Iterable[T]) -> Pipe[T] pure =>
            Ghul.Pipes.cat(self, right);

        union_with(right: Iterable[T]) -> Pipe[T] pure =>
            Ghul.Pipes.union_with(self, right);

        intersect_with(right: Iterable[T]) -> Pipe[T] pure =>
            Ghul.Pipes.intersect_with(self, right);

        except(right: Iterable[T]) -> Pipe[T] pure =>
            Ghul.Pipes.except(self, right);

        index() -> Pipe[INDEXED_VALUE[T]] pure =>
            Ghul.Pipes.index(self);

        index(index: int) -> Pipe[INDEXED_VALUE[T]] pure =>
            Ghul.Pipes.index(self, index);

        // FIXME: can't use => here due to compiler bug
        zip[U](other: Iterable[U]) -> Pipe[(T,U)] pure =>
            Ghul.Pipes.zip(self, other);

        // FIXME: can't use => here due to compiler bug
        zip[U,TOut](other: Iterable[U], mapper: (T,U) -> TOut pure) -> Pipe[TOut] pure =>
            Ghul.Pipes.zip(self, other, mapper);

        reduce[TRunning](seed: TRunning, accumulator: (TRunning,T) -> TRunning pure) -> TRunning pure =>
            Ghul.Pipes.reduce(self, seed, accumulator);

        reduce[TRunning,TOut](seed: TRunning, accumulator: (TRunning,T) -> TRunning pure, mapper: (TRunning) -> TOut pure) -> TOut pure =>
            Ghul.Pipes.reduce(self, seed, accumulator, mapper);

        collect() -> List[T] pure =>
            Ghul.Pipes.collect(self);

        collect_array() -> T[] pure =>
            Ghul.Pipes.collect_array(self);

        collect_list() -> LIST[T] pure =>
            Ghul.Pipes.collect_list(self);

        collect_set() -> SET[T] pure =>
            Ghul.Pipes.collect_set(self);

        collect_map[K,V](key_selector: (T) -> K pure, value_selector: (T) -> V pure) -> MAP[K,V] pure =>
            Ghul.Pipes.collect_map(self, key_selector, value_selector);

        partition(predicate: (T) -> bool pure) -> (LIST[T], LIST[T]) pure =>
            Ghul.Pipes.partition(self, predicate);

        group_by[K](key_selector: (T) -> K pure) -> MAP[K, LIST[T]] pure =>
            Ghul.Pipes.group_by(self, key_selector);

        min_by[K: System.IComparable[K]](key_selector: (T) -> K pure) -> MAYBE[T] pure =>
            Ghul.Pipes.min_by(self, key_selector);

        max_by[K: System.IComparable[K]](key_selector: (T) -> K pure) -> MAYBE[T] pure =>
            Ghul.Pipes.max_by(self, key_selector);

        count() -> int pure =>
            Ghul.Pipes.count(self);

        find(predicate: (T) -> bool pure) -> MAYBE[T] pure =>
            Ghul.Pipes.find(self, predicate);

        find_map[U](mapper: (T) -> MAYBE[U] pure) -> MAYBE[U] pure =>
            Ghul.Pipes.find_map(self, mapper);

        find_or_throw(predicate: T -> bool pure) -> T pure =>
            Ghul.Pipes.find_or_throw(self, predicate);

        find_map_or_throw[U](mapper: (T) -> MAYBE[U] pure) -> U pure =>
            Ghul.Pipes.find_map_or_throw(self, mapper);

        first() -> MAYBE[T] pure =>
            Ghul.Pipes.first(self);

        first_map[U](mapper: (T) -> MAYBE[U] pure) -> MAYBE[U] pure =>
            Ghul.Pipes.first_map(self, mapper);

        first_or_throw() -> T pure =>
            Ghul.Pipes.first_or_throw(self);

        first_map_or_throw[U](mapper: (T) -> MAYBE[U] pure) -> U pure =>
            Ghul.Pipes.first_map_or_throw(self, mapper);

        only() -> T pure =>
            Ghul.Pipes.only(self);

        // deprecated
        has(predicate: (T) -> bool) -> bool is
            while move_next() do
                let element = current;

                if predicate(element) then
                    return true;
                fi
            od

            reset();

            return false;
        si

        any(predicate: (T) -> bool pure) -> bool pure =>
            Ghul.Pipes.any(self, predicate);

        all(predicate: (T) -> bool pure) -> bool pure =>
            Ghul.Pipes.all(self, predicate);

        for_each(action: T -> void) =>
            Ghul.Pipes.for_each(self, action);

        reverse() -> Pipe[T] pure =>
            Ghul.Pipes.reverse(self);

        sort() -> Pipe[T] pure =>
            Ghul.Pipes.sort(self);

        sort(comparer: IComparer[T]) -> Pipe[T] pure =>
            Ghul.Pipes.sort(self, comparer);

        sort(compare: (T, T) -> int pure) -> Pipe[T] pure =>
            Ghul.Pipes.sort(self, compare);

        sort_descending() -> Pipe[T] pure =>
            Ghul.Pipes.sort_descending(self);

        sort_by[K: System.IComparable[K]](key_selector: (T) -> K pure) -> Pipe[T] pure =>
            Ghul.Pipes.sort_by(self, key_selector);

        sort_by_descending[K: System.IComparable[K]](key_selector: (T) -> K pure) -> Pipe[T] pure =>
            Ghul.Pipes.sort_by_descending(self, key_selector);

        append_to(into: StringBuilder, separator: string) -> StringBuilder =>
            Ghul.Pipes.append_to(self, into, separator);

        append_to(into: StringBuilder) -> StringBuilder =>
            Ghul.Pipes.append_to(self, into);

        join(separator: string) -> string pure =>
            Ghul.Pipes.join(self, separator);

        join() -> string pure =>
            Ghul.Pipes.join(self);

        to_string() -> string =>
            self.join(", ");

        // deprecated
        to_string(separator: string) -> string =>
            self.join(separator);

        dispose() is
        si
    si
si