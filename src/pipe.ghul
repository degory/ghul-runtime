namespace Ghul.Pipes is
    use System.InvalidOperationException;
    use System.NotImplementedException;

    use System.Text.StringBuilder;

    use Collections;

    // FIXME: should dispose of all enumerators - ideally somehow check if they really need disposing
    // and so only pay cost of try/finally handler if genuinely needed. For now, in practice, none
    // of the enumerators we want to use actually have any non-managed state that needs to be disposed

    // Lift an `Iterable[T]` (any producer with a `.iterator` —
    // includes any existing `Pipe[T]`, which is short-circuited via
    // an `isa` check) to `Pipe[T]`. For state-stepping producers,
    // use `stream(initial, advance)` (see `stream.ghul`).

    pipe[T](source: Iterable[T]) -> Pipe[T] pure is
        if !source? then
            return null;
        elif isa Pipe[T](source) then
            return cast Pipe[T](source);
        else
            return ADAPTOR_PIPE[T](source);
        fi
    si

    class Factory is
        from[T](source: Iterable[T]) -> Pipe[T] pure static is
            if !source? then
                return null;
            elif isa Pipe[T](source) then
                return cast Pipe[T](source);
            else
                return ADAPTOR_PIPE[T](source);
            fi
        si
    si

    // T can't carry a bound inside Pipe[T] itself, so min/max are free
    // functions rather than trait members - min_by/max_by don't have
    // that problem, since the key type is a fresh per-call parameter.
    min[T: System.IComparable[T]](values: Pipe[T]) -> MAYBE[T] pure is
        if values.move_next() then
            let result mut = values.current;

            while values.move_next() do
                if values.current.compare_to(result) < 0 then
                    result = values.current;
                fi
            od

            return MAYBE(result);
        fi

        return MAYBE[T]();
    si

    max[T: System.IComparable[T]](values: Pipe[T]) -> MAYBE[T] pure is
        if values.move_next() then
            let result mut = values.current;

            while values.move_next() do
                if values.current.compare_to(result) > 0 then
                    result = values.current;
                fi
            od

            return MAYBE(result);
        fi

        return MAYBE[T]();
    si

    // Pipe members are declared pure: they store nothing a caller
    // can see, so flow narrowing keeps its facts across a chain, and
    // their function-typed parameters only admit store-free values.
    // The declaration deliberately overlooks internal cursor state -
    // advancing a shared, single-shot pipe is observable by whoever
    // holds the same pipe, which is accepted the same way map and
    // set reads trust the key's equals-and-hash contract. for_each
    // and the StringBuilder append_to overloads stay undeclared:
    // actions exist to cause effects, and append_to writes to a
    // caller-supplied builder.
    trait Pipe[T]: Iterable[T], Iterator[T] is
        iterator: Iterator[T] => self;

        filter(predicate: (T) -> bool pure) -> Pipe[T] pure =>
            FilterPipe[T](iterator, predicate);

        map[U](mapper: (T) -> U pure) -> Pipe[U] pure =>
            MAP_PIPE[T,U](iterator, mapper);

        flat_map[U](mapper: (T) -> Iterable[U] pure) -> Pipe[U] pure =>
            FLAT_MAP_PIPE[T,U](iterator, mapper);

        skip(count: int) -> Pipe[T] pure =>
            SKIP_PIPE[T](iterator, count);

        take(count: int) -> Pipe[T] pure =>
            TAKE_PIPE[T](iterator, count);

        skip_while(predicate: (T) -> bool pure) -> Pipe[T] pure =>
            SKIP_WHILE_PIPE[T](iterator, predicate);

        take_while(predicate: (T) -> bool pure) -> Pipe[T] pure =>
            TAKE_WHILE_PIPE[T](iterator, predicate);

        distinct() -> Pipe[T] pure =>
            DISTINCT_PIPE[T](iterator);

        peek(action: T -> void) -> Pipe[T] =>
            PEEK_PIPE[T](iterator, action);

        inspect(action: T -> void) -> Pipe[T] =>
            peek(action);

        cat(right: Iterable[T]) -> Pipe[T] pure =>
            CAT_PIPE[T](iterator, right.iterator);

        append(value: T) -> Pipe[T] pure =>
            cat([value]);

        prepend(value: T) -> Pipe[T] pure =>
            pipe([value]).cat(self);

        index() -> Pipe[INDEXED_VALUE[T]] pure =>
            INDEX_PIPE[T](iterator, 0);

        index(index: int) -> Pipe[INDEXED_VALUE[T]] pure =>
            INDEX_PIPE[T](iterator, index);

        enumerate() -> Pipe[INDEXED_VALUE[T]] pure =>
            index();

        enumerate(start_index: int) -> Pipe[INDEXED_VALUE[T]] pure =>
            index(start_index);

        // FIXME: can't use => here due to compiler bug
        zip[U](other: Iterable[U]) -> Pipe[(T,U)] pure =>
            ZIP_PIPE[T,U](iterator, other.iterator);

        // FIXME: can't use => here due to compiler bug
        zip[U,TOut](other: Iterable[U], mapper: (T,U) -> TOut pure) -> Pipe[TOut] pure =>
            ZIP_MAP_PIPE[T,U,TOut](iterator, other.iterator, mapper);

        reduce[TRunning](seed: TRunning, accumulator: (TRunning,T) -> TRunning pure) -> TRunning pure is
            let running mut = seed;
            for element in self do
                running = accumulator(running, element);
            od

            return running;
        si

        reduce[TRunning,TOut](seed: TRunning, accumulator: (TRunning,T) -> TRunning pure, mapper: (TRunning) -> TOut pure) -> TOut pure is
            let running mut = seed;
            for element in self do
                running = accumulator(running, element);
            od

            return mapper(running);
        si

        collect() -> List[T] pure =>
            collect_list();

        collect_array() -> T[] pure =>
            collect_list().to_array();

        collect_list() -> LIST[T] pure is
            let result = LIST[T]();

            for element in self do
                result.add(element);
            od

            return result;
        si

        collect_set() -> SET[T] pure is
            let result = SET[T]();

            for element in self do
                result.add(element);
            od

            return result;
        si

        collect_map[K,V](key_selector: (T) -> K pure, value_selector: (T) -> V pure) -> MAP[K,V] pure is
            let result = MAP[K,V]();

            for element in self do
                result.add(key_selector(element), value_selector(element));
            od

            return result;
        si

        partition(predicate: (T) -> bool pure) -> (LIST[T], LIST[T]) pure is
            let matching = LIST[T]();
            let non_matching = LIST[T]();

            for element in self do
                if predicate(element) then
                    matching.add(element);
                else
                    non_matching.add(element);
                fi
            od

            return (matching, non_matching);
        si

        min_by[K: System.IComparable[K]](key_selector: (T) -> K pure) -> MAYBE[T] pure is
            if move_next() then
                let result mut = current;
                let result_key mut = key_selector(result);

                while move_next() do
                    let candidate_key = key_selector(current);

                    if candidate_key.compare_to(result_key) < 0 then
                        result = current;
                        result_key = candidate_key;
                    fi
                od

                return MAYBE(result);
            fi

            return MAYBE[T]();
        si

        max_by[K: System.IComparable[K]](key_selector: (T) -> K pure) -> MAYBE[T] pure is
            if move_next() then
                let result mut = current;
                let result_key mut = key_selector(result);

                while move_next() do
                    let candidate_key = key_selector(current);

                    if candidate_key.compare_to(result_key) > 0 then
                        result = current;
                        result_key = candidate_key;
                    fi
                od

                return MAYBE(result);
            fi

            return MAYBE[T]();
        si

        count() -> int pure is
            let result mut = 0;
            while move_next() do
                result = result + 1;
            od

            return result;
        si

        find(predicate: (T) -> bool pure) -> MAYBE[T] pure is
            while move_next() do
                let element = current;

                if predicate(element) then
                    return MAYBE(element);
                fi
            od

            return MAYBE[T]();
        si

        find_map[U](mapper: (T) -> MAYBE[U] pure) -> MAYBE[U] pure is
            while move_next() do
                let element = current;
                let maybe_result = mapper(element);
    
                if maybe_result? then
                    return maybe_result;
                fi
            od
    
            return MAYBE[U]();
        si        

        find_or_throw(predicate: T -> bool pure) -> T pure is
            while move_next() do
                let element = current;

                if predicate(element) then
                    return element;
                fi
            od

            throw InvalidOperationException("no matching element found");
        si

        find_map_or_throw[U](mapper: (T) -> MAYBE[U] pure) -> U pure is
            while move_next() do
                let element = current;
                let maybe_result = mapper(element);
    
                if maybe_result? then
                    return maybe_result!;
                fi
            od
    
            throw InvalidOperationException("no matching element found");
        si        
        
        first() -> MAYBE[T] pure =>
            if move_next() then
                MAYBE(current)
            else
                MAYBE[T]()
            fi;

        first_map[U](mapper: (T) -> MAYBE[U] pure) -> MAYBE[U] pure is
            if move_next() then
                let element = current;
                let maybe_result = mapper(element);
    
                if maybe_result? then
                    return maybe_result
                fi
            fi

            return MAYBE[U]();
        si

        first_or_throw() -> T pure =>
            if move_next() then
                current
            else
                throw InvalidOperationException("no element found")
            fi;

        first_map_or_throw[U](mapper: (T) -> MAYBE[U] pure) -> U pure is
            if move_next() then
                let element = current;
                let maybe_result = mapper(element);
    
                if maybe_result? then
                    return maybe_result!
                fi
            fi
            
            throw InvalidOperationException("no matching element found");
        si
        
        only() -> T pure is
            if move_next() then
                let result = current;

                if move_next() then
                    throw InvalidOperationException("multiple elements found");
                fi

                reset();

                return result;
            else
                throw InvalidOperationException("no element found");
            fi
        si

        // deprecated
        has(predicate: (T) -> bool) -> bool is
            while move_next() do
                let element = current;

                if predicate(element) then
                    return true;
                fi
            od

            reset();

            return false;
        si

        any(predicate: (T) -> bool pure) -> bool pure is
            while move_next() do
                let element = current;

                if predicate(element) then
                    return true;
                fi
            od

            return false;
        si

        all(predicate: (T) -> bool pure) -> bool pure is
            while move_next() do
                let element = current;

                if !predicate(element) then
                    return false;
                fi
            od

            return true;
        si

        for_each(action: T -> void) is
            while move_next() do
                action(current);
            od
        si
        
        reverse() -> Pipe[T] pure =>
            let list = collect_list() in
            LIST_REVERSE_PIPE(list);
        
        sort() -> Pipe[T] pure is
            let list = collect_list();

            list.sort();

            reset();

            return pipe(list);
        si

        sort(comparer: IComparer[T]) -> Pipe[T] pure is
            let list = collect_list();

            list.sort(comparer);

            reset();

            return pipe(list);
        si

        sort(compare: (T, T) -> int pure) -> Pipe[T] pure =>
            sort(FUNCTION_COMPARER[T](compare));

        sort_descending() -> Pipe[T] pure is
            let list = collect_list();

            list.sort();

            reset();

            return LIST_REVERSE_PIPE(list);
        si

        sort_by[K: System.IComparable[K]](key_selector: (T) -> K pure) -> Pipe[T] pure =>
            sort(KEY_COMPARER[T,K](key_selector, false));

        sort_by_descending[K: System.IComparable[K]](key_selector: (T) -> K pure) -> Pipe[T] pure =>
            sort(KEY_COMPARER[T,K](key_selector, true));

        append_to(into: StringBuilder, separator: string) -> StringBuilder is
            let seen_any mut = false;
            while move_next() do
                if seen_any then
                    into.append(separator);
                fi

                into.append("{current}");

                seen_any = true;
            od
            
            reset();

            return into;
        si

        append_to(into: StringBuilder) -> StringBuilder =>
            append_to(into, ", ");

        join(separator: string) -> string pure =>
            let result = StringBuilder() in
            append_to(result, separator)
                .to_string();

        join() -> string pure =>
            join(", ");

        to_string() -> string =>
            join(", ");

        // deprecated
        to_string(separator: string) -> string =>
            join(separator);

        dispose() is
        si
    si
si