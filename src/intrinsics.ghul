    // System.Decimal is a 128-bit value type with no IL arithmetic
    // or compare opcodes. Each operator below routes to the matching
    // System.Decimal static method via the decimal-specific innate
    // handlers in IR.INNATE_OPERATION_GENERATOR.
    @INTRINSIC_ATTRIBUTE("arithmetic_decimal.neg") -(a: decimal) -> decimal pure;
    @INTRINSIC_ATTRIBUTE("arithmetic_decimal.add") +(a: decimal, b: decimal) -> decimal pure;
    @INTRINSIC_ATTRIBUTE("arithmetic_decimal.sub") -(a: decimal, b: decimal) -> decimal pure;
    @INTRINSIC_ATTRIBUTE("arithmetic_decimal.mul") *(a: decimal, b: decimal) -> decimal pure;
    @INTRINSIC_ATTRIBUTE("arithmetic_decimal.div") /(a: decimal, b: decimal) -> decimal pure;
    @INTRINSIC_ATTRIBUTE("compare_decimal.order") <>(a: decimal, b: decimal) -> int pure;
    @INTRINSIC_ATTRIBUTE("compare_decimal.equality") ==(a: decimal, b: decimal) -> bool pure;

    // Both operands are `string?`: `System.String.op_Equality(string, string)`
    // (the underlying innate) is null-safe — `null =~ null` is true, `null =~ "x"`
    // is false. Accepting nullable operands here lets `=~` / `!~` work uniformly
    // against BCL APIs that legitimately return `string?` (e.g. Environment
    // variables, `Path.get_directory_name`).
    @INTRINSIC_ATTRIBUTE("string.equals") =~(a: string?, b: string?) -> bool pure;

    // The range operators return the runtime's own range structs, so they
    // are declared here rather than beside the rest: the type they name
    // has to be in scope.
    @INTRINSIC_ATTRIBUTE("range.exclusive") ..(from: int, to: int) -> INT_RANGE pure;
    @INTRINSIC_ATTRIBUTE("range.inclusive") ::(from: int, to: int) -> INT_RANGE_INCLUSIVE pure;
si
