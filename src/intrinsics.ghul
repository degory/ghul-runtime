    @INTRINSIC_ATTRIBUTE("arithmetic.add") +(a: byte, b: byte) -> byte pure;
    @INTRINSIC_ATTRIBUTE("arithmetic.sub") -(a: byte, b: byte) -> byte pure;
    @INTRINSIC_ATTRIBUTE("arithmetic.mul") *(a: byte, b: byte) -> byte pure;
    @INTRINSIC_ATTRIBUTE("arithmetic.div") /(a: byte, b: byte) -> byte pure;
    @INTRINSIC_ATTRIBUTE("compare.order") <>(a: byte, b: byte) -> int pure;
    @INTRINSIC_ATTRIBUTE("arithmetic.shl") <<(a: byte, b: int) -> byte pure;
    @INTRINSIC_ATTRIBUTE("arithmetic.shr") >>(a: byte, b: int) -> byte pure;
    @INTRINSIC_ATTRIBUTE("arithmetic.ushr") >>>(a: byte, b: int) -> byte pure;
    @INTRINSIC_ATTRIBUTE("arithmetic.and") &(a: byte, b: byte) -> byte pure;
    @INTRINSIC_ATTRIBUTE("arithmetic.or") |(a: byte, b: byte) -> byte pure;
    @INTRINSIC_ATTRIBUTE("arithmetic.xor") ^(a: byte, b: byte) -> byte pure;

