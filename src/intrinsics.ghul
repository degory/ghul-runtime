    @INTRINSIC_ATTRIBUTE("arithmetic.sub") -(a: int, b: int) -> int pure;
    @INTRINSIC_ATTRIBUTE("arithmetic.mul") *(a: int, b: int) -> int pure;
    @INTRINSIC_ATTRIBUTE("arithmetic.div") /(a: int, b: int) -> int pure;
    @INTRINSIC_ATTRIBUTE("arithmetic.rem") %(a: int, b: int) -> int pure;
