namespace Ghul.Pipes is
    use Collections

    class INDEX_PIPE[T]: Pipe[INDEXED_VALUE[T]] is
        _initial_index: int
        _index: int
        _source: Iterable[T]
        _iterator: Iterator[T]

        iterator: Iterator[INDEXED_VALUE[T]] => self

        current: INDEXED_VALUE[T] =>
            INDEXED_VALUE(_index, _iterator.current)

        init(source: Iterable[T], index: int) is
            _source = source
            _iterator = source.iterator
            _initial_index = index
            _index = index - 1
        si

        move_next() -> bool is
            if _iterator.move_next() then
                _index = _index + 1
                return true
            fi

            reset()

            return false
        si

        reset() is
            _index = _initial_index - 1
            _iterator = rewind(_source, _iterator)
        si

        dispose() => _iterator.dispose()

        to_string() -> string => Ghul.Pipes.join(self)
    si
si
