namespace Ghul.Pipes is
    use Collections

    // Compares by a pre-computed key rather than re-deriving it from T on
    // every comparison, so sort_by/sort_by_descending pay for the key
    // selector once per element (O(n)) rather than once per comparison
    // (O(n log n)).
    /// Orders a pre-computed `(key, value)` pair by its key, ascending or descending as `descending` says.
    class PAIR_KEY_COMPARER[K: Ghul.Comparable[K],T]: Comparer[(K,T)] is
        _descending: bool

        /// Creates a comparer ordering by key ascending, or descending when `descending` is true.
        init(descending: bool) is
            _descending = descending
        si

        /// Compares `x` and `y` by their keys.
        compare(x: (K,T), y: (K,T)) -> int is
            let result = x.`0 <> y.`0

            if _descending then
                return -result
            fi

            return result
        si
    si
si
