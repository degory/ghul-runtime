namespace Ghul.Pipes is
    use Collections

    // One value, yielded `count` times, or without end when `count` is
    // negative. A count of zero yields nothing.
    /// `value`, yielded `count` times, or without end when `count` is
    /// negative; a count of zero yields no elements.
    class REPEAT_PIPE[T]: PipeStage[T] is
        _value: T
        _count: int
        _remaining: int

        /// Always `value`.
        current: T => _value

        init(value: T, count: int) is
            super.init()

            _value = value
            _count = count
            _remaining = count
        si

        /// A new repetition of `value`, not yet read.
        fresh() -> PipeStage[T] => REPEAT_PIPE[T](_value, _count)

        /// Advances to the next repetition; ends once `count`
        /// repetitions have been yielded.
        move_next() -> bool is
            if _remaining < 0 then
                return true
            fi

            if _remaining == 0 then
                return false
            fi

            _remaining = _remaining - 1

            return true
        si

        /// Renders the pipe's elements, in order, as text.
        @IF.dotnet()
        to_string() -> string => $(self)

        /// Has no effect.
        dispose() is
        si
    si
si
