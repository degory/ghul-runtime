namespace Ghul.Pipes is
    use Collections

    /// A `Comparer[T]` that orders by calling `comparer`.
    class FUNCTION_COMPARER[T]: Comparer[T] is
        _comparer: (T, T) -> int

        /// Creates a comparer that orders by calling `comparer`.
        init(comparer: (T, T) -> int) is
            _comparer = comparer
        si

        /// Compares `x` and `y` by calling the wrapped function.
        compare(x: T, y: T) -> int is
            return _comparer(x, y)
        si
    si
si

namespace Ghul.Pipes is
    use Collections

    /// A `Comparer[T]` that orders by `T`'s own `<>`.
    class COMPARABLE_COMPARER[T: Ghul.Comparable[T]]: Comparer[T] is
        /// Creates a comparer ordering by `<>`.
        init() is si

        /// Compares `x` and `y` with `<>`.
        compare(x: T, y: T) -> int => x <> y
    si
si
