namespace Ghul is
    // Ranges with one or both endpoints counted back from the end of
    // whatever they are applied to. The number of `<` says how many are,
    // filling from the right: `a..<b` counts `b` back from the end,
    // `a..<<b` counts both. `<k` is k back from the end, so `<0` is the
    // length and `a..<0` runs from a to the end.
    //
    // `..` and `::` count from the start and know their own bounds, so
    // they are ordinary iterable ranges. These do not, because where an
    // endpoint falls is not settled until the range meets a source. They
    // carry `System.Range` for that reason - it holds the from-the-end
    // bit per endpoint, and `get_offset_and_length` resolves the pair
    // against a length - and it is not iterable, so the type system
    // declines `for i in 1..<1 do` rather than needing a rule.

    ..<(from: int, to: int) -> System.Range pure =>
        System.Range(System.Index(from, false), System.Index(to, true));

    ..<<(from: int, to: int) -> System.Range pure =>
        System.Range(System.Index(from, true), System.Index(to, true));

    // An inclusive end k back from the end is an exclusive end at k - 1
    // back, so the endpoint moves rather than the range growing.
    ::<(from: int, to: int) -> System.Range pure =>
        System.Range(System.Index(from, false), _inclusive_end(to));

    ::<<(from: int, to: int) -> System.Range pure =>
        System.Range(System.Index(from, true), _inclusive_end(to));

    // Rejected here rather than where the range meets a source, and named
    // for what was asked: shifting `to = 0` would build an index one past
    // the end, and `System.Index` reports that as a negative value.
    _inclusive_end(to: int) -> System.Index pure is
        if to < 1 then
            throw
                System.ArgumentOutOfRangeException(
                    "to",
                    "{to} from the end is not an element to include: to run through the last element, use ::<1");
        fi

        return System.Index(to - 1, true);
    si
si
