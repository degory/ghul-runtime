namespace Ghul.Pipes is
    use Collections

    /// The concatenation of `mapper(x)` for each element `x` of `source`, in order.
    class FLAT_MAP_PIPE[TFrom,TTo]: PipeStage[TTo] is

        /// The most recently produced element.
        current: TTo

        _source: Iterable[TFrom]
        _iterator: Iterator[TFrom]
        // Absent until the first source element supplies one.
        _flat_iterator: Iterator[TTo]?

        _mapper: (TFrom) -> Iterable[TTo]

        init(source: Iterable[TFrom], mapper: (TFrom) -> Iterable[TTo]) is
            super.init()

            _source = source
            _iterator = source.iterator
            _mapper = mapper
        si

        /// A new stage over the same source, not yet read.
        fresh() -> PipeStage[TTo] => FLAT_MAP_PIPE[TFrom,TTo](_source, _mapper)

        /// Advances within the current inner sequence, moving to the next
        /// source element's inner sequence when it runs out.
        move_next() -> bool is
            do
                // Read into a local: advancing the iterator is a call,
                // which drops what the presence test just established
                // about the field.
                let flat = _flat_iterator

                if flat? /\ flat.move_next() then
                    current = flat.current

                    return true
                fi

                if !_iterator.move_next() then
                    return false
                fi

                let flat_iterable = _mapper(_iterator.current)

                _flat_iterator = flat_iterable.iterator
            od
        si

        /// Renders the pipe's elements, in order, as text.
        @IF.dotnet()
        to_string() -> string => $(self)

        /// Disposes the source's iterator and, if there is one, the current
        /// inner iterator.
        dispose() is
            _iterator.dispose()

            if let flat = _flat_iterator then
                flat.dispose()
            fi
        si
    si
si
