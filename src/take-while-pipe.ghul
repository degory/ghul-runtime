namespace Ghul.Pipes is
    use Collections

    class TAKE_WHILE_PIPE[T]: FilterPipeBase[T] is
        _predicate: (T) -> bool
        _done: bool

        init(iterator: Iterator[T], predicate: (T) -> bool) is
            super.init(iterator)
            _predicate = predicate
            _done = false;
        si

        should_continue() -> bool is
            if _done then
                return false;
            fi

            if !_predicate(current) then
                _done = true

                return false;
            fi

            return true;
        si

        should_include() -> bool => true

        reset() is
            super.reset()
            _done = false;
        si
    si
si
