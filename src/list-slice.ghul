namespace Ghul.Pipes is
    use Collections

    // A slice of part of an indexable source: a view onto the source rather
    // than a copy of it. No elements are copied, so taking a slice is
    // constant time whatever the source's size, and a later change to the
    // source shows through the slice.
    //
    // Bounds are checked where the slice is taken rather than at a later read,
    // so an out-of-range slice fails at the point the mistake was made.
    /// A view onto `count` elements of `source` starting at `from`, produced by a range index. Not a copy.
    class LIST_SLICE[T]: List[T] is
        _source: List[T]
        _from: int
        _count: int

        /// Creates a slice of `count` elements of `source` starting at `from`; throws if it doesn't fit within `source`.
        init(source: List[T], from: int, count: int) is
            if from < 0 \/ count < 0 \/ from + count > source.count then
                throw
                    Ghul.ArgumentOutOfRangeException(
                        "from",
                        "{from} for {count} is not within a source of {source.count}")
            fi

            _source = source
            _from = from
            _count = count
        si

        /// The element at `i` within the slice.
        [i: int]: T is
            if i < 0 \/ i >= _count then
                throw Ghul.ArgumentOutOfRangeException("i", "{i} is not within a slice of {_count}")
            fi

            return _source[_from + i]
        si

        /// The number of elements in the slice.
        count: int => _count

        /// Iterates the slice's elements in order.
        iterator: Iterator[T] => LIST_SLICE_ITERATOR[T](_source, _from, _count)
    si

    /// Iterates the elements of a `LIST_SLICE`.
    class LIST_SLICE_ITERATOR[T]: Iterator[T] is
        _source: List[T]
        _from: int
        _count: int
        _index: int

        /// Creates an iterator over `count` elements of `source` starting at `from`.
        init(source: List[T], from: int, count: int) is
            _source = source
            _from = from
            _count = count

            reset()
        si

        /// The element the iterator is currently at.
        current: T => _source[_from + _index]

        /// Advances to the next element, and returns whether one was reached.
        move_next() -> bool is
            _index = _index + 1

            return _index < _count
        si

        /// Rewinds to before the first element, so the next read starts again.
        reset() is
            _index = -1
        si

        /// Has no effect; the iterator holds no resource to release.
        dispose() is
        si
    si
si
