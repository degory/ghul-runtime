namespace Ghul.Pipes is
    use Collections

    class WINDOWS_PIPE[T]: Pipe[LIST[T]] is
        iterator: Iterator[LIST[T]] => self

        current: LIST[T]

        _source: Iterable[T]
        _iterator: Iterator[T]
        _pending: PENDING_CURSOR[T]?

        _size: int

        _buffer: LIST[T]

        init(source: Iterable[T], size: int) is
            assert size > 0 else "window size must be positive"

            _source = source
            _iterator = source.iterator
            _size = size
            _buffer = LIST[T]()
        si

        move_next() -> bool is
            while _buffer.count < _size /\ _iterator.move_next() do
                _buffer.add(_iterator.current)
            od

            if _buffer.count < _size then
                reset()

                return false
            fi

            current = LIST[T](_buffer)

            _buffer.remove_at(0)

            return true
        si

        reset() is
            _iterator = rewind(_iterator, pending())
            _buffer = LIST[T]()
        si

        pending() -> PENDING_CURSOR[T] is
            if let p = _pending then
                return p
            fi

            let p = PENDING_CURSOR[T](_source, (it: Iterator[T]) is _iterator = it si)

            _pending = p

            return p
        si

        to_string() -> string => Ghul.Pipes.join(self)

        dispose() => _iterator.dispose()
    si
si
