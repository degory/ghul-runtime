namespace Ghul.Pipes is
    use Collections

    class WINDOWS_PIPE[T]: Pipe[LIST[T]] is
        iterator: Iterator[LIST[T]] => self

        current: LIST[T]

        _iterator: Iterator[T]

        _size: int

        _buffer: LIST[T]

        init(iterator: Iterator[T], size: int) is
            assert size > 0 else "window size must be positive"

            _iterator = iterator
            _size = size
            _buffer = LIST[T]();
        si

        move_next() -> bool is
            while _buffer.count < _size /\ _iterator.move_next() do
                _buffer.add(_iterator.current);
            od

            if _buffer.count < _size then
                reset()

                return false;
            fi

            current = LIST[T](_buffer)

            _buffer.remove_at(0)

            return true;
        si

        reset() is
            _iterator.reset()
            _buffer = LIST[T]();
        si

        to_string() -> string => self.join(", ")

        dispose() is
        si
    si
si
