namespace Ghul.Pipes is
    use Collections

    /// Overlapping lists of `size` consecutive elements of `source`,
    /// sliding one element at a time.
    class WINDOWS_PIPE[T]: PipeStage[List[T]] is

        /// The most recently produced window.
        current: List[T]

        _source: Iterable[T]
        _iterator: Iterator[T]

        _size: int

        _buffer: LIST[T]

        /// Throws if `size` isn't positive.
        init(source: Iterable[T], size: int) is
            super.init()

            assert size > 0 else "window size must be positive"

            _source = source
            _iterator = source.iterator
            _size = size
            _buffer = LIST[T]()
        si

        /// A new stage over the same source, not yet read.
        fresh() -> PipeStage[List[T]] => WINDOWS_PIPE[T](_source, _size)

        /// Fills the buffer to `size` elements and drops the oldest one
        /// after producing the window.
        move_next() -> bool is
            while _buffer.count < _size /\ _iterator.move_next() do
                _buffer.add(_iterator.current)
            od

            if _buffer.count < _size then
                return false
            fi

            current = LIST[T](_buffer)

            _buffer.remove_at(0)

            return true
        si

        /// Renders the pipe's elements, in order, as text.
        @IF.dotnet()
        to_string() -> string => $(self)

        /// Disposes the underlying iterator.
        dispose() => _iterator.dispose()
    si
si
