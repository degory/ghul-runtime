namespace Ghul.Pipes is
    use Collections

    /// `source`'s elements as runs of adjacent equal ones: a new run
    /// begins wherever an element is not `=~` to the one before it.
    class GROUP_PIPE[T]: PipeStage[List[T]] is

        /// The most recently produced run.
        current: List[T]

        _source: Iterable[T]
        _iterator: Iterator[T]

        // The element that ended the previous run. It belongs to the next
        // one, and the source has already been advanced past it, so it is
        // held here rather than read again.
        _carried: MAYBE[T]

        // Set once the source has run out, so it is not asked again after
        // it has said it is done.
        _done: bool

        init(source: Iterable[T]) is
            super.init()

            _source = source
            _iterator = source.iterator
            _carried = MAYBE[T]()
            _done = false
        si

        /// A new stage over the same source, not yet read.
        fresh() -> PipeStage[List[T]] => GROUP_PIPE[T](_source)

        /// Collects elements equal to the run's first until one differs,
        /// which is carried over to start the run after it.
        move_next() -> bool is
            if _done then
                return false
            fi

            let run = LIST[T]()

            if let carried = _carried then
                run.add(carried)

                _carried = MAYBE[T]()
            elif _iterator.move_next() then
                run.add(_iterator.current)
            else
                _done = true

                return false
            fi

            while _iterator.move_next() do
                let element = _iterator.current

                if element =~ run[0] then
                    run.add(element)
                else
                    _carried = MAYBE(element)

                    current = run

                    return true
                fi
            od

            _done = true
            current = run

            return true
        si

        /// Renders the pipe's elements, in order, as text.
        @IF.dotnet()
        to_string() -> string => $(self)

        /// Disposes the underlying iterator.
        dispose() => _iterator.dispose()
    si
si
