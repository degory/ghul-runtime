namespace Ghul.Pipes is
    use Collections

    /// Wraps an `Iterable[T]` as a `Pipe[T]`, taking a fresh iterator from
    /// the source for each read.
    class ADAPTOR_PIPE[T]: PipeStage[T] is
        _source: Iterable[T]
        _iterator: Iterator[T]

        init(iterable: Iterable[T]) is
            super.init()

            assert iterable?

            _source = iterable
            _iterator = iterable.iterator
        si

        /// A new stage over the same source, not yet read.
        fresh() -> PipeStage[T] => ADAPTOR_PIPE[T](_source)

        /// The element at the cursor's current position.
        current: T => _iterator.current

        /// Advances to the next element.
        move_next() -> bool is
            if _iterator.move_next() then
                return true
            fi

            return false
        si

        /// Renders the pipe's elements, in order, as text.
        to_string() -> string => $(self)

        /// Disposes the underlying iterator.
        dispose() => _iterator.dispose()
    si
si
