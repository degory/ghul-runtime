namespace Ghul.Pipes is
    use Collections;

    class ADAPTOR_PIPE[T]: Pipe[T] is
        _source: Iterable[T];
        _iterator: Iterator[T];

        init(iterable: Iterable[T]) is
            assert iterable?;

            _source = iterable;
            _iterator = iterable.iterator;
        si

        iterator: Iterator[T] => self;

        current: T => _iterator.current;

        move_next() -> bool is
            let result = _iterator.move_next();

            if !result then
                _iterator.reset();
            fi

            return result;
        si

        reset() => _iterator.reset();

        to_string() -> string => join(", ");

        dispose() is
        si

        count() -> int is
            if isa MutableBag[T](_source) then
                return cast MutableBag[T](_source).count;
            fi

            let result = 0;

            while move_next() do
                result = result + 1;
            od

            return result;
        si
    si
si
