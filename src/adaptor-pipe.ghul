namespace Ghul.Pipes is
    use Collections

    class ADAPTOR_PIPE[T]: Pipe[T] is
        _source: Iterable[T]
        _iterator: Iterator[T]
        _pending: PENDING_CURSOR[T]?

        init(iterable: Iterable[T]) is
            assert iterable?

            _source = iterable
            _iterator = iterable.iterator
        si

        iterator: Iterator[T] => self

        current: T => _iterator.current

        move_next() -> bool is
            if _iterator.move_next() then
                return true
            fi

            reset()

            return false
        si

        reset() is
            _iterator = rewind(_iterator, pending())
        si

        pending() -> PENDING_CURSOR[T] is
            if let p = _pending then
                return p
            fi

            let p = PENDING_CURSOR[T](_source, (it: Iterator[T]) is _iterator = it si)

            _pending = p

            return p
        si

        to_string() -> string => Ghul.Pipes.join(self)

        dispose() => _iterator.dispose()
    si
si
