namespace Ghul.Pipes is
    use Collections

    // Rewinds by re-deriving fresh iterators from the source iterables
    // rather than calling `reset()` on the spent ones - see
    // `adaptor-pipe.ghul`.
    // The left iterator is left spent when it runs out rather than
    // rewound there: nothing reads it again until the pipe as a whole
    // ends, and rewinding it mid-pass would only be undone and repeated
    // by reset() - a full extra drain of the left source.
    class CAT_PIPE[T]: Pipe[T] is
        _left_source: Iterable[T]
        _right_source: Iterable[T]
        _left: Iterator[T]
        _right: Iterator[T]

        _take_from_left: bool

        iterator: Iterator[T] => self

        current: T is
            if _take_from_left then
                return _left.current
            else
                return _right.current
            fi
        si

        init(left: Iterable[T], right: Iterable[T]) is
            _left_source = left
            _right_source = right
            _left = left.iterator
            _right = right.iterator
            _take_from_left = true
        si

        move_next() -> bool is
            if _take_from_left then
                _take_from_left = _left.move_next()

                if _take_from_left then
                    return true
                fi
            fi

            let result = _right.move_next()

            if result then
                return true
            fi

            reset()

            return false
        si

        reset() is
            _left = rewind(_left_source, _left)
            _right = rewind(_right_source, _right)

            _take_from_left = true
        si

        to_string() -> string => Ghul.Pipes.join(self)

        dispose() is
        si
    si
si
