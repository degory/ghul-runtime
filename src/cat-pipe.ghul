namespace Ghul.Pipes is
    use Collections

    /// The elements of `left` followed by the elements of `right`.
    class CAT_PIPE[T]: PipeStage[T] is
        _left_source: Iterable[T]
        _right_source: Iterable[T]
        _left: Iterator[T]
        _right: Iterator[T]

        _take_from_left: bool

        /// The element at the cursor's current position, from whichever
        /// source it's currently drawing from.
        current: T is
            if _take_from_left then
                return _left.current
            else
                return _right.current
            fi
        si

        init(left: Iterable[T], right: Iterable[T]) is
            super.init()

            _left_source = left
            _right_source = right
            _left = left.iterator
            _right = right.iterator
            _take_from_left = true
        si

        /// A new stage over the same sources, not yet read.
        fresh() -> PipeStage[T] => CAT_PIPE[T](_left_source, _right_source)

        /// Advances within `left` until it's exhausted, then within `right`.
        move_next() -> bool is
            if _take_from_left then
                _take_from_left = _left.move_next()

                if _take_from_left then
                    return true
                fi
            fi

            return _right.move_next()
        si

        /// Renders the pipe's elements, in order, as text.
        @IF.dotnet()
        to_string() -> string => $(self)

        /// Disposes both sources' iterators.
        dispose() is
            _left.dispose()
            _right.dispose()
        si
    si
si
