namespace Ghul.Pipes is
    use Collections

    class CHUNK_PIPE[T]: Pipe[LIST[T]] is
        iterator: Iterator[LIST[T]] => self

        current: LIST[T]

        _iterator: Iterator[T]

        _size: int

        // Set when the source signals exhaustion partway through a chunk.
        // The source resets itself at that point, so asking it again would
        // start pulling from the beginning; this pipe ends the pass on its
        // own instead.
        _done: bool

        init(iterator: Iterator[T], size: int) is
            assert size > 0 else "chunk size must be positive"

            _iterator = iterator
            _size = size
            _done = false
        si

        move_next() -> bool is
            if _done then
                reset()

                return false
            fi

            let chunk = LIST[T]()

            while chunk.count < _size /\ _iterator.move_next() do
                chunk.add(_iterator.current)
            od

            if chunk.count < _size then
                _done = true
            fi

            if chunk.count == 0 then
                reset()

                return false
            fi

            current = chunk

            return true
        si

        reset() is
            _iterator.reset()
            _done = false
        si

        to_string() -> string => Ghul.Pipes.join(self)

        dispose() is
        si
    si
si
