namespace Ghul.Internal is
    use System

    // Marker attribute emitted by the compiler on a parameter whose
    // declared type carries the argument-pack marker - `f: T.. -> U`.
    // The parameter's own type says only that it takes the tuple the
    // pack binds to, so without this marker a caller in another
    // assembly has nothing to tell it that a function of as many
    // parameters as the call supplies belongs there instead.
    // Compiler-emitted; not user-facing.
    class ARGUMENT_PACK_ATTRIBUTE: Attribute is
        // How many returns into the parameter's own type the marked
        // function type sits, since the marker can be written past the
        // outermost one - `f: X -> T.. -> U` asks for the N-ary
        // function the caller's own lambda returns. Zero is the
        // parameter's own type, which is what the argumentless form
        // means.
        depth: int

        init() is
            depth = 0
        si

        init(depth: int) is
            self.depth = depth
        si
    si

    // Marker attribute emitted by the compiler on the parameter that
    // absorbs a call's remaining arguments into the pack's tuple -
    // `v: T..`. Read on cross-assembly import so that a caller can
    // write the arguments out rather than assembling the tuple.
    // Compiler-emitted; not user-facing.
    class ARGUMENT_SPREAD_ATTRIBUTE: Attribute is
        init() is
        si
    si

    // Marker attribute emitted by the compiler on a function whose
    // declared return type carries the argument-pack marker -
    // `-> T.. -> U`. The returned value's own type says only that it
    // takes the tuple the pack binds to, so without this marker a
    // caller in another assembly has nothing to tell it that the
    // returned function is to be called with the arguments spread
    // out. Compiler-emitted; not user-facing.
    class RETURN_PACK_ATTRIBUTE: Attribute is
        // How many returns into the declared return type the marked
        // function type sits, mirroring ARGUMENT_PACK_ATTRIBUTE.depth:
        // `-> T.. -> U` is zero, `-> X -> T.. -> U` is one.
        depth: int

        init() is
            depth = 0
        si

        init(depth: int) is
            self.depth = depth
        si
    si
si
