namespace Ghul.Pipes is
    use Collections

    class MAP_PIPE[TFrom,TTo]: Pipe[TTo] is
        iterator: Iterator[TTo] => self

        current: TTo

        _source: Iterable[TFrom]
        _iterator: Iterator[TFrom]
        _pending: PENDING_CURSOR[TFrom]?

        _mapper: (TFrom) -> TTo

        init(source: Iterable[TFrom], mapper: (TFrom) -> TTo) is
            _source = source
            _iterator = source.iterator
            _mapper = mapper
        si

        move_next() -> bool is
            if _iterator.move_next() then
                current = _mapper(_iterator.current)
                return true
            fi

            reset()

            return false
        si

        reset() is
            _iterator = rewind(_iterator, pending())
        si

        pending() -> PENDING_CURSOR[TFrom] is
            if let p = _pending then
                return p
            fi

            let p = PENDING_CURSOR[TFrom](_source, (it: Iterator[TFrom]) is _iterator = it si)

            _pending = p

            return p
        si

        to_string() -> string => Ghul.Pipes.join(self)

        dispose() => _iterator.dispose()
    si
si
