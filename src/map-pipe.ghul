namespace Ghul.Pipes is
    use Collections

    // Rewinds by re-deriving a fresh iterator from the source iterable
    // rather than calling `reset()` on the spent one - see
    // `adaptor-pipe.ghul`.
    class MAP_PIPE[TFrom,TTo]: Pipe[TTo] is
        iterator: Iterator[TTo] => self

        current: TTo

        _source: Iterable[TFrom]
        _iterator: Iterator[TFrom]

        _mapper: (TFrom) -> TTo

        init(source: Iterable[TFrom], mapper: (TFrom) -> TTo) is
            _source = source
            _iterator = source.iterator
            _mapper = mapper
        si

        move_next() -> bool is
            if _iterator.move_next() then
                current = _mapper(_iterator.current)
                return true
            fi

            reset()

            // TODO: should we set current to default value?

            return false
        si

        reset() is
            _iterator = rewind(_source, _iterator)
        si

        to_string() -> string => Ghul.Pipes.join(self)

        dispose() is
        si
    si
si
