namespace Ghul.Pipes is
    use Collections

    class FilterPipeBase[T]: Pipe[T] is
        _iterator: Iterator[T]

        iterator: Iterator[T] => self

        current: T => _iterator.current

        init(iterator: Iterator[T]) is
            _iterator = iterator
        si

        move_next() -> bool is
            while _iterator.move_next() do
                have_moved()

                if !should_continue() then
                    break
                fi

                if should_include() then
                    return true
                fi
            od

            reset()

            return false
        si

        have_moved() is si

        should_continue() -> bool => true

        should_include() -> bool

        count() -> int pure is
            let result mut = 0

            while move_next() do
                result = result + 1
            od

            reset()

            return result
        si

        reset() => _iterator.reset()
        // dispose() => _iterator.dispose();

        to_string() -> string => Ghul.Pipes.join(self)

        dispose() is
        si
    si
si
