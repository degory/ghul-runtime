namespace Ghul.Pipes is
    use Collections

    // Rewinds by re-deriving a fresh iterator from the source iterable
    // rather than calling `reset()` on the spent one - see
    // `adaptor-pipe.ghul`.
    class FilterPipeBase[T]: Pipe[T] is
        _source: Iterable[T]
        _iterator: Iterator[T]

        iterator: Iterator[T] => self

        current: T => _iterator.current

        init(source: Iterable[T]) is
            _source = source
            _iterator = source.iterator
        si

        move_next() -> bool is
            while _iterator.move_next() do
                have_moved()

                if !should_continue() then
                    break
                fi

                if should_include() then
                    return true
                fi
            od

            reset()

            return false
        si

        have_moved() is si

        should_continue() -> bool => true

        should_include() -> bool

        count() -> int pure is
            let result mut = 0

            while move_next() do
                result = result + 1
            od

            reset()

            return result
        si

        reset() is
            _iterator = rewind(_source, _iterator)
        si

        to_string() -> string => Ghul.Pipes.join(self)

        dispose() is
        si
    si
si
