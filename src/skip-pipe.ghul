namespace Ghul.Pipes is
    use Collections

    /// `source`'s elements after the first `skip_count` of them.
    class SKIP_PIPE[T]: FilterPipeBase[T] is
        _initial_skip_count: int
        _skip_count: int

        init(source: Iterable[T], skip_count: int) is
            super.init(source)
            _initial_skip_count = skip_count
            _skip_count = skip_count
        si

        /// A new stage of this kind over `source`, not yet read.
        fresh_over(source: Iterable[T]) -> FilterPipeBase[T] => SKIP_PIPE[T](source, _initial_skip_count)

        /// Counts down towards the point where elements start being included.
        have_moved() is
            _skip_count = _skip_count - 1
        si

        /// Always continues.
        should_continue() -> bool => true

        /// Accepts an element once `skip_count` elements have been skipped.
        should_include() -> bool => _skip_count < 0
    si
si
