namespace Ghul.Pipes is
    use Collections

    /// The paired elements of `source_1` and `source_2`, stopping once
    /// either source is exhausted.
    class ZIP_PIPE[T1,T2]: PipeStage[(T1,T2)] is
        _source_1: Iterable[T1]
        _source_2: Iterable[T2]
        _iterator_1: Iterator[T1]
        _iterator_2: Iterator[T2]

        _current: (T1,T2)

        /// The most recently produced pair.
        current: (T1,T2) => _current

        init(source_1: Iterable[T1], source_2: Iterable[T2]) is
            super.init()

            _source_1 = source_1
            _source_2 = source_2
            _iterator_1 = source_1.iterator
            _iterator_2 = source_2.iterator
        si

        /// A new stage over the same sources, not yet read.
        fresh() -> PipeStage[(T1,T2)] => ZIP_PIPE[T1,T2](_source_1, _source_2)

        /// Advances both sources and pairs their current elements.
        move_next() -> bool is
            if _iterator_1.move_next() /\ _iterator_2.move_next() then
                _current = (_iterator_1.current, _iterator_2.current)
                return true
            fi

            return false
        si

        /// Disposes both sources' iterators.
        dispose() is
            _iterator_1.dispose()
            _iterator_2.dispose()
        si

        /// Renders the pipe's elements, in order, as text.
        to_string() -> string => $(self)
    si
si
