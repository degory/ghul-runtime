namespace Ghul.Coroutines is
    use System.Runtime.CompilerServices.IAsyncStateMachine
    use System.Runtime.CompilerServices.ICriticalNotifyCompletion
    use System.Runtime.CompilerServices.INotifyCompletion
    use System.Runtime.ExceptionServices.ExceptionDispatchInfo

    // An awaitable that parks the calling coroutine on the current
    // scheduler until `run` gives it its next turn.
    /// An awaitable that parks the calling coroutine on the current scheduler until `run` gives it its next turn.
    pause() -> PAUSE => SCHEDULER.current.pause()

    // An awaitable that parks the calling coroutine on the current
    // scheduler until the given number of milliseconds has passed.
    /// An awaitable that parks the calling coroutine on the current scheduler until `milliseconds` have passed.
    sleep(milliseconds: int) -> SLEEP => SCHEDULER.current.sleep(milliseconds)

    // Resumes parked coroutines on the current scheduler until none
    // remain.
    /// Resumes parked coroutines on the current scheduler until none remain.
    run() is
        SCHEDULER.current.run()
    si

    // Implemented by an awaiter that hands the continuation it is
    // given to the scheduler itself - by queueing it, parking it as a
    // sleeper, or waking it through `schedule` - so the scheduler
    // already knows the coroutine is waiting. A coroutine awaiting
    // anything else, a task for instance, is resumed through the
    // scheduler's inbox instead, which `run` waits on.
    /// Marks an awaiter that parks its own continuation on the scheduler directly, rather than through the scheduler's inbox.
    trait SchedulerAwaiter open is
    si

    // Drives coroutines on one thread. A coroutine is an ordinary
    // asynchronous function returning `COROUTINE[T]` or `COROUTINE` -
    // the task-likes whose builders below run the body to its first
    // suspension and hand resumption to whatever the awaited value
    // does with its continuation.
    //
    // Calling a coroutine starts it: the body runs on the caller's
    // stack until it suspends, parking itself on the scheduler that
    // is current at the time. `run` resumes parked coroutines one at
    // a time until none remain; every resumption happens from `run`,
    // so stacks do not nest however many coroutines interleave.
    //
    // `current` is the scheduler a coroutine parks on, a channel or
    // lock queues a wake on, and a completing coroutine resumes its
    // awaiters on. It is a default instance unless one is installed,
    // and `spawn` and `run` make their own scheduler current while
    // they drive, so a program with one scheduler never names it.
    //
    // A coroutine may also await a task or any other awaitable the
    // scheduler does not own. Whatever thread completes it only posts
    // the continuation to the scheduler's inbox; `run` waits for the
    // post and resumes the coroutine on its own thread like any other.
    // Where the thread cannot block waiting for the post, such an
    // await is reported as an error instead.
    /// Drives coroutines on one thread. Calling a coroutine starts it on the caller's stack until it suspends; `run` then resumes parked coroutines one at a time until none remain.
    class SCHEDULER is
        _current: SCHEDULER? static

        _ready: Collections.Queue[() -> void]
        _sleepers: Collections.LIST[SLEEPER]

        // Continuations of awaits the scheduler does not own, posted
        // from whichever thread completed them. The count is of those
        // registered and not yet taken from the inbox, and is only
        // touched from the scheduler's own thread.
        _inbox: _INBOX
        _outstanding: int

        init() is
            _ready = Collections.Queue[() -> void]()
            _sleepers = Collections.LIST[SLEEPER]()
            _inbox = _INBOX()
        si

        // The scheduler coroutines park on, created on first use.
        /// The scheduler coroutines park on, created on first use if none has been installed.
        current: SCHEDULER static is
            if !_current? then
                _current = SCHEDULER()
            fi
            return _current
        si,
            = s is
                _current = s
            si

        // An awaitable that parks the calling coroutine until `run`
        // gives it its next turn.
        /// An awaitable that parks the calling coroutine until `run` gives it its next turn.
        pause() -> PAUSE => PAUSE(_ready)

        // An awaitable that parks the calling coroutine until the
        // given number of milliseconds has passed.
        /// An awaitable that parks the calling coroutine until `milliseconds` have passed.
        sleep(milliseconds: int) -> SLEEP => SLEEP(self, now + cast long(milliseconds))

        // Parks a coroutine until its deadline. Reached by `sleep`'s
        // awaiter.
        /// Parks a coroutine until `deadline` passes, then calls `resume`. Called by `sleep`'s awaiter.
        sleep_until(deadline: long, resume: () -> void) is
            _sleepers.add(SLEEPER(deadline, resume))
        si

        // The clock deadlines are measured against, in milliseconds.
        /// The clock deadlines are measured against, in milliseconds.
        now: long static => System.Environment.tick_count64

        // Queues a continuation to run from the next `run`. Reached
        // by a channel, a lock or a completing coroutine waking
        // whatever waits on it, so the waiter resumes from `run`
        // rather than nested inside the waker's call.
        /// Queues `continuation` to run from the next `run`, rather than nested inside the caller.
        schedule(continuation: () -> void) is
            _ready.enqueue(continuation)
        si

        // Wraps the continuation of an await this scheduler does not
        // own. The awaited value calls the wrapper from whatever thread
        // completes it, and all the wrapper does is post the
        // continuation for `run` to resume. Reached by the coroutine
        // builders.
        /// Wraps `continuation` from an await this scheduler doesn't own, so it only posts back to the scheduler's inbox for `run` to resume. Called by the coroutine builders.
        external(continuation: () -> void) -> () -> void is
            _outstanding = _outstanding + 1

            let inbox = _inbox

            return () is
                inbox.post(continuation)
            si
        si

        // Starts a coroutine on this scheduler and returns its handle.
        // The body has already run to its first suspension when this
        // returns.
        /// Starts a coroutine on this scheduler and returns its handle. The body has already run to its first suspension by the time this returns.
        spawn[T](body: SCHEDULER -> COROUTINE[T]) -> COROUTINE[T] is
            let previous = current
            current = self

            try
                return body(self)
            finally
                current = previous
            yrt
        si

        /// Starts a value-less coroutine on this scheduler and returns its handle, with the body already run to its first suspension.
        spawn(body: SCHEDULER -> COROUTINE) -> COROUTINE is
            let previous = current
            current = self

            try
                return body(self)
            finally
                current = previous
            yrt
        si

        // Resumes parked coroutines until none remain, waiting for the
        // next deadline or the next post to the inbox whenever nothing
        // is ready.
        //
        // A pass runs the coroutines that were ready when it started
        // and no more, so one that pauses in a loop takes a single turn
        // per pass rather than holding the queue. Every pass then looks
        // at the sleepers, which is what keeps a coroutine whose
        // deadline has come from waiting on one that never finishes.
        /// Resumes parked coroutines until none remain, waiting for the next deadline or the next inbox post whenever no coroutine is ready.
        run() is
            let previous = current
            current = self

            try
                while _ready.count > 0 \/ _sleepers.count > 0 \/ _outstanding > 0 do
                    _take_posted()

                    let turns mut = _ready.count

                    while turns > 0 do
                        _ready.dequeue()()
                        turns = turns - 1
                    od

                    _take_posted()

                    if _ready.count == 0 /\ _outstanding > 0 then
                        _wait_for_post()
                        _wake_due_sleepers(false)
                    else
                        _wake_due_sleepers(_ready.count == 0)
                    fi
                od
            finally
                current = previous
            yrt
        si

        // Moves every posted continuation onto the ready queue.
        _take_posted() is
            _outstanding = _outstanding - _inbox.take_all(_ready)
        si

        // Blocks until something is posted to the inbox, or until the
        // earliest sleeper's deadline when there is one.
        _wait_for_post() is
            let timeout mut = -1

            if _sleepers.count > 0 then
                let earliest mut = _sleepers[0].deadline

                for s in _sleepers do
                    if s.deadline < earliest then
                        earliest = s.deadline
                    fi
                od

                let remaining = earliest - now
                timeout = if remaining > 0L then cast int(remaining) else 0 fi
            fi

            _inbox.wait(timeout)
        si

        // Queues every sleeper whose deadline has passed. With nothing
        // ready to run there is no coroutine for a wait to interleave
        // with, so the thread waits for the earliest deadline; with
        // work still queued it takes whatever is already due and
        // leaves the rest, and that wait is the only place the
        // scheduler blocks.
        _wake_due_sleepers(may_wait: bool) is
            if _sleepers.count == 0 then
                return
            fi

            if may_wait then
                let earliest mut = _sleepers[0].deadline

                for s in _sleepers do
                    if s.deadline < earliest then
                        earliest = s.deadline
                    fi
                od

                let remaining = earliest - now

                if remaining > 0L then
                    _pause_thread(cast int(remaining))
                fi
            fi

            let due = now
            let still_waiting = Collections.LIST[SLEEPER]()

            for s in _sleepers do
                if s.deadline <= due then
                    _ready.enqueue(s.resume)
                else
                    still_waiting.add(s)
                fi
            od

            _sleepers = still_waiting
        si
    si

    // Blocks the scheduler's thread until `milliseconds` have passed.
    @IF.dotnet()
    _pause_thread(milliseconds: int) is
        System.Threading.Thread.sleep(milliseconds)
    si

    // A program on the wasm target has one thread, which waits for the
    // deadline on the clock.
    @IF.wasm()
    _pause_thread(milliseconds: int) is
        let deadline = SCHEDULER.now + cast long(milliseconds)

        while SCHEDULER.now < deadline do
        od
    si

    // The scheduler's inbox: continuations posted from whichever thread
    // completed an await the scheduler does not own, and the signal that
    // says one has arrived.
    @IF.dotnet()
    class _INBOX is
        _posted: System.Collections.Concurrent.ConcurrentQueue[() -> void]
        _signal: System.Threading.ManualResetEventSlim

        init() is
            _posted = System.Collections.Concurrent.ConcurrentQueue[() -> void]()
            _signal = System.Threading.ManualResetEventSlim(false)
        si

        // Posts `continuation`, from any thread.
        post(continuation: () -> void) is
            _posted.enqueue(continuation)
            _signal.set()
        si

        // Moves every posted continuation onto `ready`, and answers how
        // many there were.
        take_all(ready: Collections.Queue[() -> void]) -> int is
            let continuation: () -> void mut = () is si
            let count mut = 0

            while _posted.try_dequeue(continuation ref) do
                ready.enqueue(continuation)
                count = count + 1
            od

            return count
        si

        // Blocks until something is posted, or for `timeout` milliseconds
        // where it is not -1. The inbox is always emptied before this is
        // reached, so resetting the signal afterwards cannot lose a post:
        // one arriving after the reset is still in the queue for the next
        // pass to take.
        wait(timeout: int) is
            try
                _signal.wait(timeout)
            catch e: System.PlatformNotSupportedException
                throw Ghul.InvalidOperationException(
                    "a coroutine is awaiting something the scheduler does not own, "
                    "and this thread cannot block waiting for it", e)
            yrt

            _signal.reset()
        si
    si

    // On the wasm target there is no other thread to post from, so a
    // coroutine awaiting something the scheduler does not own would wait
    // for ever, and waiting is reported instead.
    @IF.wasm()
    class _INBOX is
        _posted: Collections.Queue[() -> void]

        init() is
            _posted = Collections.Queue[() -> void]()
        si

        post(continuation: () -> void) is
            _posted.enqueue(continuation)
        si

        take_all(ready: Collections.Queue[() -> void]) -> int is
            let count mut = 0

            while _posted.count > 0 do
                ready.enqueue(_posted.dequeue())
                count = count + 1
            od

            return count
        si

        wait(timeout: int) is
            throw Ghul.InvalidOperationException(
                "a coroutine is awaiting something the scheduler does not own, "
                "and this thread cannot block waiting for it")
        si
    si

    // The awaitable `pause()` returns. Its awaiter is itself: never
    // completed, and registering a continuation parks it on the
    // scheduler's ready queue.
    /// The awaitable `pause()` returns. Never completes on its own; registering a continuation parks it on the scheduler's ready queue.
    struct PAUSE: ICriticalNotifyCompletion, SchedulerAwaiter is
        _ready: Collections.Queue[() -> void]

        init(ready: Collections.Queue[() -> void]) is
            _ready = ready
        si

        /// Returns itself as its own awaiter, as the awaiter pattern requires.
        get_awaiter() -> PAUSE => self

        /// Whether the await has already completed. Always false: pausing only ends when `run` gives the coroutine its next turn.
        is_completed: bool => false

        /// Called after completion by the compiler's async lowering; pausing has no result to return.
        get_result() is
        si

        /// Queues `continuation` on the scheduler's ready queue. Called by the compiler's async lowering when the coroutine awaits a pause.
        on_completed(continuation: () -> void) is
            _ready.enqueue(continuation)
        si

        /// The same as `on_completed`. The async lowering calls this one when the execution context doesn't need to flow.
        unsafe_on_completed(continuation: () -> void) is
            _ready.enqueue(continuation)
        si
    si

    // The awaitable `sleep(ms)` returns; its awaiter is itself.
    // Completed once the deadline has passed; otherwise registering a
    // continuation parks it on the scheduler until it does.
    /// The awaitable `sleep(ms)` returns. Completes once its deadline has passed; otherwise registering a continuation parks it on the scheduler until then.
    struct SLEEP: ICriticalNotifyCompletion, SchedulerAwaiter is
        _scheduler: SCHEDULER
        _deadline: long

        init(scheduler: SCHEDULER, deadline: long) is
            _scheduler = scheduler
            _deadline = deadline
        si

        /// Returns itself as its own awaiter, as the awaiter pattern requires.
        get_awaiter() -> SLEEP => self

        /// Whether the deadline has passed.
        is_completed: bool => _deadline <= SCHEDULER.now

        /// Called after completion by the compiler's async lowering; sleeping has no result to return.
        get_result() is
        si

        /// Parks the continuation on the scheduler until the deadline passes. Called by the compiler's async lowering when the coroutine awaits a sleep.
        on_completed(continuation: () -> void) is
            _scheduler.sleep_until(_deadline, continuation)
        si

        /// The same as `on_completed`. The async lowering calls this one when the execution context doesn't need to flow.
        unsafe_on_completed(continuation: () -> void) is
            _scheduler.sleep_until(_deadline, continuation)
        si
    si

    // A coroutine parked until its deadline, and how to resume it.
    /// A coroutine parked until its deadline, and how to resume it.
    class SLEEPER(deadline: long, resume: () -> void) is si

    // The handle to a coroutine producing a value. Completed when the
    // body returned or threw; `value` is its result and `exception`
    // its failure. Awaiting the handle parks the caller until the
    // coroutine completes and then yields its value, so a coroutine
    // calls another the way a function does; the caller resumes on
    // the scheduler it parked on, whichever one completed the
    // callee. Reading `value` before completion is an error, and
    // either route rethrows a failed coroutine's own exception.
    /// The handle to a coroutine producing a value of type `T`. Completed when the body returns or throws; awaiting it parks the caller until then and yields the result. Reading `value` before completion is an error, and either route rethrows a failed coroutine's own exception.
    @System.Runtime.CompilerServices.AsyncMethodBuilder(typeof(COROUTINE_BUILDER[_]))
    class COROUTINE[T]: ICriticalNotifyCompletion, SchedulerAwaiter is
        /// The coroutine's failure, if it failed.
        exception: Ghul.Exception?

        /// Whether the coroutine has finished, successfully or not.
        completed: bool

        _value: Ghul.MAYBE[T]
        _waiters: Collections.LIST[WAITER[bool]]

        init() is
            _waiters = Collections.LIST[WAITER[bool]]()
        si

        // The coroutine's result. Reading before completion is an
        // error; a failure rethrows its exception.
        /// The coroutine's result. Reading before completion is an error, and reading after a failure rethrows its exception.
        value: T is
            if let e = exception then
                ExceptionDispatchInfo.capture(e).`throw()
            fi
            return _value!
        si

        /// Returns itself as its own awaiter, as the awaiter pattern requires.
        get_awaiter() -> COROUTINE[T] => self

        /// Whether the coroutine has completed.
        is_completed: bool => completed

        /// Returns the coroutine's result, called by the compiler's async lowering once the await completes.
        get_result() -> T => value

        /// Parks the continuation until the coroutine completes. Called by the compiler's async lowering when another coroutine awaits this handle.
        on_completed(continuation: () -> void) is
            _wait(continuation)
        si

        /// The same as `on_completed`. The async lowering calls this one when the execution context doesn't need to flow.
        unsafe_on_completed(continuation: () -> void) is
            _wait(continuation)
        si

        // Records a successful outcome. Reached by the builder; the
        // public spelling keeps a hand-written builder possible.
        /// Records a successful outcome and wakes everything waiting on it.
        complete(value: T) is
            _value = Ghul.MAYBE[T](value)
            completed = true
            _wake()
        si

        // Records a failure.
        /// Records a failure and wakes everything waiting on it.
        fail(e: Ghul.Exception) is
            exception = e
            completed = true
            _wake()
        si

        // Parks an awaiter, on its own scheduler: the one current
        // when it registers, which is the one driving it.
        _wait(continuation: () -> void) is
            let waiter = WAITER[bool](true, continuation)

            if completed then
                waiter.wake()
            else
                _waiters.add(waiter)
            fi
        si

        _wake() is
            for w in _waiters do
                w.wake()
            od
            _waiters.clear()
        si
    si

    // The handle to a coroutine producing no value. Awaiting it parks
    // the caller until the coroutine completes.
    /// The handle to a coroutine producing no value. Awaiting it parks the caller until the coroutine completes.
    @System.Runtime.CompilerServices.AsyncMethodBuilder(typeof(COROUTINE_BUILDER))
    class COROUTINE: ICriticalNotifyCompletion, SchedulerAwaiter is
        /// The coroutine's failure, if it failed.
        exception: Ghul.Exception?

        /// Whether the coroutine has finished, successfully or not.
        completed: bool

        _waiters: Collections.LIST[WAITER[bool]]

        init() is
            _waiters = Collections.LIST[WAITER[bool]]()
        si

        /// Returns itself as its own awaiter, as the awaiter pattern requires.
        get_awaiter() -> COROUTINE => self

        /// Whether the coroutine has completed.
        is_completed: bool => completed

        // Rethrows a failed coroutine's exception; nothing otherwise.
        /// Rethrows a failed coroutine's own exception; a successful completion has no result. Called by the compiler's async lowering once the await completes.
        get_result() is
            if let e = exception then
                ExceptionDispatchInfo.capture(e).`throw()
            fi
        si

        /// Parks the continuation until the coroutine completes. Called by the compiler's async lowering when another coroutine awaits this handle.
        on_completed(continuation: () -> void) is
            _wait(continuation)
        si

        /// The same as `on_completed`. The async lowering calls this one when the execution context doesn't need to flow.
        unsafe_on_completed(continuation: () -> void) is
            _wait(continuation)
        si

        // Records completion. Reached by the builder; the public
        // spelling keeps a hand-written builder possible.
        /// Records completion and wakes everything waiting on it.
        complete() is
            completed = true
            _wake()
        si

        // Records a failure.
        /// Records a failure and wakes everything waiting on it.
        fail(e: Ghul.Exception) is
            exception = e
            completed = true
            _wake()
        si

        // Parks an awaiter, on its own scheduler: the one current
        // when it registers, which is the one driving it.
        _wait(continuation: () -> void) is
            let waiter = WAITER[bool](true, continuation)

            if completed then
                waiter.wake()
            else
                _waiters.add(waiter)
            fi
        si

        _wake() is
            for w in _waiters do
                w.wake()
            od
            _waiters.clear()
        si
    si

    // The builder async functions returning COROUTINE[T] drive,
    // named by the attribute on the type above. Runs the body inline
    // from `start`, records the outcome, and materialises the handle
    // lazily - `task` is read once, after `start` returns, whichever
    // order the body completed in.
    /// The builder the compiler drives for a function that returns `COROUTINE[T]`.
    class COROUTINE_BUILDER[T] is
        _result: Ghul.MAYBE[T]
        _exception: Ghul.Exception?
        _done: bool
        _coroutine: COROUTINE[T]?

        init() is
        si

        /// Creates a fresh builder. Called by the compiler's async lowering to start a `COROUTINE[T]`-returning function.
        create() -> COROUTINE_BUILDER[T] static => COROUTINE_BUILDER[T]()

        /// Runs the state machine's first step. Called by the compiler's async lowering to start the coroutine's body.
        start[A: IAsyncStateMachine](state_machine: A ref) is
            state_machine!.move_next()
        si

        /// The coroutine handle, created and filled in on first read. Read by the compiler's async lowering once the body has run to its first suspension.
        task: COROUTINE[T] is
            if !_coroutine? then
                let handle = COROUTINE[T]()
                _fill(handle)
                _coroutine = handle
                return handle
            fi
            return _coroutine
        si

        /// Records the coroutine's result. Called by the compiler's async lowering when the body returns a value.
        set_result(v: T) is
            _result = Ghul.MAYBE[T](v)
            _done = true
            if let handle = _coroutine then
                _fill(handle)
            fi
        si

        /// Records the coroutine's failure. Called by the compiler's async lowering when the body throws.
        set_exception(e: Ghul.Exception) is
            _exception = e
            _done = true
            if let handle = _coroutine then
                _fill(handle)
            fi
        si

        _fill(handle: COROUTINE[T]) is
            if _done then
                if _exception? then
                    handle.fail(_exception)
                else
                    handle.complete(_result!)
                fi
            fi
        si

        // An awaiter the scheduler owns is handed the continuation as
        // it is; anything else is handed one that posts it back to the
        // scheduler, so the coroutine resumes from `run`.
        /// Registers the state machine's resumption with `awaiter`, routing it through the scheduler's inbox unless the awaiter already belongs to the scheduler. Called by the compiler's async lowering for an `await` on an ordinary awaiter.
        await_on_completed[A: INotifyCompletion](awaiter: A ref, state_machine: IAsyncStateMachine) is
            if isa SchedulerAwaiter(awaiter!) then
                awaiter.on_completed(state_machine.move_next)
            else
                awaiter.on_completed(SCHEDULER.current.external(state_machine.move_next))
            fi
        si

        /// The same as `await_on_completed`, for an awaiter that implements `ICriticalNotifyCompletion`.
        await_unsafe_on_completed[A: ICriticalNotifyCompletion](awaiter: A ref, state_machine: IAsyncStateMachine) is
            if isa SchedulerAwaiter(awaiter!) then
                awaiter.unsafe_on_completed(state_machine.move_next)
            else
                awaiter.unsafe_on_completed(SCHEDULER.current.external(state_machine.move_next))
            fi
        si
    si

    // The builder async functions returning the value-less
    // COROUTINE drive.
    /// The builder the compiler drives for a function that returns `COROUTINE`.
    class COROUTINE_BUILDER is
        _exception: Ghul.Exception?
        _done: bool
        _coroutine: COROUTINE?

        init() is
        si

        /// Creates a fresh builder. Called by the compiler's async lowering to start a `COROUTINE`-returning function.
        create() -> COROUTINE_BUILDER static => COROUTINE_BUILDER()

        /// Runs the state machine's first step. Called by the compiler's async lowering to start the coroutine's body.
        start[A: IAsyncStateMachine](state_machine: A ref) is
            state_machine!.move_next()
        si

        /// The coroutine handle, created and filled in on first read. Read by the compiler's async lowering once the body has run to its first suspension.
        task: COROUTINE is
            if !_coroutine? then
                let handle = COROUTINE()
                _fill(handle)
                _coroutine = handle
                return handle
            fi
            return _coroutine
        si

        /// Records that the coroutine completed. Called by the compiler's async lowering when the body falls through or returns.
        set_result() is
            _done = true
            if let handle = _coroutine then
                _fill(handle)
            fi
        si

        /// Records the coroutine's failure. Called by the compiler's async lowering when the body throws.
        set_exception(e: Ghul.Exception) is
            _exception = e
            _done = true
            if let handle = _coroutine then
                _fill(handle)
            fi
        si

        _fill(handle: COROUTINE) is
            if _done then
                if _exception? then
                    handle.fail(_exception)
                else
                    handle.complete()
                fi
            fi
        si

        // An awaiter the scheduler owns is handed the continuation as
        // it is; anything else is handed one that posts it back to the
        // scheduler, so the coroutine resumes from `run`.
        /// Registers the state machine's resumption with `awaiter`, routing it through the scheduler's inbox unless the awaiter already belongs to the scheduler. Called by the compiler's async lowering for an `await` on an ordinary awaiter.
        await_on_completed[A: INotifyCompletion](awaiter: A ref, state_machine: IAsyncStateMachine) is
            if isa SchedulerAwaiter(awaiter!) then
                awaiter.on_completed(state_machine.move_next)
            else
                awaiter.on_completed(SCHEDULER.current.external(state_machine.move_next))
            fi
        si

        /// The same as `await_on_completed`, for an awaiter that implements `ICriticalNotifyCompletion`.
        await_unsafe_on_completed[A: ICriticalNotifyCompletion](awaiter: A ref, state_machine: IAsyncStateMachine) is
            if isa SchedulerAwaiter(awaiter!) then
                awaiter.unsafe_on_completed(state_machine.move_next)
            else
                awaiter.unsafe_on_completed(SCHEDULER.current.external(state_machine.move_next))
            fi
        si
    si

    // A message channel between coroutines. Sending never parks: the
    // value is buffered until a receiver takes it. Receiving an empty
    // channel parks the calling coroutine until a send arrives, and
    // is the usual way coroutines hand work to one another.
    /// A message channel between coroutines. Sending never parks; receiving from an empty channel parks the caller until a value arrives.
    class CHANNEL[T] is
        _values: Collections.Queue[T]
        _waiters: Collections.Queue[WAITER[TICKET[T]]]

        init() is
            _values = Collections.Queue[T]()
            _waiters = Collections.Queue[WAITER[TICKET[T]]]()
        si

        // Delivers a value. A parked receiver, if any, is handed the
        // value directly and queued on its own scheduler to take it,
        // so it resumes from `run` rather than nested inside this
        // call, and no later receiver can take the value from under
        // it.
        /// Delivers `v`, handing it directly to a parked receiver if there is one, otherwise buffering it.
        send(v: T) is
            if _waiters.count > 0 then
                let waiter = _waiters.dequeue()
                waiter.ticket.value = Ghul.MAYBE[T](v)
                waiter.wake()
            else
                _values.enqueue(v)
            fi
        si

        // An awaitable yielding the next value, parking the caller
        // when none has arrived yet.
        /// An awaitable yielding the next value, parking the caller when none has arrived yet.
        receive() -> RECEIVE[T] => RECEIVE[T](self, TICKET[T]())

        // The number of values buffered and not yet received.
        /// The number of values buffered and not yet received.
        buffered_count: int => _values.count

        // Takes the oldest buffered value. Reached by `receive`'s
        // awaiter; an empty queue here means the awaiter has already
        // established one is present.
        /// Takes the oldest buffered value. Called by `receive`'s awaiter once it has confirmed one is present.
        take_next() -> T => _values.dequeue()

        // Parks a receiver until a send arrives, which will fill its
        // ticket. Called by `receive`'s awaiter.
        /// Parks a receiver until a send fills `ticket`. Called by `receive`'s awaiter.
        wait_for_next(ticket: TICKET[T], resume: () -> void) is
            _waiters.enqueue(WAITER[TICKET[T]](ticket, resume))
        si
    si

    // A parked coroutine: what it is waiting for, and how to resume
    // it. The scheduler is the one current when it parked, so a wake
    // from wherever the waker runs queues it back where it belongs.
    /// A parked coroutine: what it is waiting for, and how to resume it.
    class WAITER[T](ticket: T, resume: () -> void) is
        _scheduler: SCHEDULER

        init(..) is
            _scheduler = SCHEDULER.current
        si

        /// Resumes the parked coroutine on the scheduler it parked on.
        wake() is
            _scheduler.schedule(resume)
        si
    si

    // Where a send leaves the value for a receiver that was parked.
    /// Where a send leaves the value for a receiver that was parked.
    class TICKET[T] is
        /// The delivered value, once a send has filled it.
        value: Ghul.MAYBE[T] public

        init() is
        si
    si

    // The awaitable `channel.receive()` returns; its awaiter is
    // itself. Completed when a value is buffered; otherwise
    // registering a continuation parks it on the channel until a
    // send arrives, and the value comes back through the ticket.
    /// The awaitable `channel.receive()` returns. Completed when a value is already buffered; otherwise registering a continuation parks it on the channel until a send arrives.
    struct RECEIVE[T]: ICriticalNotifyCompletion, SchedulerAwaiter is
        _channel: CHANNEL[T]
        _ticket: TICKET[T]

        init(channel: CHANNEL[T], ticket: TICKET[T]) is
            _channel = channel
            _ticket = ticket
        si

        /// Returns itself as its own awaiter, as the awaiter pattern requires.
        get_awaiter() -> RECEIVE[T] => self

        /// Whether a value is already buffered on the channel.
        is_completed: bool => _channel.buffered_count > 0

        /// Returns the received value, called by the compiler's async lowering once the await completes.
        get_result() -> T =>
            if let v = _ticket.value then v else _channel.take_next() fi

        /// Parks the continuation on the channel until a send arrives. Called by the compiler's async lowering when a coroutine awaits an empty channel.
        on_completed(continuation: () -> void) is
            _channel.wait_for_next(_ticket, continuation)
        si

        /// The same as `on_completed`. The async lowering calls this one when the execution context doesn't need to flow.
        unsafe_on_completed(continuation: () -> void) is
            _channel.wait_for_next(_ticket, continuation)
        si
    si

    // A counting lock between coroutines. `acquire` takes a permit,
    // parking the caller until one is free; `release` returns one.
    // Every waiter is served in the order it arrived, and a released
    // permit goes straight to the first of them rather than back into
    // the pool, so a later caller cannot overtake it.
    /// A counting lock between coroutines. `acquire` takes a permit, parking the caller until one is free; `release` returns one.
    class SEMAPHORE is
        _permits: int
        _waiters: Collections.Queue[WAITER[GRANT]]

        init(permits: int) is
            _permits = permits
            _waiters = Collections.Queue[WAITER[GRANT]]()
        si

        // An awaitable that yields once the caller holds a permit.
        /// An awaitable that yields once the caller holds a permit.
        acquire() -> ACQUIRE => ACQUIRE(self, GRANT())

        // The number of permits not currently held.
        /// The number of permits not currently held.
        available: int => _permits

        // Returns a permit, handing it to the first parked waiter if
        // there is one.
        /// Returns a permit, handing it directly to the first parked waiter if there is one.
        release() is
            if _waiters.count > 0 then
                let waiter = _waiters.dequeue()
                waiter.ticket.granted = true
                waiter.wake()
            else
                _permits = _permits + 1
            fi
        si

        // Takes a free permit. Reached by `acquire`'s awaiter, which
        // has already established one is free.
        /// Takes a free permit. Called by `acquire`'s awaiter once it has confirmed one is free.
        take_permit() is
            _permits = _permits - 1
        si

        // Parks a waiter until a release grants it a permit.
        /// Parks a waiter until a release grants `grant` a permit.
        wait_for_permit(grant: GRANT, resume: () -> void) is
            _waiters.enqueue(WAITER[GRANT](grant, resume))
        si
    si

    // A lock one coroutine holds at a time.
    /// A lock one coroutine holds at a time.
    class MUTEX: SEMAPHORE is
        init() is
            super.init(1)
        si
    si

    // Where a release records that a parked waiter now holds the
    // permit it was waiting for.
    /// Where a release records that a parked waiter now holds the permit it was waiting for.
    class GRANT is
        /// Whether the release has already granted this waiter its permit.
        granted: bool public

        init() is
        si
    si

    // The awaitable `semaphore.acquire()` returns; its awaiter is
    // itself. Completed when a permit is free, taking it; otherwise
    // registering a continuation parks it until a release grants
    // one.
    /// The awaitable `semaphore.acquire()` returns. Completed when a permit is already free, taking it; otherwise registering a continuation parks it until a release grants one.
    struct ACQUIRE: ICriticalNotifyCompletion, SchedulerAwaiter is
        _semaphore: SEMAPHORE
        _grant: GRANT

        init(semaphore: SEMAPHORE, grant: GRANT) is
            _semaphore = semaphore
            _grant = grant
        si

        /// Returns itself as its own awaiter, as the awaiter pattern requires.
        get_awaiter() -> ACQUIRE => self

        /// Whether a permit is already free.
        is_completed: bool => _semaphore.available > 0

        /// Takes the permit if it wasn't already granted while parked. Called by the compiler's async lowering once the await completes.
        get_result() is
            if !_grant.granted then
                _semaphore.take_permit()
            fi
        si

        /// Parks the continuation until a release grants this waiter a permit.
        on_completed(continuation: () -> void) is
            _semaphore.wait_for_permit(_grant, continuation)
        si

        /// The same as `on_completed`. The async lowering calls this one when the execution context doesn't need to flow.
        unsafe_on_completed(continuation: () -> void) is
            _semaphore.wait_for_permit(_grant, continuation)
        si
    si
si
