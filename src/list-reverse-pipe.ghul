namespace Ghul.Pipes is
    use Collections

    /// `list`'s elements in reverse order.
    class LIST_REVERSE_PIPE[T]: PipeStage[T] is
        _list: List[T]
        _index: int

        /// The element at the cursor's current position.
        current: T => _list[_index]

        init(list: List[T]) is
            super.init()

            assert list?

            _list = list
            _index = list.count
        si

        /// A new reverse walk over `list`, not yet read.
        fresh() -> PipeStage[T] => LIST_REVERSE_PIPE[T](_list)

        /// Steps backward through `list`; ends once it reaches the start.
        move_next() -> bool is
            if _index > 0 then
                _index = _index - 1

                return true
            fi

            return false
        si

        /// Renders the pipe's elements, in order, as text.
        to_string() -> string => $(self)

        /// Has no effect.
        dispose() is
        si
    si
si
