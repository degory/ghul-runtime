namespace Ghul.Pipes is
    use Collections

    class LIST_REVERSE_PIPE[T]: Pipe[T] is
        _list: List[T]
        _index: int

        iterator: Iterator[T] => self

        current: T => _list[_index]

        init(list: List[T]) is
            assert list?

            _list = list
            reset()
        si

        move_next() -> bool is
            let result = _index > 0

            if result then
                _index = _index - 1
            else
                reset()
            fi

            return result
        si

        reset() is
            _index = _list.count
        si

        count() -> int => _list.count

        to_string() -> string => self.join(", ")

        dispose() is
        si
    si
si
