namespace Ghul.Pipes is
    use Collections

    class LIST_REVERSE_PIPE[T]: Pipe[T] is
        _list: List[T]
        _index: int

        iterator: Iterator[T] => self

        current: T => _list[_index]

        init(list: List[T]) is
            assert list?

            _list = list
            _index = list.count
        si

        move_next() -> bool is
            if _index > 0 then
                _index = _index - 1

                return true
            fi

            reset()

            return false
        si

        reset() is
            _index = _list.count
        si

        to_string() -> string => Ghul.Pipes.join(self)

        dispose() is
        si
    si
si
