namespace Ghul.Pipes is
    use System.InvalidOperationException
    use System.Text.StringBuilder

    use Collections

    // The pipe combinators and terminals, as free functions taking the
    // sequence first so the thread-first operator chains them:
    // `xs |> filter(p) |> map(f) |> min()`. A trait member could not take
    // a bound on Pipe[T]'s own unbounded T - min/max above need one - so
    // every combinator, bounded or not, has this one call shape.
    //
    // Source parameter is Iterable[T], the loosest sufficient type, so a
    // chain can start directly from a raw array/list with no pipe() wrap.
    // A stage function returns Iterable[U] rather than the concrete stage
    // class it builds, so the stage classes stay an implementation detail
    // invisible to a chain's static type, and a stage offers nothing a
    // caller could use to drive it as a shared cursor.

    /// The elements of `source` that `predicate` accepts, in order.
    filter[T..](source: Iterable[T], predicate: T.. -> bool pure) -> Iterable[T] pure =>
        FilterPipe[T](source, predicate)

    /// The elements of `source`, each transformed by `mapper`.
    map[T..,U](source: Iterable[T], mapper: T.. -> U pure) -> Iterable[U] pure =>
        MAP_PIPE[T,U](source, mapper)

    /// The elements of the sequences `mapper` produces for each element of
    /// `source`, concatenated in order.
    flat_map[T..,U](source: Iterable[T], mapper: T.. -> Iterable[U] pure) -> Iterable[U] pure =>
        FLAT_MAP_PIPE[T,U](source, mapper)

    /// The elements of `source` after the first `count` of them.
    skip[T](source: Iterable[T], count: int) -> Iterable[T] pure =>
        SKIP_PIPE[T](source, count)

    /// The first `count` elements of `source`, or all of them when there are fewer.
    take[T](source: Iterable[T], count: int) -> Iterable[T] pure =>
        TAKE_PIPE[T](source, count)

    /// The elements of `source` from the first one `predicate` rejects onward.
    skip_while[T..](source: Iterable[T], predicate: T.. -> bool pure) -> Iterable[T] pure =>
        SKIP_WHILE_PIPE[T](source, predicate)

    /// The elements of `source` up to but not including the first one `predicate` rejects.
    take_while[T..](source: Iterable[T], predicate: T.. -> bool pure) -> Iterable[T] pure =>
        TAKE_WHILE_PIPE[T](source, predicate)

    /// The elements of `source` with duplicates removed, keeping each one's first occurrence.
    distinct[T](source: Iterable[T]) -> Iterable[T] pure =>
        DISTINCT_PIPE[T](source)

    /// The elements of `source` unchanged, calling `action` on each as it passes through.
    peek[T..](source: Iterable[T], action: T.. -> void) -> Iterable[T] pure =>
        PEEK_PIPE[T](source, action)

    /// The elements of `source`, cached on the first pass so a later pass replays them
    /// without reading `source` again.
    memo[T](source: Iterable[T]) -> Iterable[T] pure =>
        MEMO_PIPE[T](MEMO_CACHE[T](source))

    /// The elements of `source` grouped into consecutive read-only lists of `size`
    /// elements each, with the last one shorter if `source`'s length doesn't divide evenly.
    chunk[T](source: Iterable[T], size: int) -> Iterable[List[T]] pure =>
        CHUNK_PIPE[T](source, size)

    // Runs of adjacent equals, which is a different question from `group_by`:
    // that one gathers every element sharing a key wherever it appears, this
    // one only ever joins neighbours.
    /// `source`'s elements as runs of adjacent equal ones, each a read-only list, comparing
    /// with `=~`. A new run starts wherever an element differs from the one before it.
    group[T](source: Iterable[T]) -> Iterable[List[T]] pure =>
        GROUP_PIPE[T](source)

    // Both of these read the whole source before yielding anything, so
    // neither is lazy in its input; they are pipes because that is what
    // the combinators consume, not because they stream.
    /// `rows` with its rows and columns exchanged, each column a read-only list, so the
    /// nth element of the result is the nth element of each row in turn. Stops at the
    /// shortest row, so a ragged input is read as its rectangular part.
    transpose[T](rows: Iterable[Iterable[T]]) -> Pipe[List[T]] is
        let indexed = LIST[List[T]]()

        for row in rows do
            if isa List[T](row) then
                indexed.add(row)
            else
                indexed.add(row |> collect_mutable())
            fi
        od

        if indexed.count == 0 then
            return
        fi

        let width mut = indexed[0].count

        for row in indexed do
            if row.count < width then
                width = row.count
            fi
        od

        for column in 0..width do
            let column_values = LIST[T](indexed.count)

            for row in indexed do
                column_values.add(row[column])
            od

            yield column_values
        od
    si

    /// Every ordering of `source`'s elements, each as a read-only list. Produced in
    /// the order of the input's own positions, which is lexicographic when the
    /// input is sorted.
    permutations[T](source: Iterable[T]) -> Pipe[List[T]] is
        let items = source |> collect_mutable()

        if items.count == 0 then
            yield LIST[T]()

            return
        fi

        for index in 0..items.count do
            let rest = LIST[T](items)

            rest.remove_at(index)

            for tail in permutations(rest) do
                let whole = LIST[T]()

                whole.add(items[index])
                whole.add_range(tail)

                yield whole
            od
        od
    si

    /// The elements of `source` as overlapping read-only lists of `size` consecutive
    /// elements, each starting one place after the last.
    windows[T](source: Iterable[T], size: int) -> Iterable[List[T]] pure =>
        WINDOWS_PIPE[T](source, size)

    /// The elements of `source` followed by the elements of `right`.
    cat[T](source: Iterable[T], right: Iterable[T]) -> Iterable[T] pure =>
        CAT_PIPE[T](source, right)

    /// The elements of `source` and `right` combined, with duplicates removed.
    union_with[T](source: Iterable[T], right: Iterable[T]) -> Iterable[T] pure =>
        distinct(cat(source, right))

    /// The elements of `source` that also appear in `right`, with duplicates removed.
    intersect_with[T](source: Iterable[T], right: Iterable[T]) -> Iterable[T] pure =>
        INTERSECT_PIPE[T](source, right)

    /// The elements of `source` that don't appear in `right`, with duplicates removed.
    except[T](source: Iterable[T], right: Iterable[T]) -> Iterable[T] pure =>
        EXCEPT_PIPE[T](source, right)

    /// The elements of `source` paired with their position, counting from 0.
    index[T](source: Iterable[T]) -> Iterable[INDEXED_VALUE[T]] pure =>
        INDEX_PIPE[T](source, 0)

    /// The elements of `source` paired with their position, counting from `index`.
    index[T](source: Iterable[T], index: int) -> Iterable[INDEXED_VALUE[T]] pure =>
        INDEX_PIPE[T](source, index)

    /// The elements of `source` and `other` paired up, stopping when either runs out.
    zip[T,U](source: Iterable[T], other: Iterable[U]) -> Iterable[(T,U)] pure =>
        ZIP_PIPE[T,U](source, other)

    /// The elements of `source` and `other` combined pairwise by `mapper`,
    /// stopping when either runs out.
    zip[T,U,TOut](source: Iterable[T], other: Iterable[U], mapper: (T,U) -> TOut pure) -> Iterable[TOut] pure =>
        ZIP_MAP_PIPE[T,U,TOut](source, other, mapper)

    /// Folds `source` into a single value, starting from `seed` and combining
    /// it with each element in turn through `accumulator`.
    reduce[T..,TRunning](source: Iterable[T], seed: TRunning, accumulator: (TRunning,T..) -> TRunning pure) -> TRunning pure is
        let running mut = seed

        for element in source do
            running = accumulator(running, element)
        od

        return running
    si

    /// Folds `source` into a single value, starting from `seed` and combining it
    /// with each element in turn through `accumulator`, then transforms the result with `mapper`.
    reduce[T..,TRunning,TOut](source: Iterable[T], seed: TRunning, accumulator: (TRunning,T..) -> TRunning pure, mapper: (TRunning) -> TOut pure) -> TOut pure is
        let running mut = seed

        for element in source do
            running = accumulator(running, element)
        od

        return mapper(running)
    si

    /// The elements of `source`, collected into an array.
    collect[T](source: Iterable[T]) -> T[] pure =>
        collect_mutable(source).to_array()

    // the same as collect, which is the name to use
    /// The same as `collect`. Use `collect` instead.
    @System.Obsolete("use collect instead")
    collect_array[T](source: Iterable[T]) -> T[] pure =>
        collect(source)

    // the same as collect_mutable, which is the name to use
    /// The same as `collect_mutable`. Use `collect_mutable` instead.
    @System.Obsolete("use collect_mutable instead")
    collect_list[T](source: Iterable[T]) -> LIST[T] pure =>
        collect_mutable(source)

    /// The elements of `source`, collected into a mutable list.
    collect_mutable[T](source: Iterable[T]) -> LIST[T] pure is
        let result = LIST[T]()

        for element in source do
            result.add(element)
        od

        return result
    si

    /// The elements of `source`, collected into a set, with duplicates removed.
    collect_set[T](source: Iterable[T]) -> SET[T] pure is
        let result = SET[T]()

        for element in source do
            result.add(element)
        od

        return result
    si

    /// A read-only map built from `source`, with `key_selector` and `value_selector`
    /// producing each entry's key and value. Throws if `key_selector` produces the same
    /// key twice. `collect_mutable_map` gives back a mutable `MAP` instead.
    collect_map[T..,K,V](source: Iterable[T], key_selector: T.. -> K pure, value_selector: T.. -> V pure) -> Map[K,V] pure =>
        collect_mutable_map(source, key_selector, value_selector)

    /// A mutable map built from `source`, with `key_selector` and `value_selector`
    /// producing each entry's key and value. Throws if `key_selector` produces the same
    /// key twice.
    collect_mutable_map[T..,K,V](source: Iterable[T], key_selector: T.. -> K pure, value_selector: T.. -> V pure) -> MAP[K,V] pure is
        let result = MAP[K,V]()

        for element in source do
            result.add(key_selector(element), value_selector(element))
        od

        return result
    si

    // A map from a sequence of key and value pairs, as a map literal is
    // written: `[("a", 1), ("b", 2)] |> collect_map()`. A key given
    // twice throws, as adding it to the map twice would.
    /// A read-only map built from a sequence of key and value pairs, as a map literal is
    /// written: `[("a", 1), ("b", 2)] |> collect_map()`. Throws if the same key appears
    /// twice. `collect_mutable_map` gives back a mutable `MAP` instead.
    collect_map[K, V](source: Iterable[(K, V)]) -> Map[K, V] pure =>
        collect_mutable_map(source)

    /// A mutable map built from a sequence of key and value pairs. Throws if the same
    /// key appears twice.
    collect_mutable_map[K, V](source: Iterable[(K, V)]) -> MAP[K, V] pure is
        let result = MAP[K, V]()

        for (key, value) in source do
            result.add(key, value)
        od

        return result
    si

    /// Splits `source` into two read-only lists, of the elements `predicate` accepts and
    /// the elements it doesn't, each keeping `source`'s order.
    partition[T..](source: Iterable[T], predicate: T.. -> bool pure) -> (List[T], List[T]) pure is
        let matching = LIST[T]()
        let non_matching = LIST[T]()

        for element in source do
            if predicate(element) then
                matching.add(element)
            else
                non_matching.add(element)
            fi
        od

        return (matching, non_matching)
    si

    /// Groups the elements of `source` into a read-only map keyed by `key_selector`,
    /// each entry a read-only list of every element with that key, in order.
    group_by[T..,K](source: Iterable[T], key_selector: T.. -> K pure) -> Map[K, List[T]] pure is
        let result = MAP[K, List[T]]()
        let groups = MAP[K, LIST[T]]()

        for element in source do
            let key = key_selector(element)
            let group: LIST[T] mut

            if !groups.try_get_value(key, group ref) then
                group = LIST[T]()
                groups.add(key, group)
                result.add(key, group)
            fi

            group.add(element)
        od

        return result
    si

    /// The element of `source` with the smallest key `key_selector` produces, or absent
    /// if `source` has none. Keeps the first element reached when several share the smallest key.
    min_by[T..,K: Ghul.Comparable[K]](source: Iterable[T], key_selector: T.. -> K pure) -> MAYBE[T] pure is
        let it = source.iterator

        if it.move_next() then
            let result mut = it.current
            let result_key mut = key_selector(result)

            while it.move_next() do
                let candidate_key = key_selector(it.current)

                if candidate_key < result_key then
                    result = it.current
                    result_key = candidate_key
                fi
            od

            return MAYBE(result)
        fi

        return MAYBE[T]()
    si

    /// The element of `source` with the largest key `key_selector` produces, or absent
    /// if `source` has none. Keeps the first element reached when several share the largest key.
    max_by[T..,K: Ghul.Comparable[K]](source: Iterable[T], key_selector: T.. -> K pure) -> MAYBE[T] pure is
        let it = source.iterator

        if it.move_next() then
            let result mut = it.current
            let result_key mut = key_selector(result)

            while it.move_next() do
                let candidate_key = key_selector(it.current)

                if candidate_key > result_key then
                    result = it.current
                    result_key = candidate_key
                fi
            od

            return MAYBE(result)
        fi

        return MAYBE[T]()
    si

    /// The number of elements in `source`.
    count[T](source: Iterable[T]) -> int pure is
        if isa Bag[T](source) then
            return source.count
        fi

        if isa MutableBag[T](source) then
            return source.count
        fi

        let it = source.iterator
        let result mut = 0

        while it.move_next() do
            result = result + 1
        od

        return result
    si

    // How many elements satisfy the predicate.
    /// The number of elements in `source` that `predicate` accepts.
    count[T..](source: Iterable[T], predicate: T.. -> bool pure) -> int pure is
        let it = source.iterator
        let result mut = 0

        while it.move_next() do
            if predicate(it.current) then
                result = result + 1
            fi
        od

        return result
    si

    /// The first element of `source` that `predicate` accepts, or absent if none does.
    find[T..](source: Iterable[T], predicate: T.. -> bool pure) -> MAYBE[T] pure is
        let it = source.iterator

        while it.move_next() do
            let element = it.current

            if predicate(element) then
                return MAYBE(element)
            fi
        od

        return MAYBE[T]()
    si

    /// The first present result of applying `mapper` to the elements of `source`, in order.
    find_map[T..,U](source: Iterable[T], mapper: T.. -> MAYBE[U] pure) -> MAYBE[U] pure is
        let it = source.iterator

        while it.move_next() do
            let element = it.current
            let maybe_result = mapper(element)

            if maybe_result? then
                return maybe_result
            fi
        od

        return MAYBE[U]()
    si

    /// The first element of `source` that `predicate` accepts. Throws if none does.
    find_or_throw[T](source: Iterable[T], predicate: T -> bool pure) -> T pure is
        let it = source.iterator

        while it.move_next() do
            let element = it.current

            if predicate(element) then
                return element
            fi
        od

        throw InvalidOperationException("no matching element found")
    si

    /// The first present result of applying `mapper` to the elements of `source`.
    /// Throws if none is present.
    find_map_or_throw[T..,U](source: Iterable[T], mapper: T.. -> MAYBE[U] pure) -> U pure is
        let it = source.iterator

        while it.move_next() do
            let element = it.current
            let maybe_result = mapper(element)

            if maybe_result? then
                return maybe_result!
            fi
        od

        throw InvalidOperationException("no matching element found")
    si

    // Walks the whole source: a pipe is a cursor, so there is no
    // counting it and jumping to the end.
    /// The final element of `source`, or absent if it has none.
    last[T](source: Iterable[T]) -> MAYBE[T] pure is
        let it = source.iterator

        if !it.move_next() then
            return MAYBE[T]()
        fi

        let found mut = it.current

        while it.move_next() do
            found = it.current
        od

        return MAYBE(found)
    si

    /// The first element of `source`, or absent if it has none.
    first[T](source: Iterable[T]) -> MAYBE[T] pure is
        let it = source.iterator

        if it.move_next() then
            return MAYBE(it.current)
        fi

        return MAYBE[T]()
    si

    /// The result of `mapper` applied to the first element of `source`, or absent
    /// if `source` has no elements or that result is absent.
    first_map[T..,U](source: Iterable[T], mapper: T.. -> MAYBE[U] pure) -> MAYBE[U] pure is
        let it = source.iterator

        if it.move_next() then
            let element = it.current
            let maybe_result = mapper(element)

            if maybe_result? then
                return maybe_result
            fi
        fi

        return MAYBE[U]()
    si

    /// The first element of `source`. Throws if it has none.
    first_or_throw[T](source: Iterable[T]) -> T pure is
        let it = source.iterator

        if it.move_next() then
            return it.current
        fi

        throw InvalidOperationException("no element found")
    si

    /// The result of `mapper` applied to the first element of `source`, if present.
    /// Throws if `source` has no elements or that result is absent.
    first_map_or_throw[T..,U](source: Iterable[T], mapper: T.. -> MAYBE[U] pure) -> U pure is
        let it = source.iterator

        if it.move_next() then
            let element = it.current
            let maybe_result = mapper(element)

            if maybe_result? then
                return maybe_result!
            fi
        fi

        throw InvalidOperationException("no matching element found")
    si

    /// The one element of `source`. Throws if it holds none or more than one.
    only[T](source: Iterable[T]) -> T pure is
        let it = source.iterator

        if it.move_next() then
            let result = it.current

            if it.move_next() then
                throw InvalidOperationException("multiple elements found")
            fi

            return result
        else
            throw InvalidOperationException("no element found")
        fi
    si

    /// Whether `predicate` accepts any element of `source`.
    any[T..](source: Iterable[T], predicate: T.. -> bool pure) -> bool pure is
        let it = source.iterator

        while it.move_next() do
            let element = it.current

            if predicate(element) then
                return true
            fi
        od

        return false
    si

    /// Whether `predicate` accepts every element of `source`.
    all[T..](source: Iterable[T], predicate: T.. -> bool pure) -> bool pure is
        let it = source.iterator

        while it.move_next() do
            let element = it.current

            if !predicate(element) then
                return false
            fi
        od

        return true
    si

    /// Calls `action` on each element of `source`, in order.
    each[T..](source: Iterable[T], action: T.. -> void) is
        let it = source.iterator

        while it.move_next() do
            action(it.current)
        od
    si

    /// The elements of `source` in reverse order.
    reverse[T](source: Iterable[T]) -> Iterable[T] pure =>
        let list = collect_mutable(source) in
        LIST_REVERSE_PIPE(list)

    /// The elements of `source` sorted in ascending order.
    sort[T: Ghul.Comparable[T]](source: Iterable[T]) -> Iterable[T] pure =>
        _sort_ascending(source)

    _sort_ascending[T](source: Iterable[T]) -> Iterable[T] pure is
        let list = collect_mutable(source)

        list.sort()

        return pipe(list)
    si

    /// The elements of `source` sorted according to `comparer`.
    sort[T](source: Iterable[T], comparer: IComparer[T]) -> Iterable[T] pure is
        let list = collect_mutable(source)

        list.sort(comparer)

        return pipe(list)
    si

    /// The elements of `source` sorted according to `compare`.
    sort[T](source: Iterable[T], compare: (T, T) -> int pure) -> Iterable[T] pure =>
        sort(source, FUNCTION_COMPARER[T](compare))

    /// The elements of `source` sorted in descending order.
    sort_descending[T: Ghul.Comparable[T]](source: Iterable[T]) -> Iterable[T] pure =>
        _sort_descending(source)

    _sort_descending[T](source: Iterable[T]) -> Iterable[T] pure is
        let list = collect_mutable(source)

        list.sort()

        return LIST_REVERSE_PIPE(list)
    si

    /// The elements of `source` sorted in ascending order of the key `key_selector` produces.
    sort_by[T..,K: Ghul.Comparable[K]](source: Iterable[T], key_selector: T.. -> K pure) -> Iterable[T] pure =>
        _sort_by(source, key_selector, false)

    /// The elements of `source` sorted in descending order of the key `key_selector` produces.
    sort_by_descending[T..,K: Ghul.Comparable[K]](source: Iterable[T], key_selector: T.. -> K pure) -> Iterable[T] pure =>
        _sort_by(source, key_selector, true)

    // Computes each element's key once (into `keyed`) rather than
    // re-deriving it on every comparison inside the sort.
    _sort_by[T,K: Ghul.Comparable[K]](source: Iterable[T], key_selector: (T) -> K pure, descending: bool) -> Iterable[T] pure is
        let keyed = LIST[(K,T)]()

        for element in source do
            keyed.add((key_selector(element), element))
        od

        keyed.sort(PAIR_KEY_COMPARER[K,T](descending))

        let result = LIST[T]()

        for pair in keyed do
            result.add(pair.`1)
        od

        return pipe(result)
    si

    /// Writes the text of each element of `source` into `into`, separated by `separator`,
    /// and returns `into`.
    append_to[T](source: Iterable[T], into: StringBuilder, separator: string) -> StringBuilder is
        let it = source.iterator
        let seen_any mut = false

        while it.move_next() do
            if seen_any then
                into.append(separator)
            fi

            into.append("{it.current}")

            seen_any = true
        od

        return into
    si

    /// Writes the text of each element of `source` into `into`, separated by `", "`, and returns `into`.
    append_to[T](source: Iterable[T], into: StringBuilder) -> StringBuilder =>
        append_to(source, into, ", ")

    /// The elements of `source` joined into a string, separated by `separator`.
    join[T](source: Iterable[T], separator: string) -> string pure =>
        let result = StringBuilder() in
        append_to(source, result, separator)
            .to_string()

    // The elements of a sequence in brackets, as `[1, 2, 3]`, up to the
    // display element limit, whatever to_string its type declares. It is
    // how a pipe reads as text.
    /// The elements of `source` in brackets, as `[1, 2, 3]`, up to the display element limit.
    render_elements[T](source: Iterable[T]) -> string pure is
        let state = DISPLAY_STATE()

        state.render_elements(source)

        return state.to_string()
    si

    /// The elements of `source` joined into a string, separated by `", "`.
    join[T](source: Iterable[T]) -> string pure =>
        join(source, ", ")

    // Part of an indexable source, taken with a range: `xs |> slice(1..4)`.
    // Nothing is copied, so the result is a view onto the source rather than
    // a snapshot of it - a later change to a mutable source shows through.
    // `..` excludes its end and `::` includes it, as they do everywhere else.
    //
    // The result is a `List[T]`, so unlike a pipe it can be indexed,
    // counted and iterated more than once, and it composes: a slice of a
    // slice is another slice of the same source.
    //
    // Source is `List[T]` rather than `Iterable[T]` - a slice needs to
    // index its source, not just walk it - so anything indexable can be
    // sliced: an array, a `LIST[T]`, an `ArraySegment[T]`, an immutable
    // collection, or another slice. An array is handed to `ArraySegment[T]`,
    // which is the same thing in the shape .NET already understands.

    /// The part of `source` from `r`'s start up to but not including its end. Nothing is copied,
    /// so a later change to `source` shows through.
    slice[T](source: T[], r: INT_RANGE) -> List[T] pure =>
        System.ArraySegment[T](source, r.from, r.to - r.from)

    /// The same as the `INT_RANGE` overload, with `r`'s end included.
    slice[T](source: T[], r: INT_RANGE_INCLUSIVE) -> List[T] pure =>
        System.ArraySegment[T](source, r.from, r.to - r.from + 1)

    /// The part of `source` from `r`'s start up to but not including its end. Nothing is copied,
    /// so a later change to `source` shows through, and the result can be sliced again.
    slice[T](source: List[T], r: INT_RANGE) -> List[T] pure =>
        LIST_SLICE[T](source, r.from, r.to - r.from)

    /// The same as the `INT_RANGE` overload, with `r`'s end included.
    slice[T](source: List[T], r: INT_RANGE_INCLUSIVE) -> List[T] pure =>
        LIST_SLICE[T](source, r.from, r.to - r.from + 1)

    // `string` is not a `List[char]`, so it takes its own overload, and
    // returns a string rather than a slice: a substring is what a caller
    // wants back, and .NET has no non-copying one to hand out.
    /// The substring of `source` from `r`'s start up to but not including its end.
    slice(source: string, r: INT_RANGE) -> string pure =>
        source.substring(r.from, r.to - r.from)

    /// The same as the `INT_RANGE` overload, with `r`'s end included.
    slice(source: string, r: INT_RANGE_INCLUSIVE) -> string pure =>
        source.substring(r.from, r.to - r.from + 1)

    // The from-the-end range operators (`a..<b`, `a..<<b`) carry a
    // `System.Range`, whose endpoints are only resolvable against a
    // length - which is here, where the source is known.

    /// The part of `source` that `r` selects, resolving `r`'s from-the-end
    /// endpoints against `source`'s length.
    slice[T](source: T[], r: System.Range) -> List[T] pure is
        let (offset, count) = r.get_offset_and_length(source.count)

        return System.ArraySegment[T](source, offset, count)
    si

    /// The part of `source` that `r` selects, resolving `r`'s from-the-end
    /// endpoints against `source`'s length.
    slice[T](source: List[T], r: System.Range) -> List[T] pure is
        let (offset, count) = r.get_offset_and_length(source.count)

        return LIST_SLICE[T](source, offset, count)
    si

    /// The substring of `source` that `r` selects, resolving `r`'s from-the-end
    /// endpoints against `source`'s length.
    slice(source: string, r: System.Range) -> string pure is
        let (offset, count) = r.get_offset_and_length(source.length)

        return source.substring(offset, count)
    si

    // Seeds: a chain has to start somewhere, and these start one without a
    // source to draw from. Each is unbounded unless given a count, so the
    // chain is bounded by a stage that stops pulling - `take`,
    // `take_while`, or a terminal that stops at the first match like
    // `find` or `first`. Collecting an unbounded one does not return.
    // `from` is bounded only by its type: it ends on the last value the
    // type holds rather than wrap round past it.

    // `start`, `start + step`, and so on. The step defaults to 1 and may
    // be negative; a step of 0 repeats `start`, which `repeat` says more
    // directly.
    /// A sequence counting up from `start` in steps of 1, ending at `int`'s largest value.
    from(start: int) -> Iterable[int] pure =>
        COUNT_PIPE(start, 1)

    /// A sequence counting from `start` in steps of `step`, which can be negative. Ends at the
    /// last value before one that would overflow `int`; a step of 0 never ends.
    from(start: int, step: int) -> Iterable[int] pure =>
        COUNT_PIPE(start, step)

    /// The same as `from`, over `long` values.
    from(start: long) -> Iterable[long] pure =>
        LONG_COUNT_PIPE(start, 1L)

    /// The same as `from`, over `long` values.
    from(start: long, step: long) -> Iterable[long] pure =>
        LONG_COUNT_PIPE(start, step)

    // `value`, without end.
    /// `value`, repeated without end.
    repeat[T](value: T) -> Iterable[T] pure =>
        REPEAT_PIPE[T](value, -1)

    // `value`, `count` times. A count of zero or less yields nothing.
    /// `value`, repeated `count` times. Yields no elements when `count` is zero or less.
    repeat[T](value: T, count: int) -> Iterable[T] pure =>
        REPEAT_PIPE[T](value, if count < 0 then 0 else count fi)
si
