<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>

    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <GhulOptions>--define ghul</GhulOptions>

    <!-- entry() in tests.ghul calls render() in render.ghul; with no
         namespace, that cross-file reference only resolves when the two
         files share one global namespace. -->
    <GhulGlobalNamespace>true</GhulGlobalNamespace>
  </PropertyGroup>

  <ItemGroup>
    <GhulSources Include="**/*.ghul" />
    <PackageReference Include="ghul.runtime" />

    <!-- should be passed on command line -->
    <GhulOptions Include="--define world" />
    <GhulOptions Include="--define hello" />
  </ItemGroup>

  <Import Project="../build/ghul.runtime.targets" />
</Project>
