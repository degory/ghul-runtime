// The from-the-end range operators and range indexing, compiled for the
// wasm target from the runtime's own sources, print what the same program
// prints on .NET.
use IO.Std.write_line
use Collections.LIST

entry() is
    let xs = [10, 20, 30, 40, 50]

    write_line("{xs[1..3]}")
    write_line("{xs[1..<1]}")
    write_line("{xs[1..<0]}")
    write_line("{xs[3..<<0]}")
    write_line("{xs[1::<2]}")
    write_line("{xs[3::<<1]}")

    let list = LIST[int](xs)

    write_line("{list[1..<1]}")
    write_line("{list[2..<<1]}")

    let word = "wasm target"

    write_line(word[0..<7])
    write_line(word[5..<0])
    write_line(word[6::<<1])
si
