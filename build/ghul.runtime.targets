<Project>
  <PropertyGroup>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

  <Target Name="CreateManifestResourceNames" />

  <!-- WriteLinesToFile treats its Lines items as file paths and, on
       non-Windows MSBuild, normalizes any backslash in them to a forward
       slash - fine for GenerateAssembliesJson's quoted paths below (Linux
       paths have no backslashes to mangle), fatal for JSON, whose escaped
       quotes (\") are exactly the sequences that normalization corrupts.
       GenerateGhulOptionsJson needs that escaping, so it writes through this
       plain File.WriteAllText task instead. -->
  <UsingTask TaskName="WriteTextFile" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <File ParameterType="System.String" Required="true" />
      <Text ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs">
        System.IO.File.WriteAllText(File, Text, new System.Text.UTF8Encoding(true));
      </Code>
    </Task>
  </UsingTask>

  <!-- The reference assemblies, already in the `-a "<path>"` spelling the
       compiler takes. Both the batch compile and the response file published
       for analysis clients need exactly this list, so it is computed once
       here rather than transformed separately in each. -->
  <Target Name="_ComputeGhulReferenceArguments" DependsOnTargets="FindReferenceAssembliesForReferences">
    <ItemGroup>
      <_GhulReferenceArgument Include="@(ReferencePathWithRefAssemblies -> '-a &quot;%(FullPath)&quot;')" />
    </ItemGroup>
  </Target>

  <!-- Superseded by GenerateGhulResponseFile. Kept so a client built against
       an earlier runtime keeps working; remove once ghul-vsce, ghul-mcp and
       the playground have all moved to the response file. -->
  <Target Name="GenerateAssembliesJson" DependsOnTargets="FindReferenceAssembliesForReferences">
    <ItemGroup>
      <QuotedAssemblies Include="@(ReferencePathWithRefAssemblies)">
        <Path>"$([MSBuild]::ValueOrDefault('%(FullPath)', '').Replace('\', '\\'))"</Path>
      </QuotedAssemblies>
    </ItemGroup>
    <PropertyGroup>
      <Assemblies>{"assemblies": [@(QuotedAssemblies -> '%(Path)', ',')]}</Assemblies>
    </PropertyGroup>

    <WriteLinesToFile File=".assemblies.json" Lines="$(Assemblies)" Overwrite="true" Encoding="Utf-8" />
    <Message Importance="Low" Text="Updated .assemblies.json with referenced assemblies" />
  </Target>

  <!-- Computes the compiler flags that come from typed MSBuild properties and
       items, fully resolved: conditions applied, properties evaluated. Shared
       between CoreCompile (which also needs sources/output/references to
       build) and GenerateGhulOptionsJson (which publishes just the flags, for
       clients that analyse the project instead of building it - see
       degory/ghul#2090). Kept as its own target, rather than inline in
       CoreCompile, so GenerateGhulOptionsJson can depend on it without
       depending on CoreCompile itself. -->
  <Target Name="_ComputeGhulCompilerOptions">
    <!-- The SDK defaults OutputType to Library, so it is never empty here;
         an explicitly emptied one is taken as the same default. -->
    <PropertyGroup>
      <_GhulOutputKind>$([MSBuild]::ValueOrDefault('$(OutputType)', 'library').ToLower())</_GhulOutputKind>
    </PropertyGroup>

    <Error Code="GHUL1003"
           Condition="'$(GhulLibrary)' != '' AND '$(GhulLibrary)' != 'true' AND '$(GhulLibrary)' != 'false'"
           Text="GhulLibrary must be true or false, but is '$(GhulLibrary)'." />

    <Error Code="GHUL1002"
           Condition="'$(GhulLibrary)' == '' AND '$(_GhulOutputKind)' != 'library' AND '$(_GhulOutputKind)' != 'exe' AND '$(_GhulOutputKind)' != 'winexe'"
           Text="OutputType '$(OutputType)' is not supported by the ghūl compiler. Use Library, Exe or WinExe, or set GhulLibrary to true or false to choose directly." />

    <Error Code="GHUL1004"
           Condition="'$(GhulUnderscoreAccess)' != '' AND '$(GhulUnderscoreAccess)' != 'private' AND '$(GhulUnderscoreAccess)' != 'protected' AND '$(GhulUnderscoreAccess)' != 'legacy'"
           Text="GhulUnderscoreAccess must be private, protected or legacy, but is '$(GhulUnderscoreAccess)'." />

    <PropertyGroup>
      <VersionParameter Condition="'$(Version)'!=''">--version "$(Version)"</VersionParameter>
      <TargetFrameworkParameter Condition="'$(TargetFramework)'!=''">--target-framework "$(TargetFramework)"</TargetFrameworkParameter>
      <DebugParameter Condition="'$(DebugType)' != '' AND '$(DebugType.ToLower())' != 'none' AND '$(DebugSymbols)' != 'false'">--debug</DebugParameter>
      <GlobalNamespaceParameter Condition="'$(GhulGlobalNamespace)' != '' AND '$(GhulGlobalNamespace.ToLower())' == 'true'">--global-namespace</GlobalNamespaceParameter>
      <GhulCompiler Condition="'$(GhulCompiler)'==''">dotnet ghul-compiler</GhulCompiler>
      <LibraryParameter Condition="'$(GhulLibrary)' == 'true' OR ('$(GhulLibrary)' == '' AND '$(_GhulOutputKind)' == 'library')">--library</LibraryParameter>
      <UnderscoreAccessParameter Condition="'$(GhulUnderscoreAccess)' != ''">--underscore-access $(GhulUnderscoreAccess)</UnderscoreAccessParameter>
      <NoWarnParameter Condition="'$(GhulNoWarn)' != ''">--suppress "$(GhulNoWarn.Replace(';', ','))"</NoWarnParameter>
      <WarnAsErrorParameter Condition="'$(GhulWarnAsError)' != ''">--warn-as-error "$(GhulWarnAsError.Replace(';', ','))"</WarnAsErrorParameter>
      <WarnAsHintParameter Condition="'$(GhulWarnAsHint)' != ''">--warn-as-hint "$(GhulWarnAsHint.Replace(';', ','))"</WarnAsHintParameter>
      <WarnAsInfoParameter Condition="'$(GhulWarnAsInfo)' != ''">--warn-as-info "$(GhulWarnAsInfo.Replace(';', ','))"</WarnAsInfoParameter>
      <_GhulResolvedOptions>$(VersionParameter) $(TargetFrameworkParameter) $(DebugParameter) $(LibraryParameter) $(GlobalNamespaceParameter) $(UnderscoreAccessParameter) $(NoWarnParameter) $(WarnAsErrorParameter) $(WarnAsHintParameter) $(WarnAsInfoParameter) $(GhulOptions) @(GhulOptions -> '%(Identity)', '%20')</_GhulResolvedOptions>
    </PropertyGroup>
  </Target>

  <!-- Publishes the flags _ComputeGhulCompilerOptions resolved, so a client
       that analyses the project (ghul-vsce, ghul-mcp) can read what the build
       actually compiles with instead of re-parsing the .ghulproj by hand -
       the two hand-written parsers cannot see a Condition on the item's
       enclosing ItemGroup, a property-form GhulOptions, or a $(...) reference
       inside one, and both drift from CoreCompile as a result. Sits beside
       GenerateAssembliesJson, invoked the same way
       (`dotnet build -t:GenerateGhulOptionsJson`), and is not otherwise wired
       into the default build - a consumer opts in the same way it opts in to
       GenerateAssembliesJson. Source files, the output path and reference
       assemblies are left out: a client already has GhulSources from the
       project's own items and reference assemblies from .assemblies.json. -->
  <!-- Superseded by GenerateGhulResponseFile, and kept on the same terms as
       GenerateAssembliesJson above. -->
  <Target Name="GenerateGhulOptionsJson" DependsOnTargets="_ComputeGhulCompilerOptions">
    <PropertyGroup>
      <_GhulOptionsJsonEscaped>$(_GhulResolvedOptions.Trim().Replace('\', '\\').Replace('"', '\"'))</_GhulOptionsJsonEscaped>
      <GhulOptionsJson>{"options": "$(_GhulOptionsJsonEscaped)"}</GhulOptionsJson>
    </PropertyGroup>

    <WriteTextFile File=".ghul-options.json" Text="$(GhulOptionsJson)" />
    <Message Importance="Low" Text="Updated .ghul-options.json with resolved compiler options" />
  </Target>

  <!-- Publishes everything a client needs to drive the compiler over this
       project - the resolved options and the reference assemblies - as a
       response file, in the same spelling the compiler takes on its command
       line. It replaces the two JSON targets above, which published the same
       two halves in a format nothing else speaks and every client had to
       hand-parse.

       A client can hand the file to the compiler as `@<path>` without reading
       it: a response file may reference another, so the client writes only
       its own flags and points at this one. A client that needs to inspect
       the contents splits on lines instead, which is what the JSON parse was
       doing the hard way.

       One argument per line, so that splitting on lines is enough and no
       consumer has to deal with quoting. The compiler treats a newline as
       argument whitespace exactly as it treats a space.

       Not wired into Build: a consumer opts in with
       `dotnet build -t:GenerateGhulResponseFile`, and passes
       GhulResponseFile to choose where it lands. The default is a fresh name
       in the system temporary directory, so that concurrent builds of
       different projects cannot collide. -->
  <Target Name="GenerateGhulResponseFile" DependsOnTargets="_ComputeGhulCompilerOptions;_ComputeGhulReferenceArguments">
    <PropertyGroup>
      <GhulResponseFile Condition="'$(GhulResponseFile)' == ''">$([System.IO.Path]::Combine($([System.IO.Path]::GetTempPath()), ghul-$([System.Guid]::NewGuid()).rsp))</GhulResponseFile>
      <_GhulResponseOptions>$(_GhulResolvedOptions.Trim())</_GhulResponseOptions>
    </PropertyGroup>

    <ItemGroup>
      <_GhulResponseLine Include="$(_GhulResponseOptions)" Condition="'$(_GhulResponseOptions)' != ''" />
      <_GhulResponseLine Include="@(_GhulReferenceArgument)" />
    </ItemGroup>

    <WriteLinesToFile File="$(GhulResponseFile)" Lines="@(_GhulResponseLine)" Overwrite="true" Encoding="Utf-8" />
    <Message Importance="Low" Text="Wrote $(GhulResponseFile) with the resolved compiler options and referenced assemblies" />
  </Target>

  <Target Name="CoreCompile" DependsOnTargets="_ComputeGhulCompilerOptions;_ComputeGhulReferenceArguments">
    <ItemGroup>
      <AssemblyInfo Include="System.Reflection.AssemblyInformationalVersionAttribute" Condition="'$(Version)'!=''">
        <Parameter>$(Version)</Parameter>
      </AssemblyInfo>
      <AssemblyInfo Include="System.Reflection.AssemblyCompanyAttribute" Condition="'$(Company)' != ''">
        <Parameter>$(Company)</Parameter>
      </AssemblyInfo>
      <AssemblyInfo Include="System.Reflection.AssemblyConfigurationAttribute" Condition="'$(Configuration)' != ''">
        <Parameter>$(Configuration)</Parameter>
      </AssemblyInfo>
      <AssemblyInfo Include="System.Reflection.AssemblyCopyrightAttribute" Condition="'$(Copyright)' != ''">
        <Parameter>$(Copyright)</Parameter>
      </AssemblyInfo>
      <AssemblyInfo Include="System.Reflection.AssemblyDescriptionAttribute" Condition="'$(Description)' != ''">
        <Parameter>$(Description)</Parameter>
      </AssemblyInfo>
      <AssemblyInfo Include="System.Reflection.AssemblyFileVersionAttribute" Condition="'$(FileVersion)' != ''">
        <Parameter>$(FileVersion)</Parameter>
      </AssemblyInfo>
      <AssemblyInfo Include="System.Reflection.AssemblyInformationalVersionAttribute" Condition="'$(InformationalVersion)' != ''">
        <Parameter>$(InformationalVersion)</Parameter>
      </AssemblyInfo>
      <AssemblyInfo Include="System.Reflection.AssemblyProductAttribute" Condition="'$(Product)' != ''">
        <Parameter>$(Product)</Parameter>
      </AssemblyInfo>
      <AssemblyInfo Include="System.Reflection.AssemblyTitleAttribute" Condition="'$(AssemblyTitle)' != ''">
        <Parameter>$(AssemblyTitle)</Parameter>
      </AssemblyInfo>
      <AssemblyInfo Include="System.Reflection.AssemblyVersionAttribute" Condition="'$(AssemblyVersion)' != ''">
        <Parameter>$(AssemblyVersion)</Parameter>
      </AssemblyInfo>
      <AssemblyInfo Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(RepositoryUrl)' != ''" >
        <Parameter>$(RepositoryUrl)</Parameter>
        <!-- TODO: common target supports multiple parameters here -->
      </AssemblyInfo>
      <AssemblyInfo Include="System.Resources.NeutralResourcesLanguageAttribute" Condition="'$(NeutralLanguage)' != ''">
        <Parameter>$(NeutralLanguage)</Parameter>
      </AssemblyInfo>
      <AssemblyInfo Include="System.Reflection.AssemblyCompanyAttribute" Condition="'$(Company)' != ''">
        <Parameter>$(Company)</Parameter>
      </AssemblyInfo>
    </ItemGroup>

    <!-- MSBuild only parses its canonical diagnostic shape
         (file(line,col,endLine,endCol): category code: text) - anything
         else it logs as untyped message text, so errors surface as an
         MSB3073 attributed to this targets file and warnings are never
         counted. The flag is kept out of _GhulResolvedOptions on purpose:
         it says how this Exec reports to MSBuild, not how the project
         compiles, and GenerateGhulOptionsJson publishes those options to
         analysis clients. -->
    <!-- A fresh name in the system temporary directory, so that builds of
         different projects running at once cannot collide on it, and so that
         one left behind by a killed build is somewhere the system reclaims
         rather than in the source tree. Concurrent builds of the same project
         are not supported and this does not attempt to make them so. -->
    <PropertyGroup>
      <_GhulBuildResponseFile>$([System.IO.Path]::Combine($([System.IO.Path]::GetTempPath()), ghul-build-$([System.Guid]::NewGuid()).rsp))</_GhulBuildResponseFile>
      <CommandLine>$(_GhulResolvedOptions) @(AssemblyInfo -> '--assembly-info-string "%(Identity)=%(Parameter)"', '%20') --v3 --msbuild-diagnostics @(GhulSources -> '"%(fullpath)"', '%20') -o "$(IntermediateOutputPath)$(AssemblyName).dll" @(_GhulReferenceArgument, '%20')</CommandLine>
    </PropertyGroup>

    <Message Importance="Low" Text="$(GhulCompiler) $(CommandLine)" />

    <WriteLinesToFile File="$(_GhulBuildResponseFile)" Lines="$(CommandLine)" Overwrite="true" Encoding="Utf-8" />
    <Exec Command="$(GhulCompiler) @&quot;$(_GhulBuildResponseFile)&quot;" />
    <Delete Files="$(_GhulBuildResponseFile)" />

    <!-- Exec stops the target on a failed compile, so the Delete above only
         covers the success path. Without this the response file of every
         failed build is left behind. -->
    <OnError ExecuteTargets="_DeleteGhulBuildResponseFile" />
  </Target>

  <Target Name="_DeleteGhulBuildResponseFile">
    <Delete Files="$(_GhulBuildResponseFile)" />
  </Target>
</Project>