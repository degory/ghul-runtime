namespace Tests is
    use Ghul

    use Collections
    use NSubstitute

    use NSubstitute.SubstituteExtensions.returns
    use NSubstitute.SubstituteExtensions.received

    use Microsoft.VisualStudio.TestTools.UnitTesting

    use Ghul.Pipes
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute

    @TestClass()
    class FlatMapPipeShould is
        init() is
        si

        @Test()
        FlatMap_EmptyArray_ReturnsEmptySequence() is
            let pipe =
                empty`[int]()

            let result =
                pipe
                    |> flat_map(i => i.to_string())

            assert_are_equal(empty`[char](), result)
        si

        @Test()
        FlatMap_IntsToStrings_ReturnsExpectedSequence() is
            let pipe =
                [3, 4, 1, 5, 2, 3, 1, 4, 5]

            let result =
                pipe
                    |> flat_map(i => i.to_string())

            assert_are_equal(['3', '4', '1', '5', '2', '3', '1', '4', '5'], result)
        si

        @Test()
        FlatMap_ArraysIdentity_ReturnsConcatArrays() is
            let pipe =
                [[1, 2, 3], [4, 5, 6], [7, 8, 9]]

            let result =
                pipe
                    |> flat_map(a => a)

            assert_are_equal([1, 2, 3, 4, 5, 6, 7, 8, 9], result)
        si
        @Test()
        FlatMap_StoppedPartWay_NextReadStartsFromTheBeginning() is
            let result =
                [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
                    |> flat_map(a => a)

            let iterator = result.iterator

            iterator.move_next()
            iterator.move_next()
            iterator.move_next()
            iterator.move_next()

            assert_are_equal([1, 2, 3, 4, 5, 6, 7, 8, 9], result)
        si

        @Test()
        FlatMap_ReadToTheEnd_PlaysAgain() is
            let result =
                [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
                    |> flat_map(a => a)

            are_equal(9, result |> count())

            assert_are_equal([1, 2, 3, 4, 5, 6, 7, 8, 9], result)
        si
    si
si
