namespace Tests is

    use Collections
    use NSubstitute

    use NSubstitute.SubstituteExtensions.returns
    use NSubstitute.SubstituteExtensions.received

    use Microsoft.VisualStudio.TestTools.UnitTesting

    use Ghul.Pipes
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute

    @TestClass()
    class FlatMapPipeShould is
        init() is
        si

        @Test()
        FlatMap_EmptyArray_ReturnsEmptySequence() is
            let pipe =
                Ghul.Pipes.Factory.from`[int](empty`[int]())

            let result =
                pipe
                    .flat_map(i => i.to_string())

            assert_are_equal(empty`[char](), result)
        si

        @Test()
        FlatMap_IntsToStrings_ReturnsExpectedSequence() is
            let pipe =
                Ghul.Pipes.Factory.from`[int]([3, 4, 1, 5, 2, 3, 1, 4, 5])

            let result =
                pipe
                    .flat_map(i => i.to_string())

            assert_are_equal(['3', '4', '1', '5', '2', '3', '1', '4', '5'], result)
        si

        @Test()
        FlatMap_ArraysIdentity_ReturnsConcatArrays() is
            let pipe =
                Ghul.Pipes.Factory.from`[int[]]([[1, 2, 3], [4, 5, 6], [7, 8, 9]])

            let result =
                pipe
                    .flat_map(a => a)

            assert_are_equal([1, 2, 3, 4, 5, 6, 7, 8, 9], result)
        si

        @Test()
        FlatMap_ResetBeforeIteration_HasNoEffect() is
            let pipe =
                Ghul.Pipes.Factory.from`[int[]]([[1, 2, 3], [4, 5, 6], [7, 8, 9]])

            let result =
                pipe
                    .flat_map(a => a)

            result.reset()

            assert_are_equal([1, 2, 3, 4, 5, 6, 7, 8, 9], result)
        si

        @Test()
        FlatMap_ResetAfterIncompleteIteration_StartsAgainFromBeginning() is
            let pipe =
                Ghul.Pipes.Factory.from`[int[]]([[1, 2, 3], [4, 5, 6], [7, 8, 9]])

            let result =
                pipe
                    .flat_map(a => a)

            result.move_next()
            result.move_next()
            result.move_next()
            result.move_next()

            result.reset()

            assert_are_equal([1, 2, 3, 4, 5, 6, 7, 8, 9], result)
        si

        @Test()
        FlatMap_CompleteIteration_ResetsPipe() is
            let pipe =
                Ghul.Pipes.Factory.from`[int[]]([[1, 2, 3], [4, 5, 6], [7, 8, 9]])

            let result =
                pipe
                    .flat_map(a => a)

            // count consumes the whole pipe and then resets it:
            let count = result.count()

            assert_are_equal([1, 2, 3, 4, 5, 6, 7, 8, 9], result)
        si


        @Test()
        FlatMap_ResetAfterIteration_HasNoEffect() is
            let pipe =
                Ghul.Pipes.Factory.from`[int[]]([[1, 2, 3], [4, 5, 6], [7, 8, 9]])

            let result =
                pipe
                    .flat_map(a => a)

            // count consumes the whole pipe and then resets it:
            let count = result.count()

            // this reset is a no-op:
            result.reset()

            assert_are_equal([1, 2, 3, 4, 5, 6, 7, 8, 9], result)
        si
    si
si
