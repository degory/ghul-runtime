namespace Tests is
    use Microsoft.VisualStudio.TestTools.UnitTesting;
    use Ghul.Async;

    class LoopResultShould is
        @test()
        init() is
        si

        DefaultInit_ProducesContinueWithZeroValue() is
            @test()

            let r = _LOOP_RESULT[int]();

            Assert.are_equal(_LOOP_RESULT_TYPE.CONTINUE, r.type);
            Assert.are_equal(0, r.value);
        si

        ExplicitInit_PreservesTypeAndValue() is
            @test()

            let r = _LOOP_RESULT[int](_LOOP_RESULT_TYPE.RETURN, 42);

            Assert.are_equal(_LOOP_RESULT_TYPE.RETURN, r.type);
            Assert.are_equal(42, r.value);
        si

        VoidVariant_DefaultInit_ProducesContinue() is
            @test()

            let r = _LOOP_RESULT();

            Assert.are_equal(_LOOP_RESULT_TYPE.CONTINUE, r.type);
        si

        VoidVariant_ExplicitInit_PreservesType() is
            @test()

            let r = _LOOP_RESULT(_LOOP_RESULT_TYPE.BREAK);

            Assert.are_equal(_LOOP_RESULT_TYPE.BREAK, r.type);
        si
    si

    class ForEachAsyncShould is
        @test()
        init() is
        si

        IterateAllElements_WhenBodyReturnsContinue() is
            @test()

            let counter mut = 0;
            let xs: Collections.List[int] = [10, 20, 30];

            let task =
                _for_each_async[int, int](
                    xs.iterator,
                    x is
                        counter = counter + 1;
                        return Tasks.TASK.from_result(_LOOP_RESULT[int]());
                    si
                );

            let r = task.result;
            Assert.are_equal(_LOOP_RESULT_TYPE.CONTINUE, r.type);
            Assert.are_equal(3, counter);
        si

        StopEarly_WhenBodyReturnsReturn() is
            @test()

            let counter mut = 0;
            let xs: Collections.List[int] = [10, 20, 30];

            let task =
                _for_each_async[int, int](
                    xs.iterator,
                    x is
                        counter = counter + 1;
                        if x == 20 then
                            return Tasks.TASK.from_result(_LOOP_RESULT[int](_LOOP_RESULT_TYPE.RETURN, x * 100));
                        fi
                        return Tasks.TASK.from_result(_LOOP_RESULT[int]());
                    si
                );

            let r = task.result;
            Assert.are_equal(_LOOP_RESULT_TYPE.RETURN, r.type);
            Assert.are_equal(2000, r.value);
            // counter==2: ran x=10 (CONTINUE), x=20 (RETURN). x=30 skipped.
            Assert.are_equal(2, counter);
        si

        PropagateException_WhenBodyThrows() is
            @test()

            let xs: Collections.List[int] = [1, 2, 3];

            let task =
                _for_each_async[int, int](
                    xs.iterator,
                    x is
                        if x == 2 then
                            throw System.InvalidOperationException("boom on x=2");
                        fi
                        return Tasks.TASK.from_result(_LOOP_RESULT[int]());
                    si
                );

            // .result throws AggregateException wrapping the body's exception
            try
                let _ = task.result;
                Assert.fail("expected exception");
            catch ae: System.AggregateException
                Assert.is_true(ae.inner_exception != null);
                // exact message text varies by .NET version; just check
                // the inner exception type chain reaches the original
            yrt
        si
    si

    class COUNTER is
        count: int public;
        init() is count = 0; si
        bump() is count = count + 1; si
    si

    class WhileAsyncShould is
        @test()
        init() is
        si

        RunBody_WhileConditionTrue() is
            @test()

            let counter = COUNTER();

            let task =
                _while_async[int](
                    () -> Tasks.TASK[bool] => Tasks.TASK.from_result(counter.count < 3),
                    () -> Tasks.TASK[_LOOP_RESULT[int]] is
                        counter.bump();
                        return Tasks.TASK.from_result(_LOOP_RESULT[int]());
                    si
                );

            let r = task.result;
            Assert.are_equal(_LOOP_RESULT_TYPE.CONTINUE, r.type);
            Assert.are_equal(3, counter.count);
        si

        SkipBody_WhenConditionFalseInitially() is
            @test()

            let body_calls = COUNTER();

            let task =
                _while_async[int](
                    () -> Tasks.TASK[bool] => Tasks.TASK.from_result(false),
                    () -> Tasks.TASK[_LOOP_RESULT[int]] is
                        body_calls.bump();
                        return Tasks.TASK.from_result(_LOOP_RESULT[int]());
                    si
                );

            let r = task.result;
            Assert.are_equal(_LOOP_RESULT_TYPE.CONTINUE, r.type);
            Assert.are_equal(0, body_calls.count);
        si
    si
si
