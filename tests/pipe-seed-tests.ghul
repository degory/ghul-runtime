namespace Tests is
    use Ghul
    use Collections

    use Microsoft.VisualStudio.TestTools.UnitTesting

    use Ghul.Pipes
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute

    // The seeds are unbounded, so every test bounds what it pulls.
    @TestClass()
    class PipeSeedsShould is
        init() is
        si

        @Test()
        From_WithNoStep_CountsUpByOne() is
            assert_are_equal([1, 2, 3, 4, 5], from(1) |> take(5))
        si

        @Test()
        From_WithAStep_AdvancesByIt() is
            assert_are_equal([10, 15, 20, 25], from(10, 5) |> take(4))
        si

        @Test()
        From_WithANegativeStep_CountsDown() is
            assert_are_equal([0, -2, -4, -6], from(0, -2) |> take(4))
        si

        @Test()
        From_OverLong_CountsUpByOne() is
            assert_are_equal([1L, 2L, 3L], from(1L) |> take(3))
        si

        @Test()
        From_OverLongWithAStep_AdvancesByIt() is
            assert_are_equal([100L, 90L, 80L], from(100L, -10L) |> take(3))
        si

        // A counter ends on the last value its type holds, rather than
        // wrap round to the far end of the range and keep going.
        @Test()
        From_ReachingIntMaximum_EndsThere() is
            assert_are_equal([2147483645, 2147483646, 2147483647], from(2147483645))
        si

        @Test()
        From_WithAStepThatWouldPassIntMaximum_EndsBeforeIt() is
            assert_are_equal([2147483638, 2147483643], from(2147483638, 5))
        si

        @Test()
        From_WithANegativeStepReachingIntMinimum_EndsThere() is
            let minimum = -2147483647 - 1

            assert_are_equal([minimum + 2, minimum + 1, minimum], from(minimum + 2, -1))
        si

        @Test()
        From_OverLongReachingLongMaximum_EndsThere() is
            assert_are_equal([9223372036854775806L, 9223372036854775807L], from(9223372036854775806L))
        si

        @Test()
        From_OverLongWithANegativeStepThatWouldPassLongMinimum_EndsBeforeIt() is
            let minimum = -9223372036854775807L - 1L

            assert_are_equal([minimum + 3L], from(minimum + 3L, -4L))
        si

        // Filtering an unbounded counter down to fewer matches than are
        // asked for still finishes, once the counter reaches its limit.
        @Test()
        From_FilteredToFewerMatchesThanTaken_EndsAtTheLimit() is
            assert_are_equal([2147483640, 2147483641, 2147483642], from(2147483640) |> filter(n => n < 2147483643) |> take(20))
        si

        @Test()
        From_WithAStepOfZero_NeverEnds() is
            assert_are_equal([3, 3, 3, 3], from(3, 0) |> take(4))
        si

        @Test()
        From_ReachingItsLimit_ReadTwice_YieldsTheSameElements() is
            let counting = from(2147483646)

            assert_are_equal([2147483646, 2147483647], counting)
            assert_are_equal([2147483646, 2147483647], counting)
        si

        // What a seed is for: search an unbounded sequence and stop at the
        // first answer, rather than build a range large enough to hold it.
        @Test()
        From_FilteredToAFirstMatch_StopsThere() is
            are_equal(MAYBE(9), from(2) |> filter(n => n % 9 == 0) |> first())
        si

        @Test()
        From_ReadTwice_StartsOverEachTime() is
            let counting = from(1)

            assert_are_equal([1, 2, 3], counting |> take(3))
            assert_are_equal([1, 2, 3], counting |> take(3))
        si

        @Test()
        Repeat_Unbounded_YieldsTheValueForever() is
            assert_are_equal([7, 7, 7, 7], repeat(7) |> take(4))
        si

        @Test()
        Repeat_WithACount_YieldsThatMany() is
            assert_are_equal(["x", "x", "x"], repeat("x", 3))
        si

        @Test()
        Repeat_WithACountOfZero_YieldsNothing() is
            are_equal(0, repeat("x", 0) |> count())
        si

        @Test()
        Repeat_WithANegativeCount_YieldsNothing() is
            are_equal(0, repeat("x", -1) |> count())
        si

        // A counted repeat exhausts, and a pipe resets itself when it
        // does, so reading one twice reads the same elements.
        @Test()
        Repeat_Counted_ReadTwice_YieldsTheSameElements() is
            let three = repeat("x", 3)

            are_equal(3, three |> count())
            are_equal(3, three |> count())
        si
    si
si
