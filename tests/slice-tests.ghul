namespace Tests is
    use Collections

    use Microsoft.VisualStudio.TestTools.UnitTesting

    use Ghul.Pipes
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute

    // A slice is a List[T] rather than a Pipe[T], so it needs its own
    // element comparison alongside the Pipe one the other test files use.
    assert_elements[T](expected: Iterable[T], actual: Iterable[T]) is
        let expected_elements = LIST[T]()
        let actual_elements = LIST[T]()

        expected_elements.add_range(expected)
        actual_elements.add_range(actual)

        CollectionAssert.are_equal(expected_elements, actual_elements)
    si

    // Coverage for `slice`: which overload each source type reaches, that a
    // slice is a view rather than a copy, and that the slice's bounds are
    // enforced where it is taken.
    @TestClass()
    class SliceShould is
        init() is
        si

        @Test()
        Array_ExclusiveRange_ReturnsTheSlice() is
            assert_elements([2, 3, 4], [1, 2, 3, 4, 5] |> slice(1..4))
        si

        @Test()
        Array_InclusiveRange_IncludesTheEnd() is
            assert_elements([2, 3, 4], [1, 2, 3, 4, 5] |> slice(1::3))
        si

        @Test()
        Array_ReachesTheArraySegmentOverload() is
            let result = [1, 2, 3, 4, 5] |> slice(1..4)

            is_true(isa System.ArraySegment[int](result))
        si

        @Test()
        List_ExclusiveRange_ReturnsTheSlice() is
            assert_elements([2, 3, 4], LIST[int]([1, 2, 3, 4, 5]) |> slice(1..4))
        si

        @Test()
        List_InclusiveRange_IncludesTheEnd() is
            assert_elements([2, 3, 4], LIST[int]([1, 2, 3, 4, 5]) |> slice(1::3))
        si

        @Test()
        List_ReachesTheListSliceOverload() is
            let result = LIST[int]([1, 2, 3, 4, 5]) |> slice(1..4)

            is_true(isa LIST_SLICE[int](result))
        si

        @Test()
        ReadOnlyList_ReachesTheListSliceOverload() is
            let source: List[int] = LIST[int]([1, 2, 3, 4, 5])

            let result = source |> slice(1..4)

            is_true(isa LIST_SLICE[int](result))
        si

        @Test()
        String_ExclusiveRange_ReturnsTheSubstring() is
            are_equal("hello", "hello world" |> slice(0..5))
        si

        @Test()
        String_InclusiveRange_IncludesTheEnd() is
            are_equal("hello", "hello world" |> slice(0::4))
        si

        @Test()
        Slice_IsIndexableAndCounted() is
            let result = LIST[int]([1, 2, 3, 4, 5]) |> slice(1..4)

            are_equal(3, result.count)
            are_equal(2, result[0])
            are_equal(4, result[2])
        si

        @Test()
        Slice_IteratesMoreThanOnce() is
            let result = LIST[int]([1, 2, 3, 4, 5]) |> slice(1..4)

            assert_elements([2, 3, 4], result)
            assert_elements([2, 3, 4], result)
        si

        @Test()
        Slice_OfASlice_SlicesTheSameSource() is
            let outer = LIST[int]([1, 2, 3, 4, 5]) |> slice(1..5)

            assert_elements([3, 4], outer |> slice(1..3))
        si

        @Test()
        Slice_OfAnArraySlice_SlicesTheSameSource() is
            let outer = [1, 2, 3, 4, 5] |> slice(1..5)

            assert_elements([3, 4], outer |> slice(1..3))
        si

        @Test()
        Slice_OfAMutableSource_SeesALaterChange() is
            let source = LIST[int]([1, 2, 3, 4, 5])

            let result = source |> slice(1..4)

            source[2] = 30

            assert_elements([2, 30, 4], result)
        si

        @Test()
        EmptyRange_ReturnsAnEmptySlice() is
            let result = LIST[int]([1, 2, 3]) |> slice(1..1)

            are_equal(0, result.count)
            assert_elements(LIST[int](), result)
        si

        @Test()
        WholeRange_ReturnsEveryElement() is
            assert_elements([1, 2, 3], LIST[int]([1, 2, 3]) |> slice(0..3))
        si

        @Test()
        RangePastTheEnd_ThrowsWhereTheSliceIsTaken() is
            let source = LIST[int]([1, 2, 3])

            try
                source |> slice(1..5)

                fail("should have thrown")
            catch ex: System.ArgumentOutOfRangeException
            yrt
        si

        @Test()
        NegativeStart_ThrowsWhereTheSliceIsTaken() is
            let source = LIST[int]([1, 2, 3])

            try
                source |> slice(-1..2)

                fail("should have thrown")
            catch ex: System.ArgumentOutOfRangeException
            yrt
        si

        @Test()
        IndexPastTheSlice_Throws() is
            let result = LIST[int]([1, 2, 3, 4, 5]) |> slice(1..4)

            try
                result[3]

                fail("should have thrown")
            catch ex: System.ArgumentOutOfRangeException
            yrt
        si

        @Test()
        Slice_ComposesWithThePipeCombinators() is
            let result = LIST[int]([1, 2, 3, 4, 5]) |> slice(1..4) |> map(i => i * 10)

            assert_are_equal([20, 30, 40], result)
        si
    si
si
