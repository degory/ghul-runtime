namespace Tests is
    use Microsoft.VisualStudio.TestTools.UnitTesting;
    use Ghul.Generators;

    class GenStepShould is
        @test()
        init() is si

        DefaultInit_ProducesDoneWithZeroPayload() is
            @test()

            let s = _GEN_STEP[int]();

            Assert.are_equal(_GEN_STEP_KIND.DONE, s.kind);
            Assert.are_equal(0, s.value);
            Assert.are_equal(0, s.next_state);
        si

        ExplicitInit_PreservesKindValueAndNextState() is
            @test()

            let s = _GEN_STEP[int](_GEN_STEP_KIND.YIELD, 42, 7);

            Assert.are_equal(_GEN_STEP_KIND.YIELD, s.kind);
            Assert.are_equal(42, s.value);
            Assert.are_equal(7, s.next_state);
        si
    si

    class GenDriverShould is
        @test()
        init() is si

        EmptyGenerator_YieldsNothing() is
            @test()

            let states = Collections.LIST[() -> _GEN_STEP[int]]();
            states.add(() -> _GEN_STEP[int] => _GEN_STEP[int]());

            let driver = _GEN_DRIVER[int](states);
            Assert.is_false(driver.move_next());
        si

        LinearYields_VisitedInOrder() is
            @test()

            let states = Collections.LIST[() -> _GEN_STEP[int]]();
            states.add(() -> _GEN_STEP[int] => _GEN_STEP[int](_GEN_STEP_KIND.YIELD, 10, 1));
            states.add(() -> _GEN_STEP[int] => _GEN_STEP[int](_GEN_STEP_KIND.YIELD, 20, 2));
            states.add(() -> _GEN_STEP[int] => _GEN_STEP[int](_GEN_STEP_KIND.YIELD, 30, 3));
            states.add(() -> _GEN_STEP[int] => _GEN_STEP[int]());

            let driver = _GEN_DRIVER[int](states);
            let total mut = 0;
            while driver.move_next() do
                total = total + driver.current;
            od
            Assert.are_equal(60, total);
        si

        Transition_AdvancesWithoutEmitting() is
            @test()

            // state 0 transitions to state 1 (no emit)
            // state 1 yields 99 and transitions to state 2 (DONE)
            // The driver loops inside one move_next from state 0
            // through state 1 to surface the YIELD.
            let states = Collections.LIST[() -> _GEN_STEP[int]]();
            states.add(() -> _GEN_STEP[int] => _GEN_STEP[int](_GEN_STEP_KIND.TRANSITION, 0, 1));
            states.add(() -> _GEN_STEP[int] => _GEN_STEP[int](_GEN_STEP_KIND.YIELD, 99, 2));
            states.add(() -> _GEN_STEP[int] => _GEN_STEP[int]());

            let driver = _GEN_DRIVER[int](states);
            Assert.is_true(driver.move_next());
            Assert.are_equal(99, driver.current);
            Assert.is_false(driver.move_next());
        si

        Reset_ReplaysFromStartState() is
            @test()

            let states = Collections.LIST[() -> _GEN_STEP[int]]();
            states.add(() -> _GEN_STEP[int] => _GEN_STEP[int](_GEN_STEP_KIND.YIELD, 1, 1));
            states.add(() -> _GEN_STEP[int] => _GEN_STEP[int](_GEN_STEP_KIND.YIELD, 2, 2));
            states.add(() -> _GEN_STEP[int] => _GEN_STEP[int]());

            let driver = _GEN_DRIVER[int](states);
            Assert.is_true(driver.move_next());
            Assert.is_true(driver.move_next());
            Assert.is_false(driver.move_next());

            driver.reset();
            Assert.is_true(driver.move_next());
            Assert.are_equal(1, driver.current);
        si

        Iterator_ReturnsSelf() is
            @test()

            let states = Collections.LIST[() -> _GEN_STEP[int]]();
            states.add(() -> _GEN_STEP[int] => _GEN_STEP[int]());

            let driver = _GEN_DRIVER[int](states);
            Assert.are_same(driver, driver.iterator);
        si
    si

    class GenPipeShould is
        @test()
        init() is si

        WrapsStatesIntoIterable() is
            @test()

            let states = Collections.LIST[() -> _GEN_STEP[int]]();
            states.add(() -> _GEN_STEP[int] => _GEN_STEP[int](_GEN_STEP_KIND.YIELD, 7, 1));
            states.add(() -> _GEN_STEP[int] => _GEN_STEP[int]());

            let total mut = 0;
            for x in _gen_pipe(states) do
                total = total + x;
            od
            Assert.are_equal(7, total);
        si
    si
si
