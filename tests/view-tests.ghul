namespace Tests is
    use Collections;

    use Microsoft.VisualStudio.TestTools.UnitTesting;

    use Ghul.Pipes;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;

    // A view is a List[T] rather than a Pipe[T], so it needs its own
    // element comparison alongside the Pipe one the other test files use.
    assert_elements[T](expected: Iterable[T], actual: Iterable[T]) is
        let expected_elements = LIST[T]();
        let actual_elements = LIST[T]();

        expected_elements.add_range(expected);
        actual_elements.add_range(actual);

        CollectionAssert.are_equal(expected_elements, actual_elements);
    si

    // Coverage for `view`: which overload each source type reaches, that a
    // view is a window rather than a copy, and that the window's bounds are
    // enforced where it is taken.
    @TestClass()
    class ViewShould is
        init() is
        si

        @Test()
        Array_ExclusiveRange_ReturnsTheWindow() is
            assert_elements([2, 3, 4], [1, 2, 3, 4, 5] |> view(1..4));
        si

        @Test()
        Array_InclusiveRange_IncludesTheEnd() is
            assert_elements([2, 3, 4], [1, 2, 3, 4, 5] |> view(1::3));
        si

        @Test()
        Array_ReachesTheArraySegmentOverload() is
            let result = [1, 2, 3, 4, 5] |> view(1..4);

            is_true(isa System.ArraySegment[int](result));
        si

        @Test()
        List_ExclusiveRange_ReturnsTheWindow() is
            assert_elements([2, 3, 4], LIST[int]([1, 2, 3, 4, 5]) |> view(1..4));
        si

        @Test()
        List_InclusiveRange_IncludesTheEnd() is
            assert_elements([2, 3, 4], LIST[int]([1, 2, 3, 4, 5]) |> view(1::3));
        si

        @Test()
        List_ReachesTheListViewOverload() is
            let result = LIST[int]([1, 2, 3, 4, 5]) |> view(1..4);

            is_true(isa LIST_VIEW[int](result));
        si

        @Test()
        ReadOnlyList_ReachesTheListViewOverload() is
            let source: List[int] = LIST[int]([1, 2, 3, 4, 5]);

            let result = source |> view(1..4);

            is_true(isa LIST_VIEW[int](result));
        si

        @Test()
        String_ExclusiveRange_ReturnsTheSubstring() is
            are_equal("hello", "hello world" |> view(0..5));
        si

        @Test()
        String_InclusiveRange_IncludesTheEnd() is
            are_equal("hello", "hello world" |> view(0::4));
        si

        @Test()
        View_IsIndexableAndCounted() is
            let result = LIST[int]([1, 2, 3, 4, 5]) |> view(1..4);

            are_equal(3, result.count);
            are_equal(2, result[0]);
            are_equal(4, result[2]);
        si

        @Test()
        View_IteratesMoreThanOnce() is
            let result = LIST[int]([1, 2, 3, 4, 5]) |> view(1..4);

            assert_elements([2, 3, 4], result);
            assert_elements([2, 3, 4], result);
        si

        @Test()
        View_OfAView_WindowsTheSameSource() is
            let outer = LIST[int]([1, 2, 3, 4, 5]) |> view(1..5);

            assert_elements([3, 4], outer |> view(1..3));
        si

        @Test()
        View_OfAnArrayView_WindowsTheSameSource() is
            let outer = [1, 2, 3, 4, 5] |> view(1..5);

            assert_elements([3, 4], outer |> view(1..3));
        si

        @Test()
        View_OfAMutableSource_SeesALaterChange() is
            let source = LIST[int]([1, 2, 3, 4, 5]);

            let result = source |> view(1..4);

            source[2] = 30;

            assert_elements([2, 30, 4], result);
        si

        @Test()
        EmptyRange_ReturnsAnEmptyView() is
            let result = LIST[int]([1, 2, 3]) |> view(1..1);

            are_equal(0, result.count);
            assert_elements(LIST[int](), result);
        si

        @Test()
        WholeRange_ReturnsEveryElement() is
            assert_elements([1, 2, 3], LIST[int]([1, 2, 3]) |> view(0..3));
        si

        @Test()
        RangePastTheEnd_ThrowsWhereTheViewIsTaken() is
            let source = LIST[int]([1, 2, 3]);

            try
                source |> view(1..5);

                fail("should have thrown");
            catch ex: System.ArgumentOutOfRangeException
            yrt
        si

        @Test()
        NegativeStart_ThrowsWhereTheViewIsTaken() is
            let source = LIST[int]([1, 2, 3]);

            try
                source |> view(-1..2);

                fail("should have thrown");
            catch ex: System.ArgumentOutOfRangeException
            yrt
        si

        @Test()
        IndexPastTheWindow_Throws() is
            let result = LIST[int]([1, 2, 3, 4, 5]) |> view(1..4);

            try
                result[3];

                fail("should have thrown");
            catch ex: System.ArgumentOutOfRangeException
            yrt
        si

        @Test()
        View_ComposesWithThePipeCombinators() is
            let result = LIST[int]([1, 2, 3, 4, 5]) |> view(1..4) |> map(i => i * 10);

            assert_are_equal([20, 30, 40], result);
        si
    si
si
