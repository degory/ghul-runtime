namespace Tests is
    use Ghul
    use Collections

    use Microsoft.VisualStudio.TestTools.UnitTesting

    use Ghul.Pipes
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute

    drain[T](pipe: Iterable[T]) -> LIST[T] is
        let elements = LIST[T]()

        for element in pipe do
            elements.add(element)
        od

        return elements
    si

    // A source that counts how many elements it has handed out, so a test
    // can tell a replay of the cache from a second pass over the source.
    class COUNTING_SOURCE[T]: Pipe[T] is
        values: T[]
        handed_out: int public

        init(values: T[]) is
            self.values = values
            handed_out = 0
        si

        _at: int

        iterator: Iterator[T] => self

        current: T => values[_at - 1]

        move_next() -> bool is
            if _at < values.count then
                _at = _at + 1
                handed_out = handed_out + 1
                return true
            fi

            _at = 0
            return false
        si

        reset() is
            _at = 0
        si

        dispose() is
        si
    si

    // Coverage for `memo`: the first read caches, later reads replay the
    // cache without asking the source again, a read that runs past the
    // cached prefix extends it, and infinite sources stay lazy.
    @TestClass()
    class MEMO_PIPEShould is
        init() is
        si

        @Test()
        Read_ReplaysCachedElementsWithoutRereadingSource() is
            let source = COUNTING_SOURCE[int]([1, 2, 3])
            let p = memo(source)

            assert_elements([1, 2, 3], drain(p))
            are_equal(3, source.handed_out)

            assert_elements([1, 2, 3], drain(p))
            assert_elements([1, 2, 3], drain(p))
            are_equal(3, source.handed_out)
        si

        @Test()
        Read_EmptySource_YieldsNothingOnEveryRead() is
            let empty: int[] = []
            let p = memo(COUNTING_SOURCE[int](empty))

            is_false(p.iterator.move_next())
            is_false(p.iterator.move_next())
        si

        @Test()
        Read_PartialRead_ExtendsCacheWhenALaterReadRunsFurther() is
            let source = COUNTING_SOURCE[string](["a", "b", "c", "d"])
            let p = memo(source)

            let part_read = p.iterator

            is_true(part_read.move_next())
            are_equal("a", part_read.current)
            is_true(part_read.move_next())
            are_equal("b", part_read.current)
            are_equal(2, source.handed_out)

            // The next read starts from the beginning, replays the two
            // cached elements and pulls only the remaining two.
            assert_elements(["a", "b", "c", "d"], drain(p))
            are_equal(4, source.handed_out)

            // The part_read read carries on from the shared cache.
            is_true(part_read.move_next())
            are_equal("c", part_read.current)
            are_equal(4, source.handed_out)
        si

        @Test()
        Join_Twice_ProducesTheSameElementsAndReadsSourceOnce() is
            let source = COUNTING_SOURCE[int]([1, 2, 3])
            let p = memo(source)

            are_equal("1, 2, 3", p |> join(", "))
            are_equal("1, 2, 3", p |> join(", "))
            are_equal(3, source.handed_out)
        si

        @Test()
        PartialRead_LeavesTheSharedSourceOpenForLaterReads() is
            let source = DISPOSAL_SOURCE([1, 2, 3])
            let p = memo(source)

            are_equal("1", p |> take(1) |> join(", "))
            are_equal(0, source.disposed)

            are_equal("1, 2, 3", p |> join(", "))
            are_equal(1, source.disposed)

            are_equal("1, 2, 3", p |> join(", "))
            are_equal(1, source.disposed)
        si

        @Test()
        Memo_OverInfiniteStream_PullsOnlyWhatIsConsumed() is
            let naturals = stream(0, n => n || n + 1)
            let p = memo(naturals)

            are_equal("0, 1, 2", p |> take(3) |> join(", "))

            // A later read that runs past the cached three elements asks
            // the stream for more.
            are_equal("0, 1, 2, 3", p |> take(4) |> join(", "))
        si
    si
si
