namespace Tests is
    use Collections
    use NSubstitute

    use NSubstitute.SubstituteExtensions.returns
    use NSubstitute.SubstituteExtensions.received

    use Microsoft.VisualStudio.TestTools.UnitTesting

    use Ghul.Pipes
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute

    empty[T]() -> T[] => System.Array.empty`[T]()

    iv[T](index: int, value: T) -> INDEXED_VALUE[T] => INDEXED_VALUE[T](index, value)

    assert_are_equal[T](expected: Iterable[T], actual: Pipe[T]) is
        let expected_elements = LIST[T]()
        let actual_elements = LIST[T]()

        expected_elements.add_range(expected)
        actual_elements.add_range(actual)

        CollectionAssert.are_equal(expected_elements, actual_elements)
    si

    @TestClass()
    class ADAPTOR_PIPEShould is
        init() is
        si

        @Test()
        Pipe_FromArray_ReturnsInstanceOfADAPTOR_PIPE() is
            let pipe = Ghul.Pipes.pipe([1, 2, 3, 4, 5])

            is_instance_of_type(pipe, typeof ADAPTOR_PIPE[int])
        si

        @Test()
        Count_NonEmptyArray_ReturnsElementCount() is
            let pipe = ADAPTOR_PIPE[int]([1, 2, 3, 4, 5])

            are_equal(5, pipe |> count())
        si

        @Test()
        Count_EmptyArray_ReturnsZero() is
            let pipe = ADAPTOR_PIPE[int](empty`[int]())

            are_equal(0, pipe |> count())
        si

        // A source that already knows its size answers `count` from that
        // rather than being walked.
        @Test()
        Count_MutableBag_ReadsTheBagsCount() is
            let collection = Substitute.`for`[MutableBag[int]](empty`[object]())

            returns(collection.iterator, [1, 2, 3, 4].iterator, null)
            returns(collection.count, 4, null)

            are_equal(4, collection |> count())

            let actual = received(collection, 1).count
        si

        @Test()
        Count_Bag_ReadsTheBagsCount() is
            let collection = Substitute.`for`[Bag[int]](empty`[object]())

            returns(collection.iterator, [1, 2, 3, 4].iterator, null)
            returns(collection.count, 4, null)

            are_equal(4, collection |> count())

            let actual = received(collection, 1).count
        si

        @Test()
        Iterator_ReturnsSelf() is
            let pipe = ADAPTOR_PIPE[string]([ "a", "b", "c" ])

            are_same(pipe, pipe.iterator)
        si

        @Test()
        Iterator_ReturnsCorrectElements() is
            let pipe = ADAPTOR_PIPE[string]([ "a", "b", "c" ])

            assert_are_equal(
                [ "a", "b", "c" ],
                pipe
            )
        si
    si
si
