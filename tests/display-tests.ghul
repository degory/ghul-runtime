namespace Tests is
    use Ghul

    use Collections

    use Microsoft.VisualStudio.TestTools.UnitTesting
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute

    class POINT(x: int, y: int) is
        to_string() -> string => "({x},{y})"
    si

    // Reflection finds a GetEnumerator, but what it hands back cannot be
    // driven - the shape an explicit interface implementation of
    // IEnumerator presents, where MoveNext and Current are not public.
    class UNREADABLE is
        init() is si

        GetEnumerator() -> object => object()

        to_string() -> string => "unreadable"
    si

    // Says how it looks displayed, and separately how it reads as text,
    // so which of the two `$` reaches is visible in the result.
    class TAG(label: string): Ghul.Displayable is
        to_string() -> string => "TAG"

        display(state: Ghul.DISPLAY_STATE) is
            state.append("<{label}>")
        si
    si

    // Renders its children through the state rather than by calling `$`
    // on them, which is what carries the cycle tracking down.
    class NODE(children: Collections.LIST[object]): Ghul.Displayable is
        display(state: Ghul.DISPLAY_STATE) is
            state.append('(')

            let count mut = 0

            for child in children do
                if count > 0 then
                    state.append(" ")
                fi

                state.render(child)

                count = count + 1
            od

            state.append(')')
        si
    si

    // Iterable, so the sequence overload is the one that catches it, and
    // deliberately not enumerable: reaching the enumeration at all is the
    // failure this pins.
    class SPELLED_OUT: Collections.Iterable[int], Ghul.Displayable is
        init() is si

        iterator: Collections.Iterator[int] =>
            throw System.Exception("should have been displayed, not enumerated")

        display(state: Ghul.DISPLAY_STATE) is
            state.append("spelled out")
        si
    si

    // A struct, a class and a union with no to_string of their own, which
    // render as their members.
    struct RENDERED_PAIR(a: int public, b: string public)

    class RENDERED_POINT(x: int, y: int)

    union RenderedTree is
        LEAF(value: int)
        NODE(left: RenderedTree, right: RenderedTree)
    si

    enum RenderedSuit is
        HEARTS,
        SPADES
    si

    // Renders its label through the state, as a child value.
    class TAG_OF(label: string): Ghul.Displayable is
        display(state: Ghul.DISPLAY_STATE) is
            state.append('<')
            state.render(label)
            state.append('>')
        si
    si

    // Asks the state which mode it is rendering in.
    class MODE_AWARE: Ghul.Displayable is
        init() is si

        display(state: Ghul.DISPLAY_STATE) is
            state.append(if state.mode == Ghul.DisplayMode.DETAILED then "detailed" else "clean" fi)
        si
    si

    // A sequence that says what it is in its own words.
    class NAMED_BAG: Collections.Iterable[int] is
        init() is si

        iterator: Collections.Iterator[int] => Collections.LIST[int]([1, 2]).iterator

        to_string() -> string => "a bag of two"
    si

    @TestClass()
    class DisplayShould is
            init() is
        si

        @Test()
        Render_a_string_as_itself_rather_than_its_characters() is
            are_equal("hello", $("hello"))
        si

        @Test()
        Render_an_array() is
            are_equal("[1, 2, 3]", $([1, 2, 3]))
        si

        // The element type is a value type, so this is not an
        // Iterable[object] and only the sequence overload reaches it.
        @Test()
        Render_a_list_of_a_value_type() is
            are_equal("[1, 2]", $(LIST[int]([1, 2])))
        si

        @Test()
        Render_a_nested_sequence() is
            are_equal("[[1, 2], [3]]", $([[1, 2], [3]]))
        si

        @Test()
        Render_a_pipe() is
            are_equal("[1, 2, 3]", $(Ghul.Pipes.pipe([1, 2, 3])))
        si

        @Test()
        Render_a_scalar_as_its_own_to_string() is
            are_equal("42", $(42))
        si

        @Test()
        Render_a_type_that_declares_to_string_using_it() is
            are_equal("(1,2)", $(POINT(1, 2)))
        si

        @Test()
        Render_a_sequence_of_such_a_type_elementwise() is
            are_equal("[(1,2)]", $(LIST[POINT]([POINT(1, 2)])))
        si

        @Test()
        Render_a_present_optional_string_as_itself() is
            let present: string? = "hello"

            are_equal("hello", $(present))
        si

        @Test()
        Render_an_absent_sequence_as_null() is
            let absent: Collections.LIST[int]? = null

            are_equal("null", $(absent))
        si

        @Test()
        Render_an_absent_value_as_null() is
            let absent: string? = null

            are_equal("null", $(absent))
        si

        // Held at object, an element's static type says nothing, so the
        // nested array here can only be recognised by the reflection
        // fallback.
        @Test()
        Render_a_heterogeneous_object_array() is
            let mixed: object[] = ["a", [1, 2], 42]

            are_equal("[a, [1, 2], 42]", $(mixed))
        si

        @Test()
        Render_a_map_as_its_entries() is
            let map = MAP[string, int]()

            map.add("a", 1)

            are_equal("[(a, 1)]", $(map))
        si

        // Beyond the limit an ellipsis stands for the rest, so an
        // unbounded sequence renders rather than never finishing.
        @Test()
        Render_at_most_the_element_limit() is
            let rendered = $(Ghul.Pipes.from(0))

            is_true(rendered.ends_with(", ...]"))
            is_true(rendered.starts_with("[0, 1, 2, "))
        si

        @Test()
        Render_an_unbounded_generator_without_hanging() is
            let rendered = $(Ghul.Pipes.stream(0, i => i || i + 1))

            is_true(rendered.ends_with(", ...]"))
        si

        // Being unable to read a value is not the same as the value being
        // empty, so it renders as itself rather than as `[]`.
        @Test()
        Render_a_value_whose_enumerator_cannot_be_driven_as_itself() is
            are_equal("unreadable", $(UNREADABLE()))
        si

        @Test()
        Render_a_self_referencing_collection_without_overflowing() is
            let outer = Collections.LIST[object]()

            outer.add(outer)

            are_equal("[<cycle>]", $(outer))
        si

        @Test()
        Render_a_cycle_several_hops_long() is
            let a = Collections.LIST[object]()
            let b = Collections.LIST[object]()

            a.add(b)
            b.add(a)

            are_equal("[[<cycle>]]", $(a))
        si

        // The same collection in two branches is not a cycle, so it
        // renders in full both times rather than the second being
        // reported as one.
        @Test()
        Render_a_repeated_collection_in_full_each_time() is
            let shared = Collections.LIST[int]([1, 2])
            let outer = Collections.LIST[object]()

            outer.add(shared)
            outer.add(shared)

            are_equal("[[1, 2], [1, 2]]", $(outer))
        si

        @Test()
        Render_an_empty_sequence() is
            are_equal("[]", $(LIST[int]()))
        si

        @Test()
        Render_a_type_that_says_how_it_is_displayed_using_that() is
            are_equal("<a>", $(TAG("a")))
        si

        @Test()
        Render_such_a_type_held_at_object_the_same_way() is
            let held: object = TAG("a")

            are_equal("<a>", $(held))
        si

        @Test()
        Render_such_a_type_as_an_element() is
            are_equal("[<a>, <b>]", $([TAG("a"), TAG("b")]))
        si

        // The sequence overload catches it on its static type, and the
        // type's own account of how it looks still wins.
        @Test()
        Render_a_displayable_sequence_as_it_says_rather_than_elementwise() is
            are_equal("spelled out", $(SPELLED_OUT()))
        si

        @Test()
        Render_children_of_a_displayable_type() is
            let children = Collections.LIST[object]([1, "two", [3, 4]])

            are_equal("(1 two [3, 4])", $(NODE(children)))
        si

        // The child is rendered through the state, so the cycle is seen
        // even though it closes inside a type's own display.
        @Test()
        Render_a_cycle_through_a_displayable_type() is
            let children = Collections.LIST[object]()
            let node = NODE(children)

            children.add(node)

            are_equal("(<cycle>)", $(node))
        si
    si

    counting(n: int) -> Ghul.Pipes.Pipe[int] is
        for i in 0..n do
            yield i
        od
    si

    @TestClass()
    class DisplayModesShould is
        init() is si

        @Test()
        Render_booleans_as_ghul_spells_them() is
            are_equal("true", $(true))
            are_equal("[true, false]", $([true, false]))
        si

        @Test()
        Render_a_tuple_as_its_parts() is
            are_equal("(1, one, c, true)", $((1, "one", 'c', true)))
            are_equal("(1, \"one\", 'c', true)", inspect((1, "one", 'c', true)))
        si

        @Test()
        Render_strings_and_characters_bare_at_the_top_in_both_modes() is
            are_equal("hello", inspect("hello"))
            are_equal("c", inspect(cast object('c')))
        si

        @Test()
        Quote_strings_inside_a_value_only_when_detailed() is
            are_equal("[a, b]", $(["a", "b"]))
            are_equal("[\"a\", \"b\"]", inspect(["a", "b"]))
            are_equal("[\"say \\\"hi\\\"\"]", inspect(["say \"hi\""]))
        si

        @Test()
        Render_a_map_as_key_value_pairs() is
            let map = MAP[string, int]()

            map.add("a", 1)

            are_equal("[(a, 1)]", $(map))
            are_equal("[(\"a\", 1)]", inspect(map))
        si

        @Test()
        Render_a_struct_with_no_to_string_as_its_members() is
            are_equal("RENDERED_PAIR(a = 1, b = x)", $(RENDERED_PAIR(1, "x")))
            are_equal("RENDERED_PAIR(a = 1, b = \"x\")", inspect(RENDERED_PAIR(1, "x")))
        si

        @Test()
        Render_a_class_with_no_to_string_as_its_members() is
            are_equal("RENDERED_POINT(x = 3, y = 4)", $(RENDERED_POINT(3, 4)))
        si

        @Test()
        Render_a_union_variant_after_its_union() is
            let tree: RenderedTree = RenderedTree.NODE(RenderedTree.LEAF(1), RenderedTree.LEAF(2))

            are_equal("RenderedTree.NODE(left = RenderedTree.LEAF(value = 1), right = RenderedTree.LEAF(value = 2))", $(tree))
        si

        @Test()
        Render_an_enum_member_by_its_name() is
            are_equal("HEARTS", $(RenderedSuit.HEARTS))
            are_equal("HEARTS", inspect(RenderedSuit.HEARTS))
        si

        @Test()
        Render_null_as_null_in_both_modes() is
            let absent: object? = null

            are_equal("null", $(absent))
            are_equal("null", inspect(absent))
        si

        @Test()
        Render_nested_lists_in_both_modes() is
            are_equal("[[1, 2], [3]]", inspect([[1, 2], [3]]))
            are_equal("[[a], [b]]", $([["a"], ["b"]]))
        si

        @Test()
        Tell_a_displayable_which_mode_it_is_rendered_in() is
            are_equal("clean", $(MODE_AWARE()))
            are_equal("detailed", inspect(MODE_AWARE()))
        si

        @Test()
        Quote_a_string_a_displayable_renders_only_when_detailed() is
            are_equal("<a>", $(TAG_OF("a")))
            are_equal("<\"a\">", inspect(TAG_OF("a")))
        si

        @Test()
        Render_a_cycle_in_the_detailed_mode() is
            let outer = Collections.LIST[object]()

            outer.add(outer)

            are_equal("[<cycle>]", inspect(outer))
        si

        @Test()
        Render_a_sequence_by_the_to_string_it_declares() is
            are_equal("a bag of two", $(NAMED_BAG()))
            are_equal("[a bag of two]", $([NAMED_BAG()]))
        si

        @Test()
        Give_a_pipe_a_to_string_that_matches_its_rendering() is
            let doubled = Ghul.Pipes.pipe([1, 2, 3]) |> Ghul.Pipes.map(x => x * 2)

            are_equal("[2, 4, 6]", doubled.to_string())
            are_equal("[2, 4, 6]", $(doubled))
            are_equal("doubled: [2, 4, 6]", "doubled: {doubled}")
        si

        @Test()
        Give_an_unbounded_pipe_a_to_string_that_finishes() is
            is_true(Ghul.Pipes.from(0).to_string().ends_with(", ...]"))
        si

        // Stopping at the limit leaves the pipe where a full read would
        // have: back at its start.
        @Test()
        Rewind_a_pipe_rendered_only_part_way() is
            let counting = Ghul.Pipes.pipe(Collections.LIST[int](0..5))
            let state = Ghul.DISPLAY_STATE(Ghul.DisplayMode.CLEAN, 2)

            state.render_sequence(counting)

            are_equal("[0, 1, ...]", state.to_string())
            are_equal("[0, 1, 2, 3, 4]", $(counting))
        si

        @Test()
        Render_a_generator_as_its_elements() is
            are_equal("[0, 1, 2]", $(counting(3)))
        si

        @Test()
        Render_the_elements_of_a_sequence_that_declares_its_own_to_string() is
            are_equal("[1, 2]", Ghul.Pipes.render_elements(NAMED_BAG()))
        si

        // Its members would include the result, and reading that waits
        // for the task; a type ghūl did not compile says what it is itself.
        @Test()
        Render_a_type_from_another_language_by_its_own_to_string() is
            let task = Tasks.TASK.from_result(42)

            are_equal(task.to_string(), $(task))
            are_equal("System.Random", $(System.Random(1)))
        si

        @Test()
        Render_a_function_value_by_its_type() is
            let double: object = (n: int) => n * 2

            are_equal(double.to_string(), $(double))
        si

        @Test()
        Render_a_range_by_its_own_to_string() is
            are_equal("0..3", $(0..3))
            are_equal("[0..3]", $([0..3]))
        si

        @Test()
        Stop_at_the_element_limit_a_state_is_given() is
            let state = Ghul.DISPLAY_STATE(Ghul.DisplayMode.CLEAN, 3)

            state.render([1, 2, 3, 4, 5])

            are_equal("[1, 2, 3, ...]", state.to_string())
        si
    si
si
