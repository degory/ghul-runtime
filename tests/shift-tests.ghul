namespace Tests is

    use Microsoft.VisualStudio.TestTools.UnitTesting;

    // The shift intrinsics, which reach an opcode directly rather than a
    // method body, so nothing else asserts what they lower to.
    //
    // A right shift on an unsigned type has to reach the unsigned opcode:
    // the signed one propagates the sign bit, which returns a wrong value
    // rather than failing, so it is invisible without a test like this.
    class ShiftShould is
        @test()
            init() is
        si

        RightShift_Unsigned_DoesNotPropagateTheSignBit() is
            @test()

            Assert.are_equal(0x0Fub, 0xFFub >> 4);
            Assert.are_equal(0x0FFFus, 0xFFFFus >> 4);
            Assert.are_equal(0x0FFFFFFFu, 0xFFFFFFFFu >> 4);
            Assert.are_equal(0x0FFFFFFFFFFFFFFFul, 0xFFFFFFFFFFFFFFFFul >> 4);
        si

        // `word` and `uword` are pointer-sized, so a literal of every bit
        // set cannot be written portably. Complementing zero gives one at
        // whatever width the target uses, and shifting it right unsigned
        // has to clear the top bit - which is precisely what the signed
        // opcode fails to do, leaving the value unchanged.
        RightShift_PointerSizedUnsigned_DoesNotPropagateTheSignBit() is
            @test()

            let all_ones = \0uw;

            Assert.are_not_equal(all_ones, all_ones >> 1);
            Assert.is_true((all_ones >> 1) < all_ones);
        si

        UnsignedRightShift_PointerSizedSigned_DoesNotPropagateTheSignBit() is
            @test()

            let all_ones = \0w;

            Assert.are_equal(-1w, all_ones);
            Assert.is_true((all_ones >>> 1) > 0w);
        si

        RightShift_Signed_PropagatesTheSignBit() is
            @test()

            Assert.are_equal(-4b, -16b >> 2);
            Assert.are_equal(-4s, -16s >> 2);
            Assert.are_equal(-4, -16 >> 2);
            Assert.are_equal(-4l, -16l >> 2);
        si

        UnsignedRightShift_Signed_DoesNotPropagateTheSignBit() is
            @test()

            Assert.are_equal(1073741820, -16 >>> 2);
            Assert.are_equal(4611686018427387900l, -16l >>> 2);
            Assert.is_true((-16s >>> 2) > 0s);
            Assert.is_true((-16b >>> 2) > 0b);
        si

        UnsignedRightShift_Unsigned_MatchesRightShift() is
            @test()

            Assert.are_equal(0xFFFFFFFFu >> 4, 0xFFFFFFFFu >>> 4);
        si

        LeftShift_TakesAnIntCount() is
            @test()

            Assert.are_equal(64u, 4u << 4);
            Assert.are_equal(64l, 4l << 4);
            Assert.are_equal(64, 4 << 4);
        si
    si
si
